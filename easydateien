# Monochrome Typografie (Standard-Terminalschrift ohne bunte ANSI-Farben)
BOLD = "\033[1m"
ITALIC = "\033[3m"
RESET = "\033[0m"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"
CLEAR_LINE = "\033[2K"

ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")


def visible_len(text: str) -> int:
    """Berechnet die reale sichtbare Zeichenbreite ohne ANSI-Steuersequenzen."""
    return len(ANSI_ESCAPE_RE.sub("", text))


def truncate_end(text: str, max_w: int) -> str:
    """Kürzt einen Text deterministisch am Ende mit '...' ab, falls er max_w überschreitet."""
    if max_w <= 0:
        return ""
    if len(text) <= max_w:
        return text
    if max_w <= 3:
        return text[:max_w]
    return text[: max_w - 3] + "..."


def get_divider(char: str = "─", width: Optional[int] = None) -> str:
    """Gibt eine horizontale Trennlinie dynamisch angepasst an die Terminalbreite zurück."""
    if width is None:
        try:
            width = shutil.get_terminal_size((80, 24)).columns
        except Exception:
            width = 80
    return char * max(1, width)


def format_size(size_bytes: int) -> str:
    """Formatiert Byte-Zahlen übersichtlich in B, KB, MB, GB."""
    if size_bytes < 0:
        return "---"
    size = float(size_bytes)
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if size < 1024.0 or unit == "TB":
            if unit == "B":
                return f"{int(size)} B"
            return f"{size:.1f} {unit}"
        size /= 1024.0
    return f"{size:.1f} PB"


def format_mtime(mtime: float) -> str:
    """Formatiert einen Unix-Zeitstempel typografisch sauber."""
    try:
        dt = datetime.datetime.fromtimestamp(mtime)
        now = datetime.datetime.now()
        if dt.year == now.year:
            return dt.strftime("%d. %b %H:%M")
        return dt.strftime("%d.%m.%Y")
    except Exception:
        return "---"


def pad_visible(text: str, width: int, align: str = "left") -> str:
    """Füllt einen String unter Berücksichtigung von ANSI-Steuerzeichen passgenau auf."""
    vlen = visible_len(text)
    if vlen > width:
        plain = ANSI_ESCAPE_RE.sub("", text)
        return truncate_end(plain, width)
    pad = " " * (width - vlen)
    if align == "right":
        return pad + text
    return text + pad


