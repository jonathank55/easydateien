                    c_pos = self.dialog_cursor
                    disp_inp = inp_txt[:c_pos] + f"{C_INVERT}{inp_txt[c_pos] if c_pos < len(inp_txt) else ' '}{C_RESET}" + inp_txt[c_pos+1:]
                    st_line = pad_to_width(f" {prompt_lbl}{disp_inp}  {C_GRAY}[Enter] Filter aktiv  [ESC] Zurücksetzen{C_RESET}", term_cols)
                elif self.active_dialog == "goto_path":
                    prompt_lbl = f"{C_BOLD_BLUE}[GEHE ZU PFAD]{C_RESET} Pfad: "
                    inp_txt = self.dialog_input
                    c_pos = self.dialog_cursor
                    disp_inp = inp_txt[:c_pos] + f"{C_INVERT}{inp_txt[c_pos] if c_pos < len(inp_txt) else ' '}{C_RESET}" + inp_txt[c_pos+1:]
                    st_line = pad_to_width(f" {prompt_lbl}{disp_inp}  {C_GRAY}[Enter] Wechseln  [ESC] Abbruch{C_RESET}", term_cols)
                elif self.active_dialog == "trash_confirm":
                    targets_c = len(self.selected_paths) if self.selected_paths else 1
                    t_name = f"{targets_c} Elemente" if targets_c > 1 else f"„{cur_item.name if cur_item else ''}“"
                    prompt_lbl = f"{C_BOLD_RED}[PAPIERKORB]{C_RESET} {t_name} wirklich löschen? "
