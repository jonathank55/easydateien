def is_text_file(item: "FileEntry") -> bool:
    """Ermittelt, ob es sich um eine Code-, Markdown- oder Textdatei handelt."""
    if item.is_dir:
        return False
    if item.ext.lower() in TEXT_EXTENSIONS:
        return True
    if item.name.lower() in KNOWN_TEXT_FILENAMES:
        return True
    return False


def sync_to_macos_clipboard(paths: List[str]):
    """Kopiert Dateipfade als echte macOS-Dateiobjekte (NSFilenamesPboardType / public.file-url) und Pfad-Text in die System-Zwischenablage."""
    if not paths:
        return
    import json
    abs_paths = [os.path.abspath(p) for p in paths]
    paths_json = json.dumps(abs_paths)
    text_content = "\n".join(abs_paths)
    text_json = json.dumps(text_content)
    js_code = f"""
    ObjC.import("AppKit");
    var pb = $.NSPasteboard.generalPasteboard;
    pb.clearContents;
    var paths = {paths_json};
    var fileUrls = $.NSMutableArray.array;
    for (var i = 0; i < paths.length; i++) {{
        fileUrls.addObject($.NSURL.fileURLWithPath(paths[i]));
    }}
    fileUrls.addObject($.NSString.stringWithString({text_json}));
    pb.writeObjects(fileUrls);
    """
    try:
        subprocess.run(["osascript", "-l", "JavaScript", "-e", js_code], check=False, capture_output=True, timeout=2.0)
    except Exception:
        pass


def copy_text_to_clipboard(text: str):
    """Kopiert einen reinen Text in die macOS-Systemzwischenablage (pbcopy)."""
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(text.encode("utf-8"), timeout=1.0)
    except Exception:
        pass


def get_macos_clipboard_files() -> List[str]:
    """Liest Dateipfade aus der macOS-Systemzwischenablage aus."""
    js_code = """
    ObjC.import("AppKit");
    var pb = $.NSPasteboard.generalPasteboard;
    var classes = $.NSArray.arrayWithObject($.NSURL.class);
    var options = $.NSDictionary.dictionaryWithObjectForKey(
        $.NSNumber.numberWithBool(true),
        $.NSPasteboardURLReadingFileURLsOnlyKey
    );
    var urls = pb.readObjectsForClassesOptions(classes, options);
    var res = [];
    if (urls && urls.count > 0) {
        for (var i = 0; i < urls.count; i++) {
            res.push(ObjC.unwrap(urls.objectAtIndex(i).path));
        }
    }
    JSON.stringify(res);
    """
    try:
        proc = subprocess.run(["osascript", "-l", "JavaScript", "-e", js_code], capture_output=True, text=True, timeout=1.5)
        if proc.returncode == 0 and proc.stdout.strip():
            import json
            paths = json.loads(proc.stdout.strip())
            return [p for p in paths if os.path.exists(p)]
    except Exception:
        pass
    return []


class FileEntry:
    """Repräsentiert einen Datei- oder Ordner-Eintrag im aktuellen Verzeichnis."""

    __slots__ = ("name", "path", "is_dir", "is_symlink", "size", "mtime", "ext", "mode_str")

    def __init__(self, path: str, name: str):
        self.path = path
        self.name = name
        self.is_dir = False
        self.is_symlink = os.path.islink(path)
        self.size = 0
        self.mtime = 0.0
        self.mode_str = "----------"
        _, self.ext = os.path.splitext(name)

        try:
            st = os.stat(path, follow_symlinks=False)
            self.mtime = st.st_mtime
            try:
                self.mode_str = stat.filemode(st.st_mode)
            except Exception:
                self.mode_str = "----------"
            if os.path.islink(path):
                # Prüfen, ob Link auf Ordner zeigt
                try:
                    self.is_dir = os.path.isdir(path)
                except Exception:
                    self.is_dir = False
                self.size = st.st_size
            else:
                self.is_dir = os.path.isdir(path)
                self.size = 0 if self.is_dir else st.st_size
        except Exception:
            pass


def scan_directory(
    path: str,
    show_hidden: bool = False,
    sort_by: str = "mtime",
    sort_reverse: bool = True,
    sort_dir_first: bool = True,
) -> List[FileEntry]:
    """Liest den Inhalt eines Verzeichnisses ein und sortiert ihn nach den konfigurierten Vorgaben."""
    entries: List[FileEntry] = []
    try:
        with os.scandir(path) as it:
            for entry in it:
                if not show_hidden and entry.name.startswith("."):
                    continue
                entries.append(FileEntry(entry.path, entry.name))
    except Exception:
        return []

    # Sortierfunktionen
    def get_sort_key(item: FileEntry):
        if sort_by == "name":
            key = item.name.lower()
        elif sort_by == "size":
            key = item.size
        elif sort_by == "ext":
            key = (item.ext.lower(), item.name.lower())
        else:  # Standard: mtime
            key = item.mtime
        return key

    # Dirs first berücksichtigen
    if sort_dir_first:
        dirs = [e for e in entries if e.is_dir]
        files = [e for e in entries if not e.is_dir]
        dirs.sort(key=get_sort_key, reverse=sort_reverse)
        files.sort(key=get_sort_key, reverse=sort_reverse)
        return dirs + files
    else:
        entries.sort(key=get_sort_key, reverse=sort_reverse)
        return entries


def read_key(fd: int, timeout: float = 0.05) -> str:
    """Liest einen einzelnen Tastendruck oder ein Maus-Event ungepuffert direkt aus dem Filedeskriptor."""
    try:
        r, _, _ = select.select([fd], [], [], timeout)
        if not r:
            return ""
        raw = os.read(fd, 1)
    except Exception:
        return ""
    if not raw:
        return ""

    if raw == b"\x1b":
        seq = b""
        while True:
            r, _, _ = select.select([fd], [], [], 0.03)
            if not r:
                break
            try:
                c = os.read(fd, 1)
                seq += c
            except Exception:
                break

            # SGR-Maus-Sequenz: \x1b[<B;X;Y(M|m)
            if seq.startswith(b"[<"):
                if seq.endswith(b"M") or seq.endswith(b"m") or len(seq) >= 30:
                    break
            elif len(seq) >= 2 and seq[-1:] in b"ABCDHFS~":
                break
            elif len(seq) >= 6:
                break

        if not seq:
            return "ESC"

        # SGR-Maus-Event verarbeiten
        if seq.startswith(b"[<") and (seq.endswith(b"M") or seq.endswith(b"m")):
            try:
                state = chr(seq[-1])
                parts = seq[2:-1].decode("ascii").split(";")
                if len(parts) == 3:
                    btn = int(parts[0])
                    x = int(parts[1])
                    y = int(parts[2])
                    if btn == 64:
                        return "MOUSE_WHEEL_UP"
                    elif btn == 65:
                        return "MOUSE_WHEEL_DOWN"
                    elif btn == 0 and state == "M":
                        return f"MOUSE_CLICK:{x}:{y}"
                    elif btn == 2 and state == "M":
                        return f"MOUSE_RIGHT_CLICK:{x}:{y}"
                    else:
                        return f"MOUSE_EVENT:{btn}:{x}:{y}:{state}"
            except Exception:
                return "ESC"
            return ""

        if seq in (b"[A", b"OA"):
            return "UP"
        elif seq in (b"[B", b"OB"):
            return "DOWN"
        elif seq in (b"[C", b"OC"):
            return "RIGHT"
        elif seq in (b"[D", b"OD"):
            return "LEFT"
        elif seq in (b"[Z",):
            return "UP"
        elif seq in (b"[H", b"1~", b"7~"):
            return "HOME"
        elif seq in (b"[F", b"4~", b"8~"):
            return "END"
        elif seq in (b"[3~",):
            return "DELETE"
        elif seq in (b"[5~",):
            return "PAGE_UP"
        elif seq in (b"[6~",):
            return "PAGE_DOWN"
        return "ESC"

    elif raw in (b"\r", b"\n"):
        return "ENTER"
    elif raw == b" ":
        return "SPACE"
    elif raw == b"\t":
        return "TAB"
    elif raw in (b"\x7f", b"\x08"):
        return "BACKSPACE"
    elif raw in (b"\x03", b"\x04"):
        return "QUIT"

    if raw[0] >= 0xC0:
        needed = 2 if raw[0] < 0xE0 else (3 if raw[0] < 0xF0 else 4)
        ch_bytes = raw
        while len(ch_bytes) < needed:
            r, _, _ = select.select([fd], [], [], 0.03)
            if not r:
                break
            ch_bytes += os.read(fd, 1)
        try:
            return ch_bytes.decode("utf-8")
        except Exception:
            return ""

    try:
        return raw.decode("utf-8")
    except Exception:
        return ""


def move_to_trash(paths: List[str]) -> tuple[int, List[str]]:
    """Verschiebt eine Liste von Pfaden in den macOS-Papierkorb."""
    success_count = 0
    errors = []

    # Prüfen, ob /usr/bin/trash vorhanden ist (nativ und blitzschnell)
    has_trash_bin = shutil.which("trash") is not None

    for p in paths:
        if not os.path.exists(p) and not os.path.islink(p):
            continue
        done = False
        if has_trash_bin:
            try:
                res = subprocess.run(["trash", p], capture_output=True, text=True, timeout=5)
                if res.returncode == 0:
                    done = True
                    success_count += 1
            except Exception:
                done = False

        if not done:
            # Fallback 1: osascript Finder
            try:
                cmd = f'tell application "Finder" to delete (POSIX file "{p}" as alias)'
                res = subprocess.run(["osascript", "-e", cmd], capture_output=True, text=True, timeout=5)
                if res.returncode == 0:
                    done = True
                    success_count += 1
            except Exception:
                done = False

        if not done:
            # Fallback 2: Verschieben nach ~/.Trash
            try:
                trash_dir = os.path.expanduser("~/.Trash")
                os.makedirs(trash_dir, exist_ok=True)
                target = os.path.join(trash_dir, os.path.basename(p))
                if os.path.exists(target):
                    base, ext = os.path.splitext(os.path.basename(p))
                    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                    target = os.path.join(trash_dir, f"{base}_{stamp}{ext}")
                shutil.move(p, target)
                done = True
                success_count += 1
            except Exception as e:
                errors.append(f"{os.path.basename(p)}: {e}")

    return success_count, errors


def generate_unique_dest(dest_dir: str, src_name: str) -> str:
    """Erzeugt einen nicht-kollidierenden Zielpfad im Zielverzeichnis."""
    target = os.path.join(dest_dir, src_name)
    if not os.path.exists(target) and not os.path.islink(target):
        return target
    base, ext = os.path.splitext(src_name)
    counter = 1
    while True:
        candidate = os.path.join(dest_dir, f"{base} (Kopie {counter}){ext}")
        if not os.path.exists(candidate) and not os.path.islink(candidate):
            return candidate
        counter += 1


class EasyDateienApp:
    """Zentrale Dateimanager-Anwendungsinstanz."""

    def __init__(self, initial_path: Optional[str] = None):
        self.config = load_config()
        if initial_path and os.path.isdir(os.path.expanduser(initial_path)):
            self.current_dir = os.path.abspath(os.path.expanduser(initial_path))
        else:
            self.current_dir = os.getcwd()

        self.items: List[FileEntry] = []
        self.selected_idx = 0
        self.selected_paths: Set[str] = set()
        self.clipboard_mode: Optional[str] = None  # "cut" oder "copy"
        self.clipboard_paths: List[str] = []
        self.status_message: str = ""
        self.pending_key_seq: str = ""
        self.dir_cursor_history: Dict[str, str] = {}  # Merkt sich das ausgewählte Element pro Pfad
        self.last_click_time: float = 0.0
        self.last_click_idx: Optional[int] = None
        self.last_right_arrow_time: float = 0.0
        self.last_right_arrow_path: str = ""
        self.status_expiry_moves: int = 0
        self.last_layout: Dict = {}

        # Integrierte Konsole / Terminal (Taste 't')
        self.show_console: bool = self.config.get("show_console", False)
        self.console_position: str = self.config.get("console_position", "unten").lower()
        if self.console_position not in ("unten", "rechts", "links"):
            self.console_position = "unten"
        self.console_focused: bool = False
        self.console_input: str = ""
        self.console_cursor_idx: int = 0
        self.console_output_lines: List[str] = []
        self.console_cmd_history: List[str] = []
        self.console_history_idx: int = 0
        self.console_scroll_offset: int = 0

        # Caching für Parent- und Child-Spalten für maximale Flüssigkeit
        self.cached_parent_dir: Optional[str] = None
        self.cached_parent_items: List[FileEntry] = []
        self.cached_parent_mtime: float = -1.0
        self.cached_child_path: Optional[str] = None
        self.cached_child_items: List[FileEntry] = []
        self.cached_child_mtime: float = -1.0

        self.refresh_items()

    def refresh_items(self):
        """Liest das aktuelle Verzeichnis neu ein und setzt den Cursor."""
        self.cached_parent_dir = None
        self.cached_child_path = None
        self.items = scan_directory(
            self.current_dir,
            show_hidden=self.config.get("show_hidden", False),
            sort_by=self.config.get("sort_by", "mtime"),
            sort_reverse=self.config.get("sort_reverse", True),
            sort_dir_first=self.config.get("sort_dir_first", True),
        )
        # Cursor anhand von History oder Index wiederherstellen
        last_selected_name = self.dir_cursor_history.get(self.current_dir)
        if last_selected_name:
            found = False
            for i, it in enumerate(self.items):
                if it.name == last_selected_name:
                    self.selected_idx = i
                    found = True
                    break
            if not found:
                self.selected_idx = min(self.selected_idx, max(0, len(self.items) - 1))
        else:
            self.selected_idx = min(self.selected_idx, max(0, len(self.items) - 1))

    def change_directory(self, new_dir: str):
        """Wechselt in ein anderes Verzeichnis."""
        if not os.path.isdir(new_dir):
            self.status_message = f"Verzeichnis nicht erreichbar: {new_dir}"
            return

        # Aktuelle Auswahl in History merken
        if self.items and 0 <= self.selected_idx < len(self.items):
            self.dir_cursor_history[self.current_dir] = self.items[self.selected_idx].name

        self.current_dir = os.path.abspath(new_dir)
        self.selected_idx = 0
        self.refresh_items()

    def go_parent_directory(self):
        """Wechselt in das übergeordnete Verzeichnis."""
        parent = os.path.dirname(self.current_dir)
        if parent == self.current_dir:
            return  # Bereits im Root-Verzeichnis
        old_dir_name = os.path.basename(self.current_dir)
        self.current_dir = parent
        self.refresh_items()
        # Cursor auf den Ordner setzen, den wir gerade verlassen haben
        for i, it in enumerate(self.items):
            if it.name == old_dir_name:
                self.selected_idx = i
                break

    def get_short_dir(self, path: str) -> str:
        """Gibt eine kompakte Pfaddarstellung zurück (z.B. ~/Downloads)."""
        home = os.path.expanduser("~")
        if path == home:
            return "~"
        if path.startswith(home + "/"):
            return "~" + path[len(home):]
        return path

    def get_console_display_lines(self, width: int, height: int) -> List[str]:
        """Formatiert genau height Zeilen für die Konsole, jede Zeile mit sichtbarer Breite width."""
        if height <= 0 or width <= 0:
            return []

        # Die letzte Zeile ist immer die Eingabeaufforderung (Prompt)
        short_dir = self.get_short_dir(self.current_dir)
        prompt_prefix = f"{short_dir} $ "
        if visible_len(prompt_prefix) > width - 4:
            prompt_prefix = "$ "
            if visible_len(prompt_prefix) > width - 2:
                prompt_prefix = "> "

        avail_input = max(1, width - visible_len(prompt_prefix))

        inp = self.console_input
        c_idx = max(0, min(self.console_cursor_idx, len(inp)))

        if len(inp) >= avail_input:
            scroll_left = max(0, c_idx - avail_input + 4)
            disp_inp = inp[scroll_left:scroll_left + avail_input - 1]
            rel_c_idx = c_idx - scroll_left
        else:
            disp_inp = inp
            rel_c_idx = c_idx

        if self.console_focused:
            if rel_c_idx >= len(disp_inp):
                prompt_content = f"{prompt_prefix}{disp_inp}\033[7m \033[0m"
            else:
                ch = disp_inp[rel_c_idx]
                prompt_content = f"{prompt_prefix}{disp_inp[:rel_c_idx]}\033[7m{ch}\033[0m{disp_inp[rel_c_idx+1:]}"
        else:
            prompt_content = f"{prompt_prefix}{disp_inp}"

        prompt_line = pad_visible(prompt_content, width)

        if height == 1:
            return [prompt_line]

        num_output_rows = height - 1
        lines_above: List[str] = []

        if not self.console_output_lines:
            lines_above.append(pad_visible(f"  {ITALIC}Terminal aktiv ({short_dir}){RESET}", width))
            while len(lines_above) < num_output_rows:
                lines_above.append(" " * width)
        else:
            total_out = len(self.console_output_lines)
            max_scroll = max(0, total_out - num_output_rows)
            curr_scroll = max(0, min(self.console_scroll_offset, max_scroll))

            end_idx = total_out - curr_scroll
            start_idx = max(0, end_idx - num_output_rows)
            slice_lines = self.console_output_lines[start_idx:end_idx]

            empty_count = num_output_rows - len(slice_lines)
            for _ in range(empty_count):
                lines_above.append(" " * width)
            for raw_l in slice_lines:
                lines_above.append(pad_visible(truncate_end(raw_l, width), width))

        return lines_above[:num_output_rows] + [prompt_line]

    def run_console_command(self, cmd_line: str, fd: int, old_settings):
        """Führt einen Konsolenbefehl im aktuellen Verzeichnis aus."""
        cmd_line = cmd_line.strip()
        if not cmd_line:
            return

        if not self.console_cmd_history or self.console_cmd_history[-1] != cmd_line:
            self.console_cmd_history.append(cmd_line)
        self.console_history_idx = len(self.console_cmd_history)

        short_dir = self.get_short_dir(self.current_dir)
        self.console_output_lines.append(f"{short_dir} $ {cmd_line}")

        self.console_input = ""
        self.console_cursor_idx = 0
        self.console_scroll_offset = 0

        if cmd_line in ("exit", "quit"):
            self.show_console = False
            self.console_focused = False
            self.status_message = "Konsole geschlossen."
            return

        if cmd_line == "clear":
            self.console_output_lines.clear()
            return

        if cmd_line == "cd" or cmd_line.startswith("cd "):
            target = cmd_line[3:].strip() if cmd_line.startswith("cd ") else "~"
            target_path = os.path.expanduser(os.path.expandvars(target))
            if not os.path.isabs(target_path):
                target_path = os.path.abspath(os.path.join(self.current_dir, target_path))
            if os.path.isdir(target_path):
                self.change_directory(target_path)
                self.console_output_lines.append(f"{self.get_short_dir(target_path)}")
            else:
                self.console_output_lines.append(f"cd: Verzeichnis nicht gefunden: {target}")
            return

        parts = cmd_line.split()
        first_token = os.path.basename(parts[0]) if parts else ""
        interactive_apps = {
            "nano", "vim", "vi", "nvim", "micro", "emacs",
            "less", "more", "man", "top", "htop", "btop",
            "zsh", "bash", "sh", "fish", "lazygit", "ranger", "yazi"
        }
        is_interactive = (first_token in interactive_apps) or (first_token in ("python", "python3", "node") and len(parts) == 1)

        if is_interactive:
            sys.stdout.write(SHOW_CURSOR + "\033[?1049l")
            if self.config.get("mouse_support", True):
                sys.stdout.write("\033[?1000l\033[?1006l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            try:
                subprocess.run(cmd_line, shell=True, cwd=self.current_dir, executable="/bin/zsh")
            except Exception as e:
                print(f"Fehler beim Ausführen: {e}")
            finally:
                tty.setcbreak(fd, termios.TCSADRAIN)
                sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                if self.config.get("mouse_support", True):
                    sys.stdout.write("\033[?1000h\033[?1006h")
                sys.stdout.flush()
                self.console_output_lines.append(f"[Befehl beendet]")
                self.refresh_items()
        else:
            try:
                res = subprocess.run(
                    cmd_line,
                    shell=True,
                    cwd=self.current_dir,
                    capture_output=True,
                    text=True,
                    timeout=15.0,
                    executable="/bin/zsh"
                )
                if res.stdout:
                    for l in res.stdout.splitlines():
                        self.console_output_lines.append(l)
                if res.stderr:
                    for l in res.stderr.splitlines():
                        self.console_output_lines.append(l)
                if res.returncode != 0 and not res.stdout and not res.stderr:
                    self.console_output_lines.append(f"[Beendet mit Code {res.returncode}]")
            except subprocess.TimeoutExpired:
                self.console_output_lines.append("[Fehler: Zeitlimit von 15s überschritten]")
            except Exception as e:
                self.console_output_lines.append(f"[Fehler: {e}]")

            self.refresh_items()

    def toggle_console(self):
        """Schaltet die Anzeige der Konsole ein oder aus."""
        self.show_console = not self.show_console
        if self.show_console:
            self.console_focused = True
            self.status_message = "Konsole geöffnet (Tab für Dateimanager, Enter für Ausführen)"
        else:
            self.console_focused = False
            self.status_message = "Konsole geschlossen."

    def open_with_system(self, item: FileEntry):
        """Öffnet eine Datei oder einen Ordner mit dem Standard-Systemöffner (z. B. open)."""
        opener = self.config.get("opener", "open %s")
        cmd = opener.replace("%s", f'"{item.path}"')
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
            self.status_message = f"Geöffnet: {item.name}"
        except Exception as e:
            self.status_message = f"Fehler beim Öffnen: {e}"

    def open_current(self):
        """Öffnet das aktuell ausgewählte Element per Systembefehl 'open' (sowohl Dateien als auch Ordner)."""
        if not self.items:
            return
        item = self.items[self.selected_idx]
        self.open_with_system(item)

    def open_in_nano(self, item: FileEntry, fd: Optional[int] = None, old_settings = None):
        """Öffnet eine Datei im Terminal-Editor nano (oder konfiguriertem Editor) bei Doppelklick auf die rechte Pfeiltaste."""
        if fd is not None and old_settings is not None:
            mouse_on = self.config.get("mouse_support", True)
            if mouse_on:
                sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.write(SHOW_CURSOR)
            sys.stdout.write("\033[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            try:
                editor_cmd = self.config.get("text_editor", "nano %s")
                if "%s" in editor_cmd:
                    cmd = editor_cmd.replace("%s", f'"{item.path}"')
                else:
                    cmd = f'{editor_cmd} "{item.path}"'
                subprocess.run(cmd, shell=True)
            except Exception as e:
                self.status_message = f"Fehler beim Starten des Editors: {e}"
            finally:
                tty.setcbreak(fd, termios.TCSADRAIN)
                sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                if mouse_on:
                    sys.stdout.write("\033[?1000h\033[?1006h")
                sys.stdout.write("\033[2J\033[H")
                sys.stdout.flush()
                self.refresh_items()

    def toggle_select(self):
        """Schaltet die Markierung des aktuellen Elements um und bewegt den Cursor nach unten."""
        if not self.items:
            return
        item = self.items[self.selected_idx]
        if item.path in self.selected_paths:
            self.selected_paths.remove(item.path)
        else:
            self.selected_paths.add(item.path)
            # Falls das Element im Zwischenspeicher war, dort entfernen
            if item.path in self.clipboard_paths:
                self.clipboard_paths.remove(item.path)
                if not self.clipboard_paths:
                    self.clipboard_mode = None

        if self.selected_idx < len(self.items) - 1:
            self.selected_idx += 1

    def toggle_select_all(self):
        """Wählt alle sichtbaren Elemente aus oder hebt die Auswahl vollständig auf."""
        all_paths = {it.path for it in self.items}
        if not all_paths:
            return
        if self.selected_paths.issuperset(all_paths):
            self.selected_paths.clear()
            self.status_message = "Auswahl aufgehoben."
        else:
            self.selected_paths.update(all_paths)
            self.clipboard_paths = [p for p in self.clipboard_paths if p not in self.selected_paths]
            if not self.clipboard_paths:
                self.clipboard_mode = None
            self.status_message = f"{len(self.selected_paths)} Elemente markiert."

    def cut_selection(self):
        """Markiert die aktuelle Auswahl (oder das aktuelle Element) zum Ausschneiden und synchronisiert mit macOS-Clipboard."""
        if not self.items:
            return
        cur_item = self.items[self.selected_idx]

        # Fall 1: Bereits im Cut-Modus ohne neue Auswahl
        if self.clipboard_mode == "cut" and not self.selected_paths and self.clipboard_paths:
            if cur_item.path in self.clipboard_paths:
                self.clipboard_mode = None
                self.clipboard_paths = []
                self.status_message = "Ausschneiden aufgehoben."
                return

        # Fall 2: Bereits im Copy-Modus ohne neue Auswahl -> Nahtlos von Copy zu Cut wechseln
        if self.clipboard_mode == "copy" and not self.selected_paths and self.clipboard_paths:
            self.clipboard_mode = "cut"
            sync_to_macos_clipboard(self.clipboard_paths)
            count = len(self.clipboard_paths)
            if count == 1:
                name = os.path.basename(self.clipboard_paths[0])
                self.status_message = f"„{name}“ zum Ausschneiden markiert (mit 'p' einfügen)."
            else:
                self.status_message = f"{count} Elemente zum Ausschneiden markiert (mit 'p' einfügen)."
            return

        targets = list(self.selected_paths) if self.selected_paths else [cur_item.path]
        self.clipboard_mode = "cut"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        sync_to_macos_clipboard(targets)
        count = len(targets)
        if count == 1:
            name = os.path.basename(targets[0])
            self.status_message = f"„{name}“ zum Ausschneiden markiert (mit 'p' einfügen)."
        else:
            self.status_message = f"{count} Elemente zum Ausschneiden markiert (mit 'p' einfügen)."

    def copy_selection(self):
        """Markiert die aktuelle Auswahl (oder das aktuelle Element) zum Kopieren und synchronisiert mit macOS-Clipboard."""
        if not self.items:
            return
        cur_item = self.items[self.selected_idx]

        # Fall 1: Bereits im Copy-Modus ohne neue Auswahl
        if self.clipboard_mode == "copy" and not self.selected_paths and self.clipboard_paths:
            if cur_item.path in self.clipboard_paths:
                self.clipboard_mode = None
                self.clipboard_paths = []
                self.status_message = "Kopieren aufgehoben."
                return

        # Fall 2: Bereits im Cut-Modus ohne neue Auswahl -> Nahtlos von Cut zu Copy wechseln
        if self.clipboard_mode == "cut" and not self.selected_paths and self.clipboard_paths:
            self.clipboard_mode = "copy"
            sync_to_macos_clipboard(self.clipboard_paths)
            count = len(self.clipboard_paths)
            if count == 1:
                name = os.path.basename(self.clipboard_paths[0])
                self.status_message = f"„{name}“ zum Kopieren markiert (auch in Finder/Apps einsetzbar)."
            else:
                self.status_message = f"{count} Elemente zum Kopieren markiert (auch in Finder/Apps einsetzbar)."
            return

        targets = list(self.selected_paths) if self.selected_paths else [cur_item.path]
        self.clipboard_mode = "copy"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        sync_to_macos_clipboard(targets)
        count = len(targets)
        if count == 1:
            name = os.path.basename(targets[0])
            self.status_message = f"„{name}“ zum Kopieren markiert (auch in Finder/Apps einsetzbar)."
        else:
            self.status_message = f"{count} Elemente zum Kopieren markiert (auch in Finder/Apps einsetzbar)."

    def paste_clipboard(self):
        """Fügt Elemente aus dem Zwischenspeicher oder der macOS-Systemzwischenablage in das aktuelle Verzeichnis ein."""
        if not self.clipboard_paths:
            sys_files = get_macos_clipboard_files()
            if sys_files:
                self.clipboard_paths = sys_files
                self.clipboard_mode = "copy"

        if not self.clipboard_mode or not self.clipboard_paths:
            self.status_message = "Zwischenspeicher ist leer."
            return

        success_count = 0
        errors = []
        last_dest_name = ""

        for src in self.clipboard_paths:
            if not os.path.exists(src) and not os.path.islink(src):
                errors.append(f"Quelle nicht mehr vorhanden: {os.path.basename(src)}")
                continue

            src_name = os.path.basename(src)
            dest = os.path.join(self.current_dir, src_name)

            # Gleiches Quell- und Zielverzeichnis
            if os.path.abspath(src) == os.path.abspath(dest):
                if self.clipboard_mode == "cut":
                    success_count += 1
                    last_dest_name = src_name
                    continue
                else:
                    dest = generate_unique_dest(self.current_dir, src_name)
            elif os.path.exists(dest) and os.path.abspath(src) != os.path.abspath(dest):
                dest = generate_unique_dest(self.current_dir, src_name)

            # Schutz vor Verschieben in eigenen Unterordner
            if self.clipboard_mode == "cut" and os.path.isdir(src):
                try:
                    if os.path.commonpath([src]) == os.path.commonpath([src, dest]) and os.path.abspath(src) != os.path.abspath(dest):
                        errors.append(f"Kann nicht in Unterordner verschoben werden: {src_name}")
                        continue
                except Exception:
                    pass

            try:
                if self.clipboard_mode == "cut":
                    shutil.move(src, dest)
                    success_count += 1
                    last_dest_name = os.path.basename(dest)
                elif self.clipboard_mode == "copy":
                    if os.path.islink(src):
                        link_target = os.readlink(src)
                        os.symlink(link_target, dest)
                    elif os.path.isdir(src):
                        shutil.copytree(src, dest)
                    else:
                        shutil.copy2(src, dest)
                    success_count += 1
                    last_dest_name = os.path.basename(dest)
            except Exception as e:
                errors.append(f"{src_name}: {e}")

        if self.clipboard_mode == "cut":
            self.clipboard_mode = None
            self.clipboard_paths = []

        self.refresh_items()

        if last_dest_name:
            for i, it in enumerate(self.items):
                if it.name == last_dest_name:
                    self.selected_idx = i
                    break

        if errors:
            self.status_message = f"{success_count} eingefügt, Fehler: {', '.join(errors[:2])}"
        else:
            self.status_message = f"{success_count} Element(e) erfolgreich eingefügt."

    def prompt_trash(self, fd: int) -> bool:
        """Bestätigungsdialog zum Verschieben in den Papierkorb (y/N)."""
        if not self.items:
            return False

        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        if not targets:
            return False

        if len(targets) == 1:
            name = os.path.basename(targets[0])
            prompt_txt = f"„{name}“ in den Papierkorb verschieben? (y/N): "
        else:
            prompt_txt = f"{len(targets)} Elemente in den Papierkorb verschieben? (y/N): "

        term_cols = shutil.get_terminal_size((80, 24)).columns
        margin = "  " if term_cols >= 80 else (" " if term_cols >= 45 else "")
        prompt_visible = truncate_end(prompt_txt, max(5, term_cols - len(margin) - 2))

        # Prompt in der Statuszeile anzeigen
        sys.stdout.write(f"\r{CLEAR_LINE}{margin}{BOLD}{prompt_visible}{RESET}")
        sys.stdout.flush()

        ans = read_key(fd, timeout=10.0)
        if ans.lower() in ("y", "j"):
            count, errs = move_to_trash(targets)
            self.selected_paths.clear()
            self.clipboard_paths = [p for p in self.clipboard_paths if p not in targets]
            if not self.clipboard_paths:
                self.clipboard_mode = None
            self.refresh_items()
            if errs:
                self.status_message = f"{count} gelöscht, Fehler: {', '.join(errs[:1])}"
            else:
                self.status_message = f"{count} Element(e) in den Papierkorb verschoben."
            return True
        else:
            self.status_message = "Verschieben in den Papierkorb abgebrochen."
            return False

    def create_zip_archive(self):
        """Erstellt ein ZIP-Archiv aus den markierten Elementen oder dem aktuellen Element."""
        if not self.items:
            return
        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        if not targets:
            return

        if len(targets) == 1:
            base_name = os.path.splitext(os.path.basename(targets[0]))[0]
            zip_filename = f"{base_name}.zip"
        else:
            stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            zip_filename = f"Archiv_{stamp}.zip"

        zip_path = os.path.join(self.current_dir, zip_filename)
        if os.path.exists(zip_path):
            zip_path = generate_unique_dest(self.current_dir, zip_filename)

        try:
            with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
                for target in targets:
                    if os.path.isdir(target):
                        for root, _, files in os.walk(target):
                            for f in files:
                                full_f = os.path.join(root, f)
                                arcname = os.path.relpath(full_f, os.path.dirname(target))
                                zf.write(full_f, arcname)
                    else:
                        zf.write(target, os.path.basename(target))
            self.selected_paths.clear()
            self.refresh_items()
            self.status_message = f"Archiv „{os.path.basename(zip_path)}“ erstellt."
        except Exception as e:
            self.status_message = f"Fehler bei ZIP-Erstellung: {e}"

    def interactive_goto(self):
        """Interaktive Eingabe eines Pfades mit automatischer Tab-Vervollständigung."""
        mouse_on = self.config.get("mouse_support", True)
        if mouse_on:
            sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.flush()
        sys.stdout.write(SHOW_CURSOR)
        sys.stdout.flush()
        target = edit_line_interactive("Gehe zu Pfad: ", initial=self.current_dir)
        sys.stdout.write(HIDE_CURSOR)
        if mouse_on:
            sys.stdout.write("\033[?1000h\033[?1006h")
        sys.stdout.flush()

        if target and target.strip():
            exp = os.path.expanduser(target.strip())
            if os.path.isdir(exp):
                self.change_directory(exp)
            else:
                self.status_message = f"Kein gültiges {target}"

    def toggle_hidden_files(self):
        """Schaltet die Anzeige versteckter Dateien um."""
        new_val = not self.config.get("show_hidden", False)
        self.config["show_hidden"] = new_val
        save_config(self.config)
        self.refresh_items()
