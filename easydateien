class EasyDateienApp(EasyDateienActions, EasyDateienView):
    """Kern: Zustand (__init__) und Hauptschleife (run)."""

    STATUS_TIMEOUT = 6.0  # Sekunden, nach denen Statusmeldungen automatisch verschwinden

    def __init__(self, initial_path: Optional[str] = None, cwd_file: Optional[str] = None):
        self.cwd_file = cwd_file or os.environ.get("EASYDATEIEN_CWD_FILE")
        self.current_dir = os.path.abspath(initial_path if initial_path else os.getcwd())
        self._sync_cwd()
        self.config = self.load_config()
        self.keymap: Dict[str, str] = build_keymap(self.config)
        self.keybindings = get_keybindings_from_config(self.config)
        self.last_visited_dir: Optional[str] = None
        self.preview_scroll_offset: int = 0
        self.preview_scroll_item: Optional[str] = None
        self.marked_dir: Optional[str] = None
        self.items: List[FileEntry] = []
        self.selected_idx: int = 0
        self.view_start: int = 0
        # Merkt sich pro Verzeichnis die letzte Zeigerposition (nur Pfeiltasten-Navigation links/rechts)
        self.dir_cursor_memory: Dict[str, int] = {}
        self.selected_paths: Set[str] = set()
        self.clipboard_paths: List[str] = []
        self.clipboard_mode: Optional[str] = None
        self.status_message: str = ""
        self.status_level: str = "info"
        self.status_expiry_moves: int = 0
        self.status_time: float = 0.0
        self.filter_query: str = ""
        self.quit_requested: bool = False

        # ZIP-Erstellung im Hintergrund: Thread-Handle + Fortschritt/Ergebnis
        self._zip_thread = None
        self._zip_progress = None
        self._zip_result = None
        self._zip_last_reported_done: int = -1
        # Einfuegen im Hintergrund: Thread-Handle + Fortschritt/Ergebnis/Kontext
        self._paste_thread = None
        self._paste_progress = None
        self._paste_result = None
        self._paste_ctx = None
        self._paste_last_reported_done: int = -1

        self.undo_stack: List[UndoAction] = []

        self.active_dialog: Optional[str] = None
        self.dialog_input: str = ""
        self.dialog_cursor: int = 0
        self.dialog_target_item: Optional[FileEntry] = None
        self.pending_replace: Optional[dict] = None
        self.help_scroll_offset: int = 0

        self.last_click_time: float = 0.0
        self.last_click_idx: Optional[int] = None
        self.last_layout: Dict = {}

        self.console_always_visible: bool = self.config.get("console_always_visible", False)
        self.preview_wrap: bool = self.config.get("preview_wrap", True)
        # Wenn Konsole immer eingeblendet sein soll, dann standardmäßig zeigen
        self.show_console: bool = self.config.get("show_console", False) or self.console_always_visible
        self.console_focused: bool = False
        self.console_input: str = ""
        self.console_cursor_idx: int = 0
        self.console_output_lines: List[str] = []
        self.console_cmd_history: List[str] = []
        self.console_history_idx: int = 0
        self.console_history_draft: str = ""
        self.console_scroll_offset: int = 0
        self.last_cmd_interactive: bool = False
        self._mouse_tracking_active: bool = False
        # Terminal-Sicherung: exakter termios-Zustand vor TUI-Start (None = TUI
        # war nie aktiv). main() stellt daraus den Ausgangszustand wieder her.
        self._saved_termios = None
        self._tui_active: bool = False

        # Verzeichnis-Cache: Pfad -> (mtime_ns des Ordners, Version, Einträge)
        self._raw_cache: Dict[str, Tuple[int, int, List[FileEntry]]] = {}
        self._raw_version: int = 0
        self._arranged_cache: Dict[Tuple, List[FileEntry]] = {}
        self._cur_stamp: int = -1
        self._cur_sig: Optional[Tuple] = None
        self._next_full_poll: float = 0.0
        self._pane_paths: List[str] = []
        self.cached_file_preview_key: Optional[Tuple] = None
        self.cached_file_preview_lines: List[str] = []
        self.cached_file_preview_path: Optional[str] = None
        self._cached_wrap_key: Optional[Tuple] = None
        self._cached_wrapped_lines: List[str] = []
        self._cached_wrap_raw_idx: int = 0

        # Parent/Child pane caches
        self.cached_parent_dir: Optional[str] = None
        self.cached_parent_items: List[FileEntry] = []
        self.cached_child_path: Optional[str] = None
        self.cached_child_items: List[FileEntry] = []

        # Frame-Puffer für differenzielles Zeichnen
        self._prev_frame: Optional[List[str]] = None

        self._kitty_preview: Optional[Tuple] = None
        self._kitty_last_shown: bool = False
        self._kitty_seq_cache: Dict = {}

        ensure_clip_helper()
        self.refresh_items()

    def get_kitty_image_sequence(self, png_path: str, cols: int, rows: int, row_pos: int, col_pos: int) -> str:
        """Gibt die Kitty-Graphics-Escape-Sequenz zurück (mit In-Memory-Caching)."""
        if not hasattr(self, "_kitty_seq_cache"):
            self._kitty_seq_cache = {}
        try:
            mtime = os.path.getmtime(png_path)
            cache_key = (png_path, mtime, cols, rows, row_pos, col_pos)
        except OSError:
            return ""
        if cache_key in self._kitty_seq_cache:
            return self._kitty_seq_cache[cache_key]
        seq = make_kitty_image_sequence(png_path, cols, rows, row_pos, col_pos)
        self._kitty_seq_cache[cache_key] = seq
        if len(self._kitty_seq_cache) > 50:
            first_k = next(iter(self._kitty_seq_cache))
            del self._kitty_seq_cache[first_k]
        return seq

    UNDO_BACKUP_DIR = os.path.join(CONFIG_DIR, "undo_backups")

    def get_effective_columns(self, term_cols: int) -> int:
        if term_cols >= 40:
            return 3
        if term_cols >= 24:
            return 2
        return 1

    def _console_history_prev(self) -> bool:
        """Springt in der Befehlshistorie einen Schritt zurueck; sichert dabei
        einen noch nicht gesendeten Entwurf (wie in bash). Gibt False zurueck,
        wenn kein aelterer Eintrag existiert."""
        if not (self.console_cmd_history and self.console_history_idx > 0):
            return False
        if self.console_history_idx >= len(self.console_cmd_history):
            self.console_history_draft = self.console_input
        self.console_history_idx -= 1
        self.console_input = self.console_cmd_history[self.console_history_idx]
        self.console_cursor_idx = len(self.console_input)
        return True

    def _console_history_next(self) -> None:
        """Springt in der Befehlshistorie einen Schritt vor; stellt am Ende
        den gesicherten Entwurf wieder her (wie in bash)."""
        if self.console_history_idx < len(self.console_cmd_history) - 1:
            self.console_history_idx += 1
            self.console_input = self.console_cmd_history[self.console_history_idx]
        else:
            self.console_history_idx = len(self.console_cmd_history)
            self.console_input = self.console_history_draft
        self.console_cursor_idx = len(self.console_input)

    def run(self):
        if not sys.stdin.isatty():
            print("EasyDateien erfordert ein interaktives Terminal.")
            return
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        self._saved_termios = old_settings
        try:
            from easydateien_ui import _install_resize_handler
            _install_resize_handler()
        except Exception:
            pass
        tty.setcbreak(fd, termios.TCSADRAIN)
        self._tui_active = True
        sys.stdout.write("\033[?1049h" + HIDE_CURSOR + DISABLE_AUTOWRAP + "\033[?1007h")
        self.sync_mouse_state()
        sys.stdout.write("\033[2J\033[3J\033[H")
        sys.stdout.flush()

        last_size = None
        needs_redraw = True
        try:
            while True:
                self.sync_mouse_state()
                curr_size = shutil.get_terminal_size((80, 24))
                term_cols, term_rows = curr_size.columns, curr_size.lines
                if curr_size != last_size:
                    last_size = curr_size
                    needs_redraw = True

                if needs_redraw:
                    lines = self.build_screen(term_cols, term_rows)
                    out_buf = []
                    # Kitty Graphics löschen, wenn zuvor gezeichnet oder jetzt aktiv
                    if supports_kitty_graphics() and (getattr(self, "_kitty_last_shown", False) or getattr(self, "_kitty_preview", None)):
                        out_buf.append(KITTY_CLEAR_VISIBLE)
                        self._kitty_last_shown = False

                    out_buf.append(f"\033[1;{term_rows}r")
                    for r_idx, l in enumerate(lines[:term_rows]):
                        out_buf.append(f"\033[{r_idx+1};1H\033[2K{l}")

                    kp = getattr(self, "_kitty_preview", None)
                    if kp and not self.active_dialog and supports_kitty_graphics():
                        png_path, pw, ph, prow, pcol = kp
                        seq = self.get_kitty_image_sequence(png_path, pw, ph, prow, pcol)
                        if seq:
                            out_buf.append(seq)
                            self._kitty_last_shown = True
                        if not (self.show_console and self.console_focused):
                            out_buf.append(f"\033[{term_rows};1H\033[?25l")

                    sys.stdout.write("".join(out_buf))
                    sys.stdout.flush()
                    needs_redraw = False

                key = read_key(fd, timeout=0.05)
                if not key:
                    # Kein Tastendruck: Dateisystem-Aenderungen (z. B. Downloads,
                    # rm im Hintergrund, externe Programme) sofort erkennen und
                    # die Anzeige aktuell halten, ohne auf eine Taste zu warten.
                    if self.poll_changes():
                        needs_redraw = True
                    # ZIP-Erstellung im Hintergrund: Fortschritt anzeigen und
                    # fertigen Job abschliessen (Status, Undo, Auswahl).
                    if self.poll_zip_creation():
                        needs_redraw = True
                    # Einfuegen im Hintergrund: Fortschritt anzeigen und
                    # fertigen Job abschliessen (Status, Undo, Zwischenablage).
                    if self.poll_paste():
                        needs_redraw = True
                    # Kopier-Feedback: Nach Ablauf der ~1 Sekunde das '+'
                    # automatisch entfernen (ein einmaliger Redraw genuegt).
                    if getattr(self, "_copy_flash_until", 0.0) and time.monotonic() >= self._copy_flash_until:
                        self._copy_flash_until = 0.0
                        self._copy_flash_paths = set()
                        needs_redraw = True
                    continue

                if self.active_dialog:
                    if self.handle_dialog_key(key, fd):
                        needs_redraw = True
                    continue

                if key in ("UP", "DOWN", "k", "j", "PAGE_UP", "PAGE_DOWN"):
                    if not (self.show_console and self.console_focused):
                        self.status_expiry_moves += 1
                        if self.status_expiry_moves >= 4:
                            self.status_message = ""

                if key.startswith("MOUSE_WHEEL_UP") or key.startswith("MOUSE_WHEEL_DOWN"):
                    is_up = key.startswith("MOUSE_WHEEL_UP")
                    coords = key.split(":")
                    cx = int(coords[1]) if len(coords) >= 3 else None
                    cy = int(coords[2]) if len(coords) >= 3 else None
                    self.handle_mouse_wheel("up" if is_up else "down", cx, cy)
                    needs_redraw = True
                    continue
                elif key.startswith("MOUSE_CLICK:"):
                    p = key.split(":")
                    if len(p) == 3:
                        cx, cy = int(p[1]), int(p[2])
                        if self.handle_mouse_click(cx, cy):
                            needs_redraw = True
                    continue
                elif key.startswith("MOUSE_RIGHT_CLICK:"):
                    p = key.split(":")
                    if len(p) == 3:
                        cx, cy = int(p[1]), int(p[2])
                        if self.handle_mouse_right_click(cx, cy):
                            needs_redraw = True
                    continue

                # 1. KONSOLE IM FOKUS:
                # Sämtliche Tastenbelegungen des restlichen Dateimanagers sind strikt inaktiv.
                # Tasteneingaben (u, z, d, q, r, y, x, p, e, etc.) werden ausschließlich in die Konsole geschrieben.
                # ESC schließt die Konsole, TAB wechselt den Fokus zum Dateimanager.
                if self.show_console and self.console_focused:
                    if key == "ESC":
                        if self.console_always_visible:
                            self.console_focused = False
                            
                        else:
                            self.show_console = False
                            self.console_focused = False
                            
                        needs_redraw = True
                    elif key == "TAB":
                        self.console_focused = False
                        
                        needs_redraw = True
                    elif key == "ENTER":
                        self.run_console_command(self.console_input, fd, old_settings)
                        needs_redraw = True
                    elif key in (" ", "SPACE"):
                        self.console_input = self.console_input[:self.console_cursor_idx] + " " + self.console_input[self.console_cursor_idx:]
                        self.console_cursor_idx += 1
                        needs_redraw = True
                    elif key == "BACKSPACE":
                        if self.console_cursor_idx > 0:
                            self.console_input = self.console_input[:self.console_cursor_idx - 1] + self.console_input[self.console_cursor_idx:]
                            self.console_cursor_idx -= 1
                            needs_redraw = True
                    elif key == "DELETE":
                        if self.console_cursor_idx < len(self.console_input):
                            self.console_input = self.console_input[:self.console_cursor_idx] + self.console_input[self.console_cursor_idx + 1:]
                            needs_redraw = True
                    elif key == "LEFT":
                        self.console_cursor_idx = max(0, self.console_cursor_idx - 1)
                        needs_redraw = True
                    elif key == "RIGHT":
                        self.console_cursor_idx = min(len(self.console_input), self.console_cursor_idx + 1)
                        needs_redraw = True
                    elif key in ("HOME", "\x01"):
                        self.console_cursor_idx = 0
                        needs_redraw = True
                    elif key in ("END", "\x05"):
                        self.console_cursor_idx = len(self.console_input)
                        needs_redraw = True
                    elif key == "\x17":  # Ctrl+W (Wort rückwärts löschen & in Zwischenablage)
                        before = self.console_input[:self.console_cursor_idx]
                        after = self.console_input[self.console_cursor_idx:]
                        before_stripped = re.sub(r'\S+\s*$', '', before)
                        deleted = before[len(before_stripped):]
                        if deleted:
                            copy_text_to_clipboard(deleted)
                        self.console_cursor_idx = len(before_stripped)
                        self.console_input = before_stripped + after
                        needs_redraw = True
                    elif key == "\x15":  # Ctrl+U (Zeile bis Cursor löschen & in Zwischenablage)
                        deleted = self.console_input[:self.console_cursor_idx]
                        if deleted:
                            copy_text_to_clipboard(deleted)
                        self.console_input = self.console_input[self.console_cursor_idx:]
                        self.console_cursor_idx = 0
                        needs_redraw = True
                    elif key == "\x0b":  # Ctrl+K (Zeile ab Cursor löschen & in Zwischenablage)
                        deleted = self.console_input[self.console_cursor_idx:]
                        if deleted:
                            copy_text_to_clipboard(deleted)
                        self.console_input = self.console_input[:self.console_cursor_idx]
                        needs_redraw = True
                    elif key == "\x19":  # Ctrl+Y (Yank / Einfügen aus macOS-Zwischenablage)
                        try:
                            pasted = subprocess.check_output(["pbpaste"], text=True)
                            if pasted:
                                pasted_clean = pasted.replace("\r\n", " ").replace("\n", " ").replace("\r", " ")
                                self.console_input = self.console_input[:self.console_cursor_idx] + pasted_clean + self.console_input[self.console_cursor_idx:]
                                self.console_cursor_idx += len(pasted_clean)
                                needs_redraw = True
                        except Exception:
                            pass
                    elif key == "\x0c":  # Ctrl+L (Terminal-Ausgabe leeren)
                        self.console_output_lines.clear()
                        self.console_scroll_offset = 0
                        needs_redraw = True
                    elif key in ("PAGE_UP", "SHIFT_UP", "CTRL_UP", "ALT_UP", "ALT_SHIFT_UP", "CTRL_SHIFT_UP"):
                        # Nach oben scrollen (Inhalt nach unten bewegen)
                        wrapped_lines: List[str] = []
                        for raw_line in self.console_output_lines:
                            wrapped_lines.extend(wrap_line_to_width(raw_line, max(1, shutil.get_terminal_size((80, 24)).columns - 4)))
                        max_scroll = max(0, len(wrapped_lines) - 1)
                        self.console_scroll_offset = min(max_scroll, self.console_scroll_offset + 2)
                        needs_redraw = True
                    elif key in ("PAGE_DOWN", "SHIFT_DOWN", "CTRL_DOWN", "ALT_DOWN", "ALT_SHIFT_DOWN", "CTRL_SHIFT_DOWN"):
                        # Nach unten scrollen (Inhalt nach oben bewegen)
                        self.console_scroll_offset = max(0, self.console_scroll_offset - 2)
                        needs_redraw = True
                    elif key == "UP":
                        # Befehlshistorie oder Scrollen
                        if not self._console_history_prev():
                            # Kein Historieneintrag mehr: Nach oben scrollen
                            # (Inhalt nach unten bewegen)
                            wrapped_lines: List[str] = []
                            for raw_line in self.console_output_lines:
                                wrapped_lines.extend(wrap_line_to_width(raw_line, max(1, shutil.get_terminal_size((80, 24)).columns - 4)))
                            max_scroll = max(0, len(wrapped_lines) - 1)
                            self.console_scroll_offset = min(max_scroll, self.console_scroll_offset + 1)
                        needs_redraw = True
                    elif key == "DOWN":
                        # Befehlshistorie oder Scrollen
                        if self.console_scroll_offset > 0:
                            # Nach unten scrollen (Inhalt nach oben bewegen)
                            self.console_scroll_offset = max(0, self.console_scroll_offset - 1)
                        elif self.console_cmd_history:
                            self._console_history_next()
                        needs_redraw = True
                    elif key == "CTRL_C":
                        self.console_input = ""
                        self.console_cursor_idx = 0
                        self.console_output_lines.append("^C")
                        needs_redraw = True
                    elif key == "CTRL_D":
                        if self.console_input:
                            if self.console_cursor_idx < len(self.console_input):
                                self.console_input = self.console_input[:self.console_cursor_idx] + self.console_input[self.console_cursor_idx + 1:]
                                needs_redraw = True
                        else:
                            if self.console_always_visible:
                                self.console_focused = False
                                
                            else:
                                self.show_console = False
                                self.console_focused = False
                                
                            needs_redraw = True
                    elif key == "UNDO":
                        pass
                    elif len(key) >= 1 and not key.startswith("MOUSE_") and all(c.isprintable() for c in key):
                        self.console_input = self.console_input[:self.console_cursor_idx] + key + self.console_input[self.console_cursor_idx:]
                        self.console_cursor_idx += len(key)
                        needs_redraw = True
                    continue

                # 2. DATEIMANAGER-MODUS (Konsole geschlossen ODER Konsole geöffnet aber nicht im Fokus):
                # Sämtliche Tastenkürzel für Dateiverwaltung sind voll aktiv.
                # Keine Zeichen fließen in die Konsole.
                # Alle Aktionen werden über die keymap aufgelöst (Single Source
                # of Truth): Geänderte Tastenbelegungen aus dem Konfigurator
                # wirken hier unmittelbar.
                action = self.keymap.get(key)
                if action == "cancel_cmd":
                    if self.filter_query:
                        self.filter_query = ""
                        self.refresh_items(force=True)
                        self.set_status("Filter aufgehoben")
                        needs_redraw = True
                    elif self.selected_paths:
                        self.selected_paths.clear()
                        self.set_status("Auswahl aufgehoben")
                        needs_redraw = True
                    elif self.clipboard_mode == "cut":
                        self.clipboard_mode = None
                        self.clipboard_paths = []
                        self.set_status("Ausschneiden aufgehoben")
                        needs_redraw = True
                    continue

                if action == "undo":
                    self.undo_last_action()
                    needs_redraw = True
                    continue

                if action == "cancel":
                    if self.show_console and not self.console_always_visible:
                        self.show_console = False
                        self.console_focused = False
                        needs_redraw = True
                        continue
                    if self.filter_query:
                        self.filter_query = ""
                        self.refresh_items(force=True)
                        self.set_status("Filter aufgehoben")
                        needs_redraw = True
                        continue
                    if self.selected_paths:
                        self.selected_paths.clear()
                        self.set_status("Auswahl aufgehoben")
                        needs_redraw = True
                        continue
                    elif self.clipboard_mode == "cut":
                        self.clipboard_mode = None
                        self.clipboard_paths = []
                        self.set_status("Ausschneiden aufgehoben")
                        needs_redraw = True
                        continue
                    continue

                if action == "console_focus":
                    if self.show_console:
                        self.console_focused = True
                        
                        needs_redraw = True
                    else:
                        self.toggle_console()
                        needs_redraw = True
                    continue

                if action == "help":
                    self.active_dialog = "help_menu"
                    self.help_scroll_offset = 0
                    needs_redraw = True
                    continue

                if action == "console":
                    self.toggle_console()
                    needs_redraw = True
                    continue

                if action == "mark_dir":
                    self.marked_dir = self.current_dir
                    self.set_status(f"Ordner gemerkt: {self.get_short_dir(self.current_dir)} (g- springt zurück)", "success")
                    needs_redraw = True
                    continue
                if action == "schnellstart":
                    self.open_schnellstart()
                    needs_redraw = True
                    continue
                if action == "goto":
                    self.active_dialog = "goto_menu"
                    needs_redraw = True
                    continue

                if action == "search":
                    self.active_dialog = "search"
                    self.dialog_input = self.filter_query
                    self.dialog_cursor = len(self.dialog_input)
                    needs_redraw = True
                    continue

                if action == "new":
                    self.active_dialog = "new"
                    self.dialog_input = ""
                    self.dialog_cursor = 0
                    needs_redraw = True
                    continue

                if action == "sort":
                    self.toggle_sort()
                    needs_redraw = True
                    continue

                if action == "home":
                    self.change_directory(HOME_DIR)
                    self.set_status("Home (~)")
                    needs_redraw = True
                    continue

                if action == "up":
                    if self.items:
                        self.selected_idx = max(0, self.selected_idx - 1)
                        needs_redraw = True
                    continue
                elif action == "down":
                    if self.items:
                        self.selected_idx = min(len(self.items) - 1, self.selected_idx + 1)
                        needs_redraw = True
                    continue
                elif action == "page_up" or (action is None and key in ("SHIFT_UP", "CTRL_UP", "ALT_UP", "ALT_SHIFT_UP", "CTRL_SHIFT_UP")):
                    if self._preview_aktiv():
                        self._scroll_preview(-1)
                        needs_redraw = True
                    continue
                elif action == "page_down" or (action is None and key in ("SHIFT_DOWN", "CTRL_DOWN", "ALT_DOWN", "ALT_SHIFT_DOWN", "CTRL_SHIFT_DOWN")):
                    if self._preview_aktiv():
                        self._scroll_preview(1)
                        needs_redraw = True
                    continue
                elif action == "left":
                    self.dir_cursor_memory[self.current_dir] = self.selected_idx
                    self.go_parent_directory()
                    needs_redraw = True
                    continue
                elif action == "right":
                    if self.items:
                        item = self.items[self.selected_idx]
                        if item.is_dir:
                            self.dir_cursor_memory[self.current_dir] = self.selected_idx
                            self.change_directory(item.path)
                            remembered_idx = self.dir_cursor_memory.get(self.current_dir)
                            if remembered_idx is not None and self.items:
                                self.selected_idx = max(0, min(remembered_idx, len(self.items) - 1))
                            needs_redraw = True
                    continue
                elif action == "extract":
                    if self.items:
                        item = self.items[self.selected_idx]
                        if not item.is_dir and item.name.lower().endswith('.zip'):
                            self.extract_zip_archive()
                            needs_redraw = True
                        elif not item.is_dir:
                            self.set_status("Taste 'e' ist für ZIP-Entpacken reserviert", "warning")
                    continue
                elif action == "edit":
                    if self.items:
                        item = self.items[self.selected_idx]
                        if not item.is_dir:
                            self.open_in_editor(item, fd, old_settings)
                            needs_redraw = True
                    continue
                elif action == "open":
                    if self.items and 0 <= self.selected_idx < len(self.items):
                        item = self.items[self.selected_idx]
                        self.open_with_system(item)
                    else:
                        try:
                            user_shell, env = get_shell_environment()
                            subprocess.Popen(["open", self.current_dir], start_new_session=True, env=env)
                            self.set_status(f"Im Finder geöffnet: {self.get_short_dir(self.current_dir)}", "success")
                        except Exception as e:
                            self.set_status(f"Fehler: {e}", "error")
                    needs_redraw = True
                    continue
                elif action == "rename":
                    if self.items:
                        item = self.items[self.selected_idx]
                        self.active_dialog = "rename"
                        self.dialog_input = item.name
                        self.dialog_cursor = len(item.name)
                        self.dialog_target_item = item
                        needs_redraw = True
                    continue
                elif action == "zip":
                    # Asynchron: laeuft in einem Hintergrund-Thread, die App
                    # bleibt voll bedienbar; poll_zip_creation() schliesst ab.
                    if self.start_zip_creation():
                        needs_redraw = True
                    continue
                elif action == "copy":
                    self.active_dialog = "copy_menu"
                    needs_redraw = True
                    continue
                elif action == "symlink":
                    if self.items:
                        self.active_dialog = "symlink"
                        self.dialog_input = ""
                        self.dialog_cursor = 0
                        needs_redraw = True
                    continue
                elif action == "cut":
                    self.cut_selection()
                    needs_redraw = True
                    continue
                elif action == "paste":
                    # Asynchron: grosses Einfuegen blockiert die Bedienung nicht
                    self.paste_clipboard()
                    needs_redraw = True
                    continue
                elif action == "select":
                    self.toggle_select()
                    needs_redraw = True
                    continue
                elif action == "select_all":
                    self.toggle_select_all()
                    needs_redraw = True
                    continue
                elif action == "trash":
                    if self.items or self.selected_paths:
                        self.active_dialog = "trash_confirm"
                        needs_redraw = True
                    continue
                elif action == "hidden":
                    new_h = not self.config.get("show_hidden", False)
                    self.config["show_hidden"] = new_h
                    self.refresh_items(force=True)
                    self.set_status(f"Versteckte Dateien: {'Ein' if new_h else 'Aus'}")
                    needs_redraw = True
                    continue
                elif action == "menu":
                    try:
                        from easydateien_konfigurator import run_konfigurator
                        new_cfg = run_konfigurator(standalone=False)
                        self.config.clear()
                        self.config.update(new_cfg)
                        self.show_console = self.config.get("show_console", False)
                    except Exception as e:
                        self.set_status(f"Fehler Konfigurator: {e}", "error")
                    tty.setcbreak(fd, termios.TCSADRAIN)
                    sys.stdout.write("\033[?1049h" + HIDE_CURSOR + DISABLE_AUTOWRAP + "\033[?1007h")
                    # Konfiguration neu laden — inklusive keymap, damit
                    # geänderte Tastenbelegungen sofort wirken
                    try:
                        self.keymap = build_keymap(self.config)
                        self.keybindings = get_keybindings_from_config(self.config)
                    except ValueError:
                        self.set_status("Tastenkonflikt in Config — Standardbelegung aktiv", "warning")
                        self.keymap = build_keymap(None)
                        self.keybindings = get_keybindings_from_config(None)
                    self.console_always_visible = self.config.get("console_always_visible", False)
                    self.preview_wrap = self.config.get("preview_wrap", True)
                    self.show_console = self.config.get("show_console", False) or self.console_always_visible
                    self.sync_mouse_state()
                    sys.stdout.write("\033[2J\033[3J\033[H")
                    sys.stdout.flush()
                    self.refresh_items(force=True)
                    self.set_status("Einstellungen übernommen", "success")
                    needs_redraw = True
                    continue
                elif action == "top":
                    self.selected_idx = 0
                    needs_redraw = True
                    continue
                elif action == "bottom":
                    if self.items:
                        self.selected_idx = len(self.items) - 1
                        needs_redraw = True
                    continue
                elif action == "quit":
                    break
        finally:
            try:
                self._sync_cwd()
            except Exception:
                pass
            # Stoisch: jeder Schritt einzeln abgesichert — ein Fehler darf
            # weder die Wiederherstellung verhindern noch die App crashen.
            try:
                # Laufende Hintergrund-Jobs (ZIP, Einfuegen) kurz abwarten,
                # damit beim Beenden keine halbfertige Datei zurueckbleibt.
                for job_attr in ("_zip_thread", "_paste_thread"):
                    job_thread = getattr(self, job_attr, None)
                    if job_thread is not None and job_thread.is_alive():
                        job_thread.join(timeout=10.0)
            except Exception:
                pass
            try:
                self.set_mouse_tracking(False, force=True)
            except Exception:
                pass
            try:
                if supports_kitty_graphics():
                    sys.stdout.write(KITTY_PURGE_ALL)
                sys.stdout.write("\033[?1007l\033[?1000l\033[?1006l\033[r" + ENABLE_AUTOWRAP + SHOW_CURSOR + "\033[?1049l")
                sys.stdout.flush()
            except Exception:
                pass
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            except Exception:
                pass
            self._tui_active = False


class SingleLineHelpFormatter(argparse.HelpFormatter):
    """Formatiert CLI-Hilfen streng einzeilig nach txt2pdf-Norm."""
    def _split_lines(self, text, width):
        return [text]

def print_shell_init(shell_name: str):
    shell_name = (shell_name or "zsh").strip().lower()
    if shell_name in ("zsh", "bash"):
        code = '''easydateien() {
    local cwd_file
    cwd_file="$(mktemp -t "easydateien-cwd.XXXXXX" 2>/dev/null || mktemp "${TMPDIR:-/tmp}/easydateien-cwd.XXXXXX")"
    command easydateien --cwd-file="$cwd_file" "$@"
    local ret=$?
    if [ -f "$cwd_file" ]; then
        local new_dir
        new_dir="$(cat "$cwd_file" 2>/dev/null)"
        rm -f "$cwd_file"
        if [ -n "$new_dir" ] && [ -d "$new_dir" ] && [ "$new_dir" != "$PWD" ]; then
            builtin cd -- "$new_dir"
        fi
    fi
    return $ret
}
alias ed="easydateien"
'''
        sys.stdout.write(code)
    elif shell_name == "fish":
        code = '''function easydateien
    set -l cwd_file (mktemp -t "easydateien-cwd.XXXXXX" 2>/dev/null; or mktemp "/tmp/easydateien-cwd.XXXXXX")
    command easydateien --cwd-file=$cwd_file $argv
    set -l ret $status
    if test -f $cwd_file
        set -l new_dir (cat $cwd_file 2>/dev/null)
        rm -f $cwd_file
        if test -n "$new_dir" -a -d "$new_dir" -a "$new_dir" != "$PWD"
            builtin cd -- $new_dir
        end
    end
    return $ret
end
alias ed=easydateien
'''
        sys.stdout.write(code)
    else:
        sys.stderr.write(f"Unbekannte Shell: '{shell_name}'. Unterstützt: zsh, bash, fish\n")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(
        prog="easydateien",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="Minimalistischer, hocheffizienter Terminal-Dateimanager für macOS.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-c", "--config", action="store_true", help="Konfigurationsmenü öffnen")
    parser.add_argument("-v", "--version", action="version", version="EasyDateien 1.5.0", help="Programmversion anzeigen")
    parser.add_argument("--cwd-file", dest="cwd_file", default=None, help="Pfad zur Datei, in die das Arbeitsverzeichnis geschrieben wird")
    parser.add_argument("--init", dest="init_shell", nargs="?", const="zsh", default=None, help="Shell-Integrationscode ausgeben (zsh, bash, fish)")
    parser.add_argument("pfad", nargs="?", default=None, help="Startverzeichnis")
    args = parser.parse_args()

    if args.init_shell:
        print_shell_init(args.init_shell)
        return

    if args.config:
        from easydateien_konfigurator import run_konfigurator
        try:
            run_konfigurator(standalone=True)
        except KeyboardInterrupt:
            pass
        return

    try:
        app = EasyDateienApp(initial_path=args.pfad, cwd_file=args.cwd_file)
        app.run()
    except KeyboardInterrupt:
        pass
    finally:
        # Garantierter Terminal-Reset — auch bei unerwarteten Ausnahmen:
        # Scroll-Region aufheben, Autowrap zuruecksetzen, Cursor zeigen,
        # Alternativbildschirm verlassen. Jeder Schritt einzeln abgesichert.
        import sys as _sys
        for seq in ("\033[?1007l", "\033[?1000l", "\033[?1006l", "\033[r",
                    "\033[?7h", "\033[?25h", "\033[?1049l"):
            try:
                _sys.stdout.write(seq)
            except Exception:
                pass
        try:
            _sys.stdout.flush()
        except Exception:
            pass
        # termios: nur den von run() gesicherten Ausgangszustand wiederher-
        # stellen. Niemals setcbreak() aufrufen — das wuerde das Terminal nach
        # jedem Beenden erneut in den cbreak-Modus (kein Echo, kein kanoni-
        # scher Modus) versetzen und die Shell danach unbedienbar machen.
        try:
            import termios as _termios
            _saved = getattr(app, "_saved_termios", None)
            if _saved is not None:
                _termios.tcsetattr(_sys.stdin.fileno(), _termios.TCSADRAIN, _saved)
        except Exception:
            pass
if __name__ == "__main__":
    main()
