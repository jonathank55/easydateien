# Farbcodes nach optimi-Farbnorm
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_ITALIC = "\033[3m"
C_BLUE = "\033[0;34m"
C_BOLD_BLUE = "\033[1;34m"
C_CYAN = "\033[0;36m"
C_BOLD_CYAN = "\033[1;36m"
C_GREEN = "\033[0;32m"
C_BOLD_GREEN = "\033[1;32m"
C_YELLOW = "\033[1;33m"
C_RED = "\033[0;31m"
C_BOLD_RED = "\033[1;31m"
C_MAGENTA = "\033[0;35m"
C_GRAY = "\033[90m"
C_INVERT = "\033[7m"

CLEAR_LINE = "\033[2K"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"

ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")


def char_width(c: str) -> int:
    """Ermittelt die visuelle Terminal-Spaltenbreite eines einzelnen Zeichens."""
    if not c or unicodedata.category(c) in ("Mn", "Me", "Cc", "Cf", "Cs"):
        return 0
    eaw = unicodedata.east_asian_width(c)
    if eaw in ("W", "F"):
        return 2
    cp = ord(c)
    if (0x1F300 <= cp <= 0x1FAFF) or (0x2600 <= cp <= 0x27BF) or (0xFE00 <= cp <= 0xFE0F):
        return 2
    return 1


def str_width(text: str) -> int:
    """Berechnet die tatsächliche sichtbare Spaltenbreite eines Textes ohne ANSI-Codes."""
    clean = ANSI_ESCAPE_RE.sub("", text)
    return sum(char_width(c) for c in clean)


def truncate_to_width(text: str, max_w: int, ellipsis: str = "…") -> str:
    """Kürzt Text deterministisch auf die maximale visuelle Terminalbreite."""
    if max_w <= 0:
        return ""
    if str_width(text) <= max_w:
        return text
    e_w = str_width(ellipsis)
    if max_w <= e_w:
        res = ""
        w = 0
        for c in text:
            cw = char_width(c)
            if w + cw > max_w:
                break
            res += c
            w += cw
        return res
    target_w = max_w - e_w
    res = ""
    w = 0
    for c in text:
        cw = char_width(c)
        if w + cw > target_w:
            break
        res += c
        w += cw
    return res + ellipsis


def pad_to_width(text: str, width: int, align: str = "left") -> str:
    """Füllt formatierten Text exakt auf die gewünschte visuelle Terminalbreite auf."""
    w = str_width(text)
    if w > width:
        clean = ANSI_ESCAPE_RE.sub("", text)
        return truncate_to_width(clean, width)
    pad = " " * (width - w)
    return (pad + text) if align == "right" else (text + pad)


def format_size(size_bytes: int) -> str:
    """Formatiert Byte-Größen nach standardisierten Einheiten."""
    if size_bytes < 1024:
        return f"{size_bytes} B"
    val = float(size_bytes)
    for unit in ["KB", "MB", "GB", "TB", "PB"]:
        val /= 1024.0
        if val < 1024.0 or unit == "PB":
            return f"{val:.1f} {unit}"
    return f"{val:.1f} PB"


def format_mtime(mtime: float) -> str:
    """Formatiert Änderungszeitpunkte lesbar."""
    try:
        dt = datetime.datetime.fromtimestamp(mtime)
        now = datetime.datetime.now()
        return dt.strftime("%d. %b %H:%M") if dt.year == now.year else dt.strftime("%d.%m.%Y")
    except Exception:
        return "---"


def sync_to_macos_clipboard(paths: List[str]):
    """Synchronisiert Dateipfade in die macOS-Zwischenablage (Finder & pbcopy)."""
    if not paths:
        return
    abs_paths = [os.path.abspath(p) for p in paths if os.path.exists(p)]
    if not abs_paths:
        return
    try:
        items = ", ".join([f'(POSIX file "{p.replace(chr(34), chr(92)+chr(34))}" as alias)' for p in abs_paths])
        as_code = f'tell application "Finder" to set the clipboard to {{{items}}}'
        subprocess.run(["osascript", "-e", as_code], capture_output=True, timeout=1.0)
    except Exception:
        pass
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(input="\n".join(abs_paths).encode("utf-8"))
    except Exception:
        pass


def get_macos_clipboard_files() -> List[str]:
    """Liest Dateipfade aus der macOS-Zwischenablage."""
    try:
        out = subprocess.check_output(["pbpaste"], text=True)
        lines = [l.strip() for l in out.splitlines() if l.strip() and os.path.exists(l.strip())]
        if lines:
            return lines
    except Exception:
        pass
    return []


def copy_text_to_clipboard(text: str):
    """Kopiert reinen Text in das macOS-Clipboard."""
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass


class FileEntry:
    __slots__ = ("name", "path", "is_dir", "is_symlink", "is_exec", "size", "mtime", "ext", "mode_str", "symlink_target")

    def __init__(self, path: str, name: str):
        self.path = path
        self.name = name
        self.is_dir = False
        self.is_symlink = os.path.islink(path)
        self.is_exec = False
        self.size = 0
        self.mtime = 0.0
        self.mode_str = "----------"
        self.symlink_target = ""
        _, self.ext = os.path.splitext(name)
        try:
            st = os.stat(path, follow_symlinks=False)
            self.mtime = st.st_mtime
            try:
                self.mode_str = stat.filemode(st.st_mode)
            except Exception:
                pass
            self.is_dir = os.path.isdir(path) if self.is_symlink else stat.S_ISDIR(st.st_mode)
            self.is_exec = bool(st.st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)) and not self.is_dir
            self.size = st.st_size
            if self.is_symlink:
                try:
                    self.symlink_target = os.readlink(path)
                except Exception:
                    pass
        except Exception:
            pass


def get_file_type_desc(item: FileEntry) -> str:
    """Liefert eine präzise deutsche Typbezeichnung."""
    if item.is_dir:
        return "Verzeichnis"
    if item.is_symlink:
        return "Symbolischer Link"
    ext = item.ext.lower()
    m = {
        ".txt": "Textdokument", ".md": "Markdown-Datei", ".py": "Python-Skript",
        ".sh": "Shell-Skript", ".zsh": "Zsh-Skript", ".bash": "Bash-Skript",
        ".json": "JSON-Dokument", ".toml": "TOML-Konfiguration", ".yaml": "YAML-Datei",
        ".yml": "YAML-Datei", ".pdf": "PDF-Dokument", ".zip": "ZIP-Archiv",
        ".tar": "TAR-Archiv", ".gz": "GZIP-Archiv", ".dmg": "Apple Disk Image",
        ".png": "PNG-Bild", ".jpg": "JPEG-Bild", ".jpeg": "JPEG-Bild",
        ".svg": "SVG-Vektorgrafik", ".gif": "GIF-Animation", ".webp": "WebP-Bild",
        ".html": "HTML-Dokument", ".css": "CSS-Stylesheet", ".js": "JavaScript",
        ".ts": "TypeScript", ".typ": "Typst-Dokument", ".rtf": "Rich-Text-Format",
        ".mp3": "MP3-Audiodatei", ".wav": "WAV-Audiodatei", ".mp4": "MP4-Videodatei",
        ".mov": "QuickTime-Video", ".csv": "CSV-Tabelle",
    }
    if ext in m:
        return m[ext]
    if item.is_exec:
        return "Ausführbare Datei"
    return f"Datei ({ext})" if ext else "Binärdatei"


def get_file_colored_name(item: FileEntry) -> str:
    """Formatiert den Dateinamen mit dezenten typbezogenen Farbakzenten."""
    name_disp = item.name + ("/" if item.is_dir else ("@" if item.is_symlink else ""))
    if item.is_dir:
        return f"{C_BOLD_BLUE}{name_disp}{C_RESET}"
    if item.is_symlink:
        return f"{C_CYAN}{name_disp}{C_RESET}"
    if item.is_exec:
        return f"{C_BOLD_GREEN}{name_disp}{C_RESET}"
    ext = item.ext.lower()
    if ext in (".zip", ".tar", ".gz", ".bz2", ".xz", ".dmg", ".pkg", ".7z", ".rar"):
        return f"{C_YELLOW}{name_disp}{C_RESET}"
    if ext in (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".mp4", ".mov", ".mp3", ".wav"):
        return f"{C_MAGENTA}{name_disp}{C_RESET}"
    if ext in (".py", ".sh", ".zsh", ".bash", ".js", ".ts", ".html", ".css", ".json", ".yaml", ".yml", ".toml", ".typ"):
        return f"{C_CYAN}{name_disp}{C_RESET}"
    return name_disp


def scan_directory(
    path: str,
    show_hidden: bool = False,
    sort_by: str = "mtime",
    sort_reverse: bool = True,
    sort_dir_first: bool = True,
    filter_query: str = ""
) -> List[FileEntry]:
    """Liest ein Verzeichnis ein, filtert und sortiert deterministisch."""
    entries = []
    try:
        with os.scandir(path) as it:
            for entry in it:
                if not show_hidden and entry.name.startswith("."):
                    continue
                if filter_query and filter_query.lower() not in entry.name.lower():
                    continue
                entries.append(FileEntry(entry.path, entry.name))
    except Exception:
        return []

    def sort_key(e: FileEntry):
        if sort_by == "name":
            return e.name.lower()
        elif sort_by == "size":
            return e.size
        elif sort_by == "ext":
            return e.ext.lower()
        return e.mtime

    entries.sort(key=sort_key, reverse=sort_reverse)
    if sort_dir_first:
        entries.sort(key=lambda e: not e.is_dir)
    return entries


def read_key(fd: int, timeout: float = 0.05) -> str:
    """Liest Tastatur- und Maus-Events zuverlässig über SGR und ANSI-Sequenzen."""
    try:
        r, _, _ = select.select([fd], [], [], timeout)
        if not r:
            return ""
        raw = os.read(fd, 1)
        if not raw:
            return ""
        if raw == b"\x1b":
            seq = b""
            while True:
                r2, _, _ = select.select([fd], [], [], 0.05)
                if not r2:
                    break
                c = os.read(fd, 1)
                if not c:
                    break
                seq += c
                if seq.startswith(b"[<"):
                    if seq.endswith(b"M") or seq.endswith(b"m") or len(seq) >= 30:
                        break
                elif len(seq) >= 2 and seq[-1:] in b"ABCDHFS~":
                    break
                elif len(seq) >= 6:
                    break
            if not seq:
                return "ESC"
            if seq.startswith(b"[<") and (seq.endswith(b"M") or seq.endswith(b"m")):
                try:
                    is_rel = seq.endswith(b"m")
                    b_s, x_s, y_s = seq[2:-1].decode("ascii").split(";")
                    b_c = int(b_s)
                    if b_c == 64:
                        return "MOUSE_WHEEL_UP"
                    elif b_c == 65:
                        return "MOUSE_WHEEL_DOWN"
                    elif not is_rel and b_c == 0:
                        return f"MOUSE_CLICK:{int(x_s)}:{int(y_s)}"
                    elif not is_rel and b_c == 2:
                        return f"MOUSE_RIGHT_CLICK:{int(x_s)}:{int(y_s)}"
                except Exception:
                    pass
                return "MOUSE_EVENT"

            # ANSI- und SS3-Sequenzen mappen
            mapping = {
                b"[A": "UP", b"[B": "DOWN", b"[C": "RIGHT", b"[D": "LEFT",
                b"OA": "UP", b"OB": "DOWN", b"OC": "RIGHT", b"OD": "LEFT",
                b"[H": "HOME", b"[F": "END", b"OH": "HOME", b"OF": "END",
                b"[1~": "HOME", b"[4~": "END", b"[7~": "HOME", b"[8~": "END",
                b"[5~": "PAGE_UP", b"[6~": "PAGE_DOWN", b"[3~": "DELETE",
                b"[Z": "SHIFT_TAB"
            }
            return mapping.get(seq, "")

        if raw in (bytes([13]), bytes([10])):
            return "ENTER"
        elif raw == b" ":
            return "SPACE"
        elif raw == b"\t":
            return "TAB"
        elif raw in (bytes([127]), bytes([8])):
            return "BACKSPACE"
        elif raw in (bytes([3]), bytes([4])):
            return "QUIT"

        if raw[0] >= 0xC0:
            needed = 2 if raw[0] < 0xE0 else (3 if raw[0] < 0xF0 else 4)
            ch_b = raw
            while len(ch_b) < needed:
                r, _, _ = select.select([fd], [], [], 0.03)
                if not r:
                    break
                ch_b += os.read(fd, 1)
            try:
                return ch_b.decode("utf-8")
            except Exception:
                return ""
        try:
            return raw.decode("utf-8")
        except Exception:
            return ""
    except Exception:
        return ""


class EasyDateienApp:
    def __init__(self, initial_path: Optional[str] = None):
        self.current_dir = os.path.abspath(initial_path if initial_path else os.getcwd())
        self.config = self.load_config()
        self.items: List[FileEntry] = []
        self.selected_idx: int = 0
        self.selected_paths: Set[str] = set()
        self.clipboard_paths: List[str] = []
        self.clipboard_mode: Optional[str] = None
        self.status_message: str = ""
        self.status_level: str = "info"  # "info", "success", "warning", "error"
        self.status_expiry_moves: int = 0
        self.filter_query: str = ""

        # Interaktiver Eingabemodus
        self.active_dialog: Optional[str] = None  # None, "rename", "new", "search", "goto_path", "trash_confirm", "goto_menu"
        self.dialog_input: str = ""
        self.dialog_cursor: int = 0
        self.dialog_target_item: Optional[FileEntry] = None

        # Mausklick & Navigation
        self.last_click_time: float = 0.0
        self.last_click_idx: Optional[int] = None
        self.last_right_arrow_time: float = 0.0
        self.last_right_arrow_path: str = ""
        self.last_layout: Dict = {}

        # Terminal-Konsole
        self.show_console: bool = self.config.get("show_console", False)
        self.console_position: str = self.config.get("console_position", "unten").lower()
        self.console_focused: bool = False
        self.console_input: str = ""
        self.console_cursor_idx: int = 0
        self.console_output_lines: List[str] = []
        self.console_cmd_history: List[str] = []
        self.console_history_idx: int = 0
        self.console_scroll_offset: int = 0

        # Caching
        self.cached_parent_dir: Optional[str] = None
        self.cached_parent_items: List[FileEntry] = []
        self.cached_child_path: Optional[str] = None
        self.cached_child_items: List[FileEntry] = []
        self.cached_file_preview_path: Optional[str] = None
        self.cached_file_preview_lines: List[str] = []

        self.refresh_items()

    def load_config(self) -> dict:
        cfg = {
            "divider_style": "alle", "columns_enabled": True, "show_controls": False,
            "esc_to_quit": False, "mouse_support": True, "show_console": False,
            "console_position": "unten", "text_editor": "nano %s", "opener": "open %s",
            "sort_by": "mtime", "sort_reverse": True, "sort_dir_first": True,
            "show_hidden": False,
        }
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    cfg.update(json.load(f))
            except Exception:
                pass
        return cfg

    def set_status(self, msg: str, level: str = "info"):
        self.status_message = msg
        self.status_level = level
        self.status_expiry_moves = 0

    def refresh_items(self):
        self.cached_parent_dir = None
        self.cached_child_path = None
        self.cached_file_preview_path = None
        self.items = scan_directory(
            self.current_dir,
            show_hidden=self.config.get("show_hidden", False),
            sort_by=self.config.get("sort_by", "mtime"),
            sort_reverse=self.config.get("sort_reverse", True),
            sort_dir_first=self.config.get("sort_dir_first", True),
            filter_query=self.filter_query,
        )
        if self.selected_idx >= len(self.items):
            self.selected_idx = max(0, len(self.items) - 1)

    def change_directory(self, new_path: str):
        if os.path.isdir(new_path):
            self.current_dir = os.path.abspath(new_path)
            self.selected_idx = 0
            self.refresh_items()

    def select_filename(self, name: str):
        for i, it in enumerate(self.items):
            if it.name == name:
                self.selected_idx = i
                break

    def go_parent_directory(self):
        parent = os.path.dirname(self.current_dir)
        if parent and parent != self.current_dir:
            prev_name = os.path.basename(self.current_dir)
            self.current_dir = parent
            self.refresh_items()
            self.select_filename(prev_name)

    def open_with_system(self, item: FileEntry):
        opener = self.config.get("opener", "open %s")
        cmd = opener.replace("%s", f'"{item.path}"')
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
            self.set_status(f"Geöffnet: {item.name}", "success")
        except Exception as e:
            self.set_status(f"Fehler: {e}", "error")

    def open_in_editor(self, item: FileEntry, fd: Optional[int], old_settings):
        if fd is not None and old_settings is not None:
            mouse_on = self.config.get("mouse_support", True)
            if mouse_on:
                sys.stdout.write("\033[?1006l\033[?1000l")
                sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            sys.stdout.write(SHOW_CURSOR + "\033[?1049l")
            sys.stdout.flush()
            editor_cmd = self.config.get("text_editor", "nano %s").replace("%s", f'"{item.path}"')
            try:
                subprocess.run(editor_cmd, shell=True)
            finally:
                tty.setcbreak(fd, termios.TCSADRAIN)
                sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                if mouse_on:
                    sys.stdout.write("\033[?1000h\033[?1006h")
                sys.stdout.write("\033[2J\033[H")
                sys.stdout.flush()
                self.refresh_items()

    def toggle_select(self):
        if not self.items:
            return
        item = self.items[self.selected_idx]
        if item.path in self.selected_paths:
            self.selected_paths.remove(item.path)
            self.set_status(f"Auswahl: {len(self.selected_paths)}" if self.selected_paths else "Auswahl aufgehoben")
        else:
            self.selected_paths.add(item.path)
            if item.path in self.clipboard_paths:
                self.clipboard_paths.remove(item.path)
            self.set_status(f"Auswahl: {len(self.selected_paths)}")
        if self.selected_idx < len(self.items) - 1:
            self.selected_idx += 1

    def toggle_select_all(self):
        all_paths = {it.path for it in self.items}
        if not all_paths:
            return
        if self.selected_paths.issuperset(all_paths):
            self.selected_paths.clear()
            self.set_status("Auswahl aufgehoben")
        else:
            self.selected_paths.update(all_paths)
            self.set_status(f"Alle {len(self.selected_paths)} markiert")

    def cut_selection(self):
        if not self.items:
            return
        cur_p = self.items[self.selected_idx].path
        if self.clipboard_mode == "cut" and not self.selected_paths and cur_p in self.clipboard_paths:
            self.clipboard_mode = None
            self.clipboard_paths = []
            self.set_status("Ausschneiden aufgehoben")
            return
        targets = list(self.selected_paths) if self.selected_paths else [cur_p]
        self.clipboard_mode = "cut"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        sync_to_macos_clipboard(targets)
        self.set_status(f"{len(targets)} ausgeschnitten (p = einfügen)", "warning")

    def copy_selection(self):
        if not self.items:
            return
        cur_p = self.items[self.selected_idx].path
        if self.clipboard_mode == "copy" and not self.selected_paths and cur_p in self.clipboard_paths:
            self.clipboard_mode = None
            self.clipboard_paths = []
            self.set_status("Kopieren aufgehoben")
            return
        targets = list(self.selected_paths) if self.selected_paths else [cur_p]
        self.clipboard_mode = "copy"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        sync_to_macos_clipboard(targets)
        self.set_status(f"{len(targets)} kopiert (Cmd+V im Finder, p hier)", "success")

    def paste_clipboard(self):
        sources = list(self.clipboard_paths) if self.clipboard_paths else get_macos_clipboard_files()
        if not sources:
            self.set_status("Zwischenablage leer", "warning")
            return
        success = 0
        last_name = ""
        for src in sources:
            if not os.path.exists(src):
                continue
            name = os.path.basename(src)
            dest = os.path.join(self.current_dir, name)
            if os.path.abspath(src) == os.path.abspath(dest):
                if self.clipboard_mode == "cut":
                    continue
                base, ext = os.path.splitext(name)
                c = 1
                while os.path.exists(dest):
                    dest = os.path.join(self.current_dir, f"{base} ({c}){ext}")
                    c += 1
            try:
                if self.clipboard_mode == "cut":
                    shutil.move(src, dest)
                else:
                    if os.path.isdir(src):
                        shutil.copytree(src, dest)
                    else:
                        shutil.copy2(src, dest)
                success += 1
                last_name = os.path.basename(dest)
            except Exception:
                pass
        self.clipboard_mode = None
        self.clipboard_paths = []
        self.refresh_items()
        if last_name:
            self.select_filename(last_name)
        self.set_status(f"{success} eingefügt", "success")

    def create_zip_archive(self):
        targets = list(self.selected_paths) if self.selected_paths else ([self.items[self.selected_idx].path] if self.items else [])
        if not targets:
            return
        base_name = os.path.basename(targets[0]) if len(targets) == 1 else f"Archiv_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}"
        if base_name.lower().endswith(".zip"):
            base_name = base_name[:-4]
        dest = os.path.join(self.current_dir, f"{base_name}.zip")
        c = 1
        while os.path.exists(dest):
            dest = os.path.join(self.current_dir, f"{base_name} ({c}).zip")
            c += 1
        try:
            with zipfile.ZipFile(dest, "w", zipfile.ZIP_DEFLATED) as zf:
                for t in targets:
                    if os.path.isdir(t):
                        for root, _, files in os.walk(t):
                            for f in files:
                                fp = os.path.join(root, f)
                                zf.write(fp, os.path.relpath(fp, self.current_dir))
                    else:
                        zf.write(t, os.path.basename(t))
            self.selected_paths.clear()
            self.refresh_items()
            self.select_filename(os.path.basename(dest))
            self.set_status(f"ZIP erstellt: {os.path.basename(dest)}", "success")
        except Exception as e:
            self.set_status(f"Fehler: {e}", "error")

    def toggle_sort(self):
        modes = ["mtime", "name", "size", "ext"]
        cur = self.config.get("sort_by", "mtime")
        nxt = modes[(modes.index(cur) + 1) % len(modes)] if cur in modes else "mtime"
        self.config["sort_by"] = nxt
        desc = {"mtime": "Datum", "name": "Name", "size": "Größe", "ext": "Dateityp"}
        self.refresh_items()
        self.set_status(f"Sortierung: {desc.get(nxt, nxt)}", "info")

    def get_short_dir(self, path: str) -> str:
        if path == HOME_DIR:
            return "~"
        if path.startswith(HOME_DIR + "/"):
            return "~" + path[len(HOME_DIR):]
        return path

    def load_file_preview_lines(self, path: str, max_lines: int) -> List[str]:
        """Lädt die ersten Zeilen einer Textdatei oder Metadaten für die Vorschau."""
        if self.cached_file_preview_path == path and self.cached_file_preview_lines:
            return self.cached_file_preview_lines[:max_lines]

        lines = []
        try:
            if zipfile.is_zipfile(path):
                with zipfile.ZipFile(path, "r") as zf:
                    infos = zf.infolist()
                    lines.append(f"{C_BOLD}Archiv-Inhalt ({len(infos)} Dateien):{C_RESET}")
                    for info in infos[:max_lines - 1]:
                        lines.append(f"  {info.filename} ({format_size(info.file_size)})")
            else:
                with open(path, "r", encoding="utf-8", errors="replace") as f:
                    for _ in range(max_lines):
                        line = f.readline()
                        if not line:
                            break
                        clean_line = line.rstrip("\r\n").replace("\t", "    ")
                        clean_line = re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]", "", clean_line)
                        lines.append(clean_line)
        except Exception:
            lines = [f"{C_GRAY}[Binäre Datei oder nicht lesbar]{C_RESET}"]

        self.cached_file_preview_path = path
        self.cached_file_preview_lines = lines
        return lines[:max_lines]

    def get_console_display_lines(self, width: int, height: int) -> List[str]:
        if height <= 0 or width <= 0:
            return []
        prompt = f"{self.get_short_dir(self.current_dir)} $ "
        if str_width(prompt) > width - 4:
            prompt = "$ "
        avail = max(1, width - str_width(prompt))
        inp = self.console_input
        inp_show = inp[-avail:] if len(inp) > avail else inp
        cursor_char = " " if not self.console_focused else f"{C_INVERT} {C_RESET}"
        prompt_line = pad_to_width(f"{prompt}{inp_show}{cursor_char}", width)
        out = []
        needed = height - 1
        if needed > 0:
            max_off = max(0, len(self.console_output_lines) - needed)
            self.console_scroll_offset = max(0, min(max_off, self.console_scroll_offset))
            start = max(0, len(self.console_output_lines) - needed - self.console_scroll_offset)
            chunk = self.console_output_lines[start: start + needed]
            for l in chunk:
                out.append(pad_to_width(truncate_to_width(l, width), width))
            while len(out) < needed:
                out.insert(0, " " * width)
        out.append(prompt_line)
        return out

    def run_console_command(self, cmd: str, fd: Optional[int], old_settings):
        cmd = cmd.strip()
        self.console_input = ""
        self.console_cursor_idx = 0
        if not cmd:
            return
        self.console_cmd_history.append(cmd)
        self.console_history_idx = len(self.console_cmd_history)
        self.console_output_lines.append(f"$ {cmd}")
        if cmd in ("exit", "quit"):
            self.show_console = False
            self.console_focused = False
            return
        if cmd == "clear":
            self.console_output_lines.clear()
            return
        if cmd.startswith("cd ") or cmd == "cd":
            target = cmd[3:].strip() if len(cmd) > 3 else HOME_DIR
            target = os.path.expanduser(target)
            target = os.path.join(self.current_dir, target)
            if os.path.isdir(target):
                self.change_directory(target)
            else:
                self.console_output_lines.append(f"cd: Verzeichnis nicht gefunden: {target}")
            return
        tokens = cmd.split()
        first_prog = os.path.basename(tokens[0]) if tokens else ""
        interactive_tools = {
            "start", "aider", "goose", "agy", "nano", "vim", "vi", "emacs",
            "top", "htop", "less", "more", "man", "python", "python3", "ipython",
            "node", "ruby", "perl", "bash", "zsh", "sh", "fish", "ssh", "fzf",
            "tmux", "screen", "cmatrix", "lazygit", "tig"
        }
        is_interactive = (first_prog in interactive_tools) or (cmd.startswith("git ") and any(sub in cmd for sub in ["log", "diff", "commit", "add -p", "rebase"]))
        if is_interactive and fd is not None and old_settings is not None:
            mouse_on = self.config.get("mouse_support", True)
            if mouse_on:
                sys.stdout.write("\033[?1006l\033[?1000l")
                sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            sys.stdout.write(SHOW_CURSOR + "\033[?1049l")
            sys.stdout.flush()
            try:
                subprocess.run(cmd, shell=True, cwd=self.current_dir)
            except Exception:
                pass
            finally:
                tty.setcbreak(fd, termios.TCSADRAIN)
                sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                if mouse_on:
                    sys.stdout.write("\033[?1000h\033[?1006h")
                sys.stdout.write("\033[2J\033[H")
                sys.stdout.flush()
                self.refresh_items()
            return
        try:
            res = subprocess.run(cmd, shell=True, cwd=self.current_dir, stdin=subprocess.DEVNULL, capture_output=True, timeout=10.0)
            out_text = res.stdout.decode("utf-8", errors="replace")
            err_text = res.stderr.decode("utf-8", errors="replace")
            if out_text:
                for l in out_text.splitlines():
                    clean_l = ANSI_ESCAPE_RE.sub("", l)
                    clean_l = re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]", "", clean_l)
                    self.console_output_lines.append(clean_l)
            if err_text:
                for l in err_text.splitlines():
                    clean_l = ANSI_ESCAPE_RE.sub("", l)
                    clean_l = re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]", "", clean_l)
                    self.console_output_lines.append(clean_l)
        except subprocess.TimeoutExpired:
            self.console_output_lines.append("[Befehl nach 10s abgebrochen]")
        except Exception as e:
            self.console_output_lines.append(f"Fehler: {e}")
        self.refresh_items()

    def toggle_console(self):
        self.show_console = not self.show_console
        self.console_focused = self.show_console
        self.set_status("Konsole geöffnet" if self.show_console else "Konsole geschlossen")

    def get_effective_columns(self, term_cols: int) -> int:
        if not self.config.get("columns_enabled", True):
            return 1
        if term_cols >= 70:
            return 3
        if term_cols >= 40:
            return 2
        return 1

    def build_screen(self, term_cols: int, term_rows: int) -> List[str]:
        """Baut den vollständigen Terminal-Bildschirm pixelgenau und flickerfrei auf."""
        disp_path = self.get_short_dir(self.current_dir)
        total_items = len(self.items)
        cur_idx_str = f"{self.selected_idx + 1}/{total_items}" if total_items > 0 else "0/0"
        
        # Status-Text & Level formatieren
        if self.status_message:
            lvl_color = C_BOLD_GREEN if self.status_level == "success" else (C_BOLD_RED if self.status_level == "error" else (C_YELLOW if self.status_level == "warning" else C_CYAN))
            msg_str = f" [{lvl_color}{self.status_message}{C_RESET}]"
        else:
            msg_str = ""

        right_header = f"{msg_str}  {C_BOLD_CYAN}{cur_idx_str}{C_RESET}".strip() if msg_str else f"{C_BOLD_CYAN}{cur_idx_str}{C_RESET}"
        right_header_plain = ANSI_ESCAPE_RE.sub("", right_header)

        # Header-Zeile zusammenstellen
        avail_for_path = max(1, term_cols - str_width(right_header_plain) - 2)
        path_styled = f"{C_BOLD_BLUE}{truncate_to_width(disp_path, avail_for_path)}{C_RESET}"
        pad_space = " " * max(1, term_cols - str_width(path_styled) - str_width(right_header_plain))
        header_line = f"{path_styled}{pad_space}{right_header}"
        header_line = pad_to_width(header_line, term_cols)

        if term_rows <= 1:
            return [header_line]

        cur_item = self.items[self.selected_idx] if (self.items and 0 <= self.selected_idx < total_items) else None

        show_controls = self.config.get("show_controls", False)
        # Bei aktivem Dialog oder Suche immer Footer-Leiste erzwingen
        has_dialog = bool(self.active_dialog)
        has_status_bar = (show_controls or has_dialog) and (term_rows >= 5)

        div_style = self.config.get("divider_style", "alle").lower()
        if div_style not in ("alle", "vertikal", "außen", "horizontal", "keine"):
            div_style = "alle"

        has_top_border = (div_style in ("alle", "vertikal", "außen", "horizontal")) and (term_rows >= 4)
        has_bottom_border = (div_style in ("alle", "vertikal", "außen", "horizontal")) and (term_rows >= 4)

        consumed = 1  # Header-Zeile
        if has_top_border:
            consumed += 1
        if has_bottom_border:
            consumed += 1
        if has_status_bar:
            consumed += 1

        avail_total = max(1, term_rows - consumed)
        header_lines_count = 1 + (1 if has_top_border else 0)

        active_console = self.show_console
        console_pos = self.config.get("console_position", "unten").lower()
        if console_pos not in ("unten", "rechts", "links"):
            console_pos = "unten"
        if active_console and console_pos in ("rechts", "links") and term_cols < 60:
            console_pos = "unten"

        if active_console and console_pos == "unten" and avail_total >= 4:
            console_h = max(2, min(8, avail_total // 3))
            fm_rows = avail_total - console_h - 1  # -1 für Trennzeile
        else:
            console_h = 0
            fm_rows = avail_total

        eff_cols = self.get_effective_columns(term_cols)

        # Breitenberechnung der Spalten
        if div_style in ("alle", "vertikal"):
            if eff_cols == 3:
                avail = max(10, term_cols - 4)
                w_left = max(6, int(avail * 0.22))
                w_right = max(10, int(avail * 0.33))
                w_mid = avail - w_left - w_right
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}┬{'─' * w_right}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}╯"
                mid_sep  = f"├{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}┤"
            elif eff_cols == 2:
                avail = max(8, term_cols - 3)
                w_left = max(6, int(avail * 0.30))
                w_right = 0
                w_mid = avail - w_left
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}╯"
                mid_sep  = f"├{'─' * w_left}┴{'─' * w_mid}┤"
            else:
                w_mid = max(4, term_cols - 2)
                w_left = 0
                w_right = 0
                top_line = f"╭{'─' * w_mid}╮"
                bot_line = f"╰{'─' * w_mid}╯"
                mid_sep  = f"├{'─' * w_mid}┤"
        elif div_style == "außen":
            inner_w = max(4, term_cols - 2)
            top_line = f"╭{'─' * inner_w}╮"
            bot_line = f"╰{'─' * inner_w}╯"
            mid_sep  = f"├{'─' * inner_w}┤"
            if eff_cols == 3:
                avail = max(10, inner_w - 4)
                w_left = max(6, int(avail * 0.22))
                w_right = max(10, int(avail * 0.33))
                w_mid = avail - w_left - w_right
            elif eff_cols == 2:
                avail = max(8, inner_w - 2)
                w_left = max(6, int(avail * 0.30))
                w_right = 0
                w_mid = avail - w_left
            else:
                w_mid = inner_w
                w_left = 0
                w_right = 0
        elif div_style == "horizontal":
            top_line = "─" * term_cols
            bot_line = "─" * term_cols
            mid_sep  = "─" * term_cols
            if eff_cols == 3:
                avail = max(10, term_cols - 4)
                w_left = max(6, int(avail * 0.22))
                w_right = max(10, int(avail * 0.33))
                w_mid = avail - w_left - w_right
            elif eff_cols == 2:
                avail = max(8, term_cols - 2)
                w_left = max(6, int(avail * 0.30))
                w_right = 0
                w_mid = avail - w_left
            else:
                w_mid = term_cols
                w_left = 0
                w_right = 0
        else:
            top_line = ""
            bot_line = ""
            mid_sep  = ""
            if eff_cols == 3:
                avail = max(10, term_cols - 4)
                w_left = max(6, int(avail * 0.22))
                w_right = max(10, int(avail * 0.33))
                w_mid = avail - w_left - w_right
            elif eff_cols == 2:
                avail = max(8, term_cols - 2)
                w_left = max(6, int(avail * 0.30))
                w_right = 0
                w_mid = avail - w_left
            else:
                w_mid = term_cols
                w_left = 0
                w_right = 0

        parent_items = []
        cur_p_idx = 0
        if eff_cols >= 2 and not (active_console and console_pos == "links"):
            parent_path = os.path.dirname(self.current_dir)
            if parent_path != self.current_dir:
                if self.cached_parent_dir == parent_path and self.cached_parent_items:
                    parent_items = self.cached_parent_items
                else:
                    parent_items = scan_directory(parent_path, show_hidden=self.config.get("show_hidden", False))
                    self.cached_parent_dir = parent_path
                    self.cached_parent_items = parent_items
                for i, pit in enumerate(parent_items):
                    if os.path.abspath(pit.path) == os.path.abspath(self.current_dir):
                        cur_p_idx = i
                        break

        p_start = 0 if len(parent_items) <= fm_rows else max(0, min(cur_p_idx - fm_rows // 2, len(parent_items) - fm_rows))
        m_start = 0 if total_items <= fm_rows else max(0, min(self.selected_idx - fm_rows // 2, total_items - fm_rows))

        child_items = []
        is_cur_dir = bool(cur_item and cur_item.is_dir)
        if eff_cols == 3 and cur_item and is_cur_dir and not (active_console and console_pos == "rechts"):
            if self.cached_child_path == cur_item.path and self.cached_child_items:
                child_items = self.cached_child_items
            else:
                child_items = scan_directory(cur_item.path, show_hidden=self.config.get("show_hidden", False))
                self.cached_child_path = cur_item.path
                self.cached_child_items = child_items

        preview_lines = []
        if eff_cols == 3 and cur_item and not is_cur_dir and not (active_console and console_pos == "rechts"):
            needed_p = max(1, fm_rows - 6)
            preview_lines = self.load_file_preview_lines(cur_item.path, needed_p)

        self.last_layout = {
            "header_lines": header_lines_count, "avail_rows": fm_rows, "eff_cols": eff_cols,
            "div_style": div_style, "w_left": w_left, "w_mid": w_mid, "w_right": w_right,
            "m_start": m_start, "p_start": p_start, "active_console": active_console,
            "console_pos": console_pos if active_console else None,
            "split_row": (header_lines_count + fm_rows) if (active_console and console_pos == "unten" and console_h > 0) else -1,
            "child_items": child_items, "cur_item": cur_item, "is_cur_dir": is_cur_dir,
        }

        c_right_lines = self.get_console_display_lines(w_right, fm_rows) if (active_console and console_pos == "rechts") else []
        c_left_lines = self.get_console_display_lines(w_left, fm_rows) if (active_console and console_pos == "links") else []

        file_lines = []
        for r in range(fm_rows):
            # 1. Linke Spalte (Übergeordnetes Verzeichnis oder Konsole links)
            if active_console and console_pos == "links":
                cell_left = c_left_lines[r] if r < len(c_left_lines) else " " * w_left
            elif eff_cols >= 2:
                p_idx = p_start + r
                if p_idx < len(parent_items):
                    p_it = parent_items[p_idx]
                    is_act = (os.path.abspath(p_it.path) == os.path.abspath(self.current_dir))
                    p_name = p_it.name + ("/" if p_it.is_dir else "")
                    prefix = "▸ " if is_act else "  "
                    p_trunc = truncate_to_width(p_name, max(2, w_left - 3))
                    if is_act:
                        txt_l = f" {C_BOLD_BLUE}{prefix}{p_trunc}{C_RESET}"
                    else:
                        txt_l = f" {C_GRAY}{prefix}{p_trunc}{C_RESET}"
                    cell_left = pad_to_width(txt_l, w_left)
                else:
                    cell_left = " " * w_left
            else:
                cell_left = ""

            # 2. Mittlere Spalte (Aktuelles Verzeichnis)
            m_idx = m_start + r
            if m_idx < len(self.items):
                it = self.items[m_idx]
                is_cur = (m_idx == self.selected_idx)
                is_sel = it.path in self.selected_paths
                in_cut = (self.clipboard_mode == "cut" and it.path in self.clipboard_paths)
                in_copy = (self.clipboard_mode == "copy" and it.path in self.clipboard_paths)

                c_char = f"{C_BOLD_BLUE}▸{C_RESET}" if is_cur else " "
                if in_cut:
                    b_char = f"{C_BOLD_RED}×{C_RESET}"
                elif in_copy:
                    b_char = f"{C_BOLD_GREEN}+{C_RESET}"
                elif is_sel:
                    b_char = f"{C_YELLOW}*{C_RESET}"
                else:
                    b_char = " "

                prefix_str = f" {c_char}{b_char} "
                prefix_len = 4
                s_str = format_size(it.size) if not it.is_dir else ""
                name_colored = get_file_colored_name(it)

                if w_mid >= 26:
                    avail_n = max(3, w_mid - prefix_len - 10)
                    n_trunc = truncate_to_width(it.name + ("/" if it.is_dir else ""), avail_n)
                    # Farbe auf n_trunc anwenden
                    it_fake = FileEntry(it.path, n_trunc)
                    it_fake.is_dir = it.is_dir
                    it_fake.is_symlink = it.is_symlink
                    it_fake.is_exec = it.is_exec
                    it_fake.ext = it.ext
                    n_styled = get_file_colored_name(it_fake)
                    s_part = f"  {C_GRAY}{s_str:>8}{C_RESET}" if s_str else " " * 10
                    l_part = f"{prefix_str}{n_styled}"
                    if is_cur:
                        l_part = f"{C_BOLD}{l_part}"
                    cell_mid = pad_to_width(l_part, w_mid - 10) + s_part
                else:
                    avail_n = max(2, w_mid - prefix_len)
                    n_trunc = truncate_to_width(it.name + ("/" if it.is_dir else ""), avail_n)
                    it_fake = FileEntry(it.path, n_trunc)
                    it_fake.is_dir = it.is_dir
                    it_fake.is_symlink = it.is_symlink
                    it_fake.is_exec = it.is_exec
                    it_fake.ext = it.ext
                    n_styled = get_file_colored_name(it_fake)
                    l_part = f"{prefix_str}{n_styled}"
                    if is_cur:
                        l_part = f"{C_BOLD}{l_part}"
                    cell_mid = pad_to_width(l_part, w_mid)
            elif len(self.items) == 0 and r == 0:
                cell_mid = pad_to_width(f"  {C_ITALIC}(leer){C_RESET}", w_mid)
            else:
                cell_mid = " " * w_mid

            # 3. Rechte Spalte (Vorschau / Unterordner oder Konsole rechts)
            if active_console and console_pos == "rechts":
                cell_right = c_right_lines[r] if r < len(c_right_lines) else " " * w_right
            elif eff_cols == 3:
                if cur_item and is_cur_dir:
                    if r < len(child_items):
                        c_it = child_items[r]
                        c_name = get_file_colored_name(c_it)
                        c_size = format_size(c_it.size) if not c_it.is_dir else ""
                        if w_right >= 22 and c_size:
                            avail_c = max(3, w_right - 2 - 10)
                            c_trunc = truncate_to_width(c_it.name + ("/" if c_it.is_dir else ""), avail_c)
                            c_it_fake = FileEntry(c_it.path, c_trunc)
                            c_it_fake.is_dir = c_it.is_dir
                            c_it_fake.is_symlink = c_it.is_symlink
                            c_it_fake.is_exec = c_it.is_exec
                            c_it_fake.ext = c_it.ext
                            c_styled = get_file_colored_name(c_it_fake)
                            cell_right = pad_to_width(f"  {c_styled}", w_right - 10) + f"  {C_GRAY}{c_size:>8}{C_RESET}"
                        else:
                            avail_c = max(3, w_right - 3)
                            c_trunc = truncate_to_width(c_it.name + ("/" if c_it.is_dir else ""), avail_c)
                            c_it_fake = FileEntry(c_it.path, c_trunc)
                            c_it_fake.is_dir = c_it.is_dir
                            c_it_fake.is_symlink = c_it.is_symlink
                            c_it_fake.is_exec = c_it.is_exec
                            c_it_fake.ext = c_it.ext
                            c_styled = get_file_colored_name(c_it_fake)
                            cell_right = pad_to_width(f"  {c_styled}", w_right)
                    elif len(child_items) == 0 and r == 0:
                        cell_right = pad_to_width(f"  {C_ITALIC}(leer){C_RESET}", w_right)
                    else:
                        cell_right = " " * w_right
                elif cur_item and not is_cur_dir:
                    # Details & Dateivorschau
                    card = [
                        f" {C_BOLD_BLUE}Details{C_RESET}",
                        f" {C_BOLD}Typ:{C_RESET}    {truncate_to_width(get_file_type_desc(cur_item), max(3, w_right - 9))}",
                        f" {C_BOLD}Größe:{C_RESET}  {format_size(cur_item.size)}",
                        f" {C_BOLD}Datum:{C_RESET}  {format_mtime(cur_item.mtime)}",
                        f" {C_BOLD}Rechte:{C_RESET} {C_GRAY}{cur_item.mode_str}{C_RESET}",
                    ]
                    if cur_item.is_symlink:
                        card.append(f" {C_BOLD}Ziel:{C_RESET}   {C_CYAN}{truncate_to_width(cur_item.symlink_target, max(3, w_right - 9))}{C_RESET}")

                    if r < len(card):
                        cell_right = pad_to_width(card[r], w_right)
                    elif r == len(card) and fm_rows >= 10:
                        cell_right = pad_to_width(f" {C_BLUE}{'─' * max(2, w_right - 2)}{C_RESET}", w_right)
                    elif r == len(card) + 1 and fm_rows >= 10:
                        cell_right = pad_to_width(f" {C_BOLD_CYAN}Vorschau{C_RESET}", w_right)
                    else:
                        p_line_idx = r - (len(card) + 2) if fm_rows >= 10 else -1
                        if 0 <= p_line_idx < len(preview_lines):
                            p_txt = preview_lines[p_line_idx]
                            cell_right = pad_to_width(f" {C_GRAY}{truncate_to_width(p_txt, max(2, w_right - 2))}{C_RESET}", w_right)
                        else:
                            cell_right = " " * w_right
                else:
                    cell_right = " " * w_right
            else:
                cell_right = ""

            # Rahmen um Zeile anlegen
            b_c = C_BLUE
            if div_style in ("alle", "vertikal"):
                if eff_cols == 3:
                    row_line = f"{b_c}│{C_RESET}{cell_left}{b_c}│{C_RESET}{cell_mid}{b_c}│{C_RESET}{cell_right}{b_c}│{C_RESET}"
                elif eff_cols == 2:
                    row_line = f"{b_c}│{C_RESET}{cell_left}{b_c}│{C_RESET}{cell_mid}{b_c}│{C_RESET}"
                else:
                    row_line = f"{b_c}│{C_RESET}{cell_mid}{b_c}│{C_RESET}"
            elif div_style == "außen":
                if eff_cols == 3:
                    row_line = f"{b_c}│{C_RESET}{cell_left}  {cell_mid}  {cell_right}{b_c}│{C_RESET}"
                elif eff_cols == 2:
                    row_line = f"{b_c}│{C_RESET}{cell_left}  {cell_mid}{b_c}│{C_RESET}"
                else:
                    row_line = f"{b_c}│{C_RESET}{cell_mid}{b_c}│{C_RESET}"
            else:
                if eff_cols == 3:
                    row_line = f"{cell_left}  {cell_mid}  {cell_right}"
                elif eff_cols == 2:
                    row_line = f"{cell_left}  {cell_mid}"
                else:
                    row_line = f"{cell_mid}"

            file_lines.append(pad_to_width(row_line, term_cols))

        all_lines = [header_line]
        if has_top_border and top_line:
            all_lines.append(pad_to_width(f"{C_BLUE}{top_line}{C_RESET}", term_cols))
        all_lines.extend(file_lines)

        # Konsole unten einbetten
        if active_console and console_pos == "unten" and console_h > 0:
            all_lines.append(pad_to_width(f"{C_BLUE}{mid_sep}{C_RESET}", term_cols))
            inner_cw = max(4, term_cols - 2 if div_style in ("alle", "vertikal", "außen") else term_cols)
            c_lines = self.get_console_display_lines(inner_cw, console_h)
            for cl in c_lines:
                if div_style in ("alle", "vertikal", "außen"):
                    all_lines.append(f"{C_BLUE}│{C_RESET}{cl}{C_BLUE}│{C_RESET}")
                else:
                    all_lines.append(pad_to_width(cl, term_cols))
            if has_bottom_border:
                c_bot = f"╰{'─' * (term_cols - 2)}╯" if div_style in ("alle", "vertikal", "außen") else ("─" * term_cols if div_style == "horizontal" else "")
                if c_bot:
                    all_lines.append(pad_to_width(f"{C_BLUE}{c_bot}{C_RESET}", term_cols))
        elif has_bottom_border and bot_line:
            all_lines.append(pad_to_width(f"{C_BLUE}{bot_line}{C_RESET}", term_cols))

        # Status- & Dialog-Leiste unten rendern
        if has_status_bar:
            if self.active_dialog:
                # Interaktiver Dialog
                if self.active_dialog == "rename":
                    prompt_lbl = f"{C_BOLD_YELLOW}[UMBENENNEN]{C_RESET} Name: "
                    inp_txt = self.dialog_input
                    c_pos = self.dialog_cursor
                    disp_inp = inp_txt[:c_pos] + f"{C_INVERT}{inp_txt[c_pos] if c_pos < len(inp_txt) else ' '}{C_RESET}" + inp_txt[c_pos+1:]
                    st_line = pad_to_width(f" {prompt_lbl}{disp_inp}  {C_GRAY}[Enter] OK  [ESC] Abbruch{C_RESET}", term_cols)
                elif self.active_dialog == "new":
                    prompt_lbl = f"{C_BOLD_GREEN}[NEU ERSTELLEN]{C_RESET} Name (Ordner mit / am Ende): "
                    inp_txt = self.dialog_input
                    c_pos = self.dialog_cursor
                    disp_inp = inp_txt[:c_pos] + f"{C_INVERT}{inp_txt[c_pos] if c_pos < len(inp_txt) else ' '}{C_RESET}" + inp_txt[c_pos+1:]
                    st_line = pad_to_width(f" {prompt_lbl}{disp_inp}  {C_GRAY}[Enter] Erstellen  [ESC] Abbruch{C_RESET}", term_cols)
                elif self.active_dialog == "search":
                    prompt_lbl = f"{C_BOLD_CYAN}[FILTER / SUCHE]{C_RESET} Suchbegriff: "
