    def open_config_menu(self):
        """Öffnet das interaktive Konfigurationsmenü und stellt sicher, dass alle Einstellungen sofort wirksam werden."""
        fd = sys.stdin.fileno() if sys.stdin.isatty() else None

        mouse_on = self.config.get("mouse_support", True)
        if mouse_on:
            sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.flush()
        sys.stdout.write(SHOW_CURSOR)
        sys.stdout.flush()

        self.config = run_konfigurator(standalone=False)

        # 1. Terminal sofort wieder in den cbreak-Modus versetzen
        if fd is not None:
            tty.setcbreak(fd, termios.TCSADRAIN)

        # 2. Mausmodus sofort an neue Konfiguration anpassen
        if self.config.get("mouse_support", True):
            sys.stdout.write("\033[?1000h\033[?1006h")
        else:
            sys.stdout.write("\033[?1006l\033[?1000l")

        # 3. Konsolenstatus und Position synchronisieren
        self.show_console = self.config.get("show_console", False)
        self.console_position = self.config.get("console_position", "unten").lower()
        if self.console_position not in ("unten", "rechts", "links"):
            self.console_position = "unten"
        if not self.show_console:
            self.console_focused = False

        # 4. Sämtliche Verzeichnis-Caches leeren (Sortierung, versteckte Dateien etc. greifen sofort)
        self.cached_parent_dir = None
        self.cached_parent_items = []
        self.cached_parent_mtime = -1.0
        self.cached_child_path = None
        self.cached_child_items = []
        self.cached_child_mtime = -1.0

        # 5. Cursor wieder verstecken & Bildschirm sauber leeren
        sys.stdout.write(HIDE_CURSOR)
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        # 6. Dateiliste sofort neu einlesen
        self.refresh_items()

        # 7. Visuelle Rückmeldung setzen
        self.status_message = "✓ Konfiguration übernommen."
        self.status_expiry_moves = 3

    def get_effective_columns(self, term_cols: int) -> int:
        """Ermittelt die Spaltenanzahl (1, 2 oder 3) basierend auf Spaltendarstellung und Fensterbreite."""
        if not self.config.get("columns_enabled", True):
            return 1
        if term_cols >= 68:
            return 3
        elif term_cols >= 38:
            return 2
        else:
            return 1

    def build_screen(self, term_cols: int, term_rows: int) -> List[str]:
        """Erstellt alle Zeilen der Anzeige dynamisch angepasst an jede Fenstergröße."""
        # 1. Pfad und Zähler oben formatieren (Pfad ganz links, Zähler z. B. 2/33 ganz rechts)
        home_dir = os.path.expanduser("~")
        disp_path = self.current_dir
        if disp_path.startswith(home_dir):
            disp_path = "~" + disp_path[len(home_dir):]

        total_items = len(self.items)
        cur_item = self.items[self.selected_idx] if (self.items and 0 <= self.selected_idx < total_items) else None
        cur_name = (cur_item.name + ("/" if cur_item.is_dir else "")) if cur_item else ""

        cur_idx_str = f"{self.selected_idx + 1}/{total_items}" if total_items > 0 else "0/0"
        if term_cols > visible_len(cur_idx_str) + 3:
            avail_p = term_cols - visible_len(cur_idx_str) - 1
            path_trunc = truncate_end(disp_path, avail_p)
            path_line = pad_visible(path_trunc, term_cols - visible_len(cur_idx_str)) + cur_idx_str
        else:
            path_line = pad_visible(truncate_end(disp_path, term_cols), term_cols)

        # Sonderfälle bei winziger Fensterhöhe
        if term_rows <= 1:
            return [path_line]
        if term_rows == 2:
            return [
                path_line,
                pad_visible(truncate_end(cur_name, term_cols), term_cols),
            ]

        # 2. Statuszeile unten ("Entweder Steuerung oder nix")
        show_controls = self.config.get("show_controls", True)
        has_status_bar = show_controls
        status_line = ""

        if has_status_bar:
            if self.show_console and self.console_focused:
                mode_lbl = "TERM"
            elif self.selected_paths:
                count = len(self.selected_paths)
                mode_lbl = f"SEL {count}"
            elif self.clipboard_mode == "cut":
                count = len(self.clipboard_paths)
                mode_lbl = f"CUT {count}" if count > 1 else "CUT"
            elif self.clipboard_mode == "copy":
                count = len(self.clipboard_paths)
                mode_lbl = f"CPY {count}" if count > 1 else "CPY"
            else:
                mode_lbl = "NOR"

            if self.status_message:
                status_line = pad_visible(f" {BOLD}{mode_lbl}{RESET}  {self.status_message}", term_cols)
            elif show_controls:
                left_badge = f" {BOLD}{mode_lbl}{RESET}  "
                avail_ctrl = max(0, term_cols - visible_len(left_badge))

                if self.show_console and self.console_focused:
                    ctrl_tiers = [
                        "[Enter] Ausführen  [Tab] Dateien  [↑↓] Verlauf  [ESC] Zu Dateien  [exit] Schließen",
                        "[Enter] Ausführen  [Tab/ESC] Dateien  [↑↓] Verlauf  [exit] Ende",
                        "[Enter] Run  [Tab] Dateien  [exit] Ende",
                        "[Enter] Run  [Tab] Dateien",
                    ]
                elif self.clipboard_mode in ("cut", "copy"):
                    ctrl_tiers = [
                        "[↑↓] Bewegen  [p] Einfügen  [Y/X/ESC] Abbrechen  [Enter] open  [c z] Zip  [t] Konsole  [m] Menü  [q] Beenden",
                        "[↑↓] Bewegen  [p] Einfügen  [ESC] Abbrechen  [Enter] open  [c z] Zip  [t] Konsole  [m] Menü  [q] Ende",
                        "[↑↓] Nav  [p] Einfügen  [ESC] Abbrechen  [Enter] open  [c z] Zip  [t] Konsole  [q] Ende",
                        "[p] Einfügen  [ESC] Abbr  [c z] Zip  [t] Konsole  [q]",
                    ]
                elif self.selected_paths:
                    ctrl_tiers = [
                        "[↑↓] Bewegen  [y] Kopieren  [x] Ausschneiden  [c z] Zip  [d] Papierkorb  [t] Konsole  [ESC] Abwählen  [q] Beenden",
                        "[↑↓] Bewegen  [y] Kopieren  [x] Cut  [c z] Zip  [d] Löschen  [t] Konsole  [ESC] Abwählen  [q] Ende",
                        "[↑↓] Nav  [y] Copy  [x] Cut  [c z] Zip  [d] Löschen  [t] Konsole  [ESC] Abw  [q]",
                        "[y] Copy  [x] Cut  [c z] Zip  [t] Konsole  [q]",
                    ]
                elif self.show_console:
                    ctrl_tiers = [
                        "[↑↓] Bewegen  [Enter] open  [Tab] Konsole fokussieren  [t] Konsole schließen  [m] Menü  [q] Beenden",
                        "[↑↓] Bewegen  [Enter] open  [Tab] Konsole  [t] Konsole zu  [m] Menü  [q] Ende",
                        "[↑↓] Nav  [Enter] open  [Tab] Konsole  [t] Zu  [q] Ende",
                        "[Tab] Konsole  [t] Zu  [q]",
                    ]
                else:
                    ctrl_tiers = [
                        "[↑↓] Bewegen  [→] Ordner (Doppel-→ nano)  [←] Zurück  [Enter] open  [y] Copy  [x] Cut  [c z] Zip  [t] Konsole  [m] Menü  [q] Beenden",
                        "[↑↓] Bewegen  [→] Ordner/nano  [←] Zurück  [Enter] open  [y] Copy  [x] Cut  [c z] Zip  [t] Konsole  [m] Menü  [q] Ende",
                        "[↑↓] Bewegen  [→] Ordner/nano  [←] Zurück  [Enter] open  [y] Copy  [x] Cut  [t] Konsole  [m] Menü  [q] Ende",
                        "[↑↓] Nav  [→] Rein/nano  [←] Zurück  [Enter] open  [y] Copy  [x] Cut  [t] Konsole  [q] Ende",
                        "[↑↓] Nav  [→] Ordner/nano  [Enter] open  [y] Copy  [t] Konsole  [q] Ende",
                        "[↑↓] Nav  [→] In  [Enter] open  [t] Konsole  [q] Ende",
                        "[↑↓] Nav  [Enter] open  [t] Konsole  [q]",
                    ]

                ctrl_str = ""
                for tier in ctrl_tiers:
                    if len(tier) <= avail_ctrl:
                        ctrl_str = tier
                        break
                if not ctrl_str:
                    ctrl_str = truncate_end(ctrl_tiers[-1], avail_ctrl)

                status_line = pad_visible(f"{left_badge}{ctrl_str}", term_cols)

        # 3. Trennungslinien & Kasten-Konfiguration
        div_style = self.config.get("divider_style", "vertikal").lower()
        if div_style not in ("alle", "vertikal", "horizontal", "außen", "keine"):
            div_style = "vertikal"

        has_top_border = (div_style in ("vertikal", "horizontal", "außen")) and (term_rows >= 4)
        has_bottom_border = (div_style in ("vertikal", "horizontal", "außen")) and (term_rows >= 4)

        # Zeilenbudget berechnen
        consumed = 1  # path_line
        if has_top_border:
            consumed += 1
        if has_bottom_border:
            consumed += 1
        has_status_bar = show_controls and (term_rows >= consumed + 2)
        if has_status_bar:
            consumed += 1

        avail_total = max(0, term_rows - consumed)
        header_lines = 1 + (1 if has_top_border else 0)

        active_console = self.show_console
        console_pos = self.config.get("console_position", self.console_position).lower()
        if console_pos not in ("unten", "rechts", "links"):
            console_pos = "unten"
        if active_console and console_pos in ("rechts", "links") and term_cols < 60:
            console_pos = "unten"

        if active_console and console_pos == "unten" and avail_total >= 3:
            console_h = max(1, min(8, avail_total // 3))
            fm_rows = avail_total - console_h - 1
        else:
            console_h = 0
            fm_rows = avail_total

        avail_rows = fm_rows

        # Spaltenanzahl und Breiten
        eff_cols = self.get_effective_columns(term_cols)

        top_line = ""
        bot_line = ""

        if active_console and console_pos == "rechts":
            if term_cols >= 90:
                eff_cols = 3
                avail = max(10, term_cols - 4 if div_style == "vertikal" else (term_cols - 2 if div_style == "außen" else term_cols - 4))
                w_left = max(6, int(avail * 0.16))
                w_mid = max(20, int(avail * 0.38))
                w_right = avail - w_left - w_mid
            else:
                eff_cols = 2
                avail = max(8, term_cols - 3 if div_style == "vertikal" else (term_cols - 2 if div_style == "außen" else term_cols - 2))
                w_left = 0
                w_mid = max(20, int(avail * 0.45))
                w_right = avail - w_mid

            if div_style == "vertikal":
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}┬{'─' * w_right}╮" if eff_cols == 3 else f"╭{'─' * w_mid}┬{'─' * w_right}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}╯" if eff_cols == 3 else f"╰{'─' * w_mid}┴{'─' * w_right}╯"
            elif div_style == "außen":
                inner_w = max(4, term_cols - 2)
                top_line = f"╭{'─' * inner_w}╮"
                bot_line = f"╰{'─' * inner_w}╯"
            elif div_style == "horizontal":
                top_line = "─" * term_cols
                bot_line = "─" * term_cols

        elif active_console and console_pos == "links":
            if term_cols >= 90:
                eff_cols = 3
                avail = max(10, term_cols - 4 if div_style == "vertikal" else (term_cols - 2 if div_style == "außen" else term_cols - 4))
                w_left = max(20, int(avail * 0.42))
                w_mid = max(20, int(avail * 0.36))
                w_right = avail - w_left - w_mid
            else:
                eff_cols = 2
                avail = max(8, term_cols - 3 if div_style == "vertikal" else (term_cols - 2 if div_style == "außen" else term_cols - 2))
                w_left = max(20, int(avail * 0.48))
                w_mid = avail - w_left
                w_right = 0

            if div_style == "vertikal":
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}┬{'─' * w_right}╮" if eff_cols == 3 else f"╭{'─' * w_left}┬{'─' * w_mid}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}╯" if eff_cols == 3 else f"╰{'─' * w_left}┴{'─' * w_mid}╯"
            elif div_style == "außen":
                inner_w = max(4, term_cols - 2)
                top_line = f"╭{'─' * inner_w}╮"
                bot_line = f"╰{'─' * inner_w}╯"
            elif div_style == "horizontal":
                top_line = "─" * term_cols
                bot_line = "─" * term_cols

        else:
            if div_style == "vertikal":
                if eff_cols == 3:
                    avail = max(10, term_cols - 4)
                    w_left = max(6, int(avail * 0.16))
                    w_right = max(10, int(avail * 0.28))
                    w_mid = avail - w_left - w_right
                    if w_mid < 12:
                        w_left = max(4, w_left - (12 - w_mid) // 2)
                        w_right = max(6, w_right - (12 - w_mid) // 2)
                        w_mid = avail - w_left - w_right

                    top_line = f"╭{'─' * w_left}┬{'─' * w_mid}┬{'─' * w_right}╮"
                    bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}╯"

                elif eff_cols == 2:
                    avail = max(8, term_cols - 3)
                    w_left = max(6, int(avail * 0.25))
                    w_mid = avail - w_left
                    w_right = 0

                    top_line = f"╭{'─' * w_left}┬{'─' * w_mid}╮"
                    bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}╯"

                else:  # 1 Spalte
                    w_left = 0
                    w_right = 0
                    w_mid = max(4, term_cols - 2)
                    top_line = f"╭{'─' * w_mid}╮"
                    bot_line = f"╰{'─' * w_mid}╯"

            elif div_style == "außen":
                inner_w = max(4, term_cols - 2)
                top_line = f"╭{'─' * inner_w}╮"
                bot_line = f"╰{'─' * inner_w}╯"

                if eff_cols == 3:
                    avail = max(10, inner_w - 4)
                    w_left = max(6, int(avail * 0.16))
                    w_right = max(10, int(avail * 0.28))
                    w_mid = avail - w_left - w_right
                    if w_mid < 12:
                        w_left = max(4, w_left - (12 - w_mid) // 2)
                        w_right = max(6, w_right - (12 - w_mid) // 2)
                        w_mid = avail - w_left - w_right
                elif eff_cols == 2:
                    avail = max(8, inner_w - 2)
                    w_left = max(6, int(avail * 0.25))
                    w_mid = avail - w_left
                    w_right = 0
                else:  # 1 Spalte
                    w_left = 0
                    w_right = 0
                    w_mid = inner_w

            elif div_style == "horizontal":
                top_line = "─" * term_cols
                bot_line = "─" * term_cols

                if eff_cols == 3:
                    avail = max(10, term_cols - 4)
                    w_left = max(6, int(avail * 0.16))
                    w_right = max(10, int(avail * 0.28))
                    w_mid = avail - w_left - w_right
                    if w_mid < 12:
                        w_left = max(4, w_left - (12 - w_mid) // 2)
                        w_right = max(6, w_right - (12 - w_mid) // 2)
                        w_mid = avail - w_left - w_right
                elif eff_cols == 2:
                    avail = max(8, term_cols - 2)
                    w_left = max(6, int(avail * 0.25))
                    w_mid = avail - w_left
                    w_right = 0
                else:
                    w_left = 0
                    w_right = 0
                    w_mid = term_cols

            else:  # div_style == "keine"
                top_line = ""
                bot_line = ""

                if eff_cols == 3:
                    avail = max(10, term_cols - 4)
                    w_left = max(6, int(avail * 0.16))
                    w_right = max(10, int(avail * 0.28))
                    w_mid = avail - w_left - w_right
                    if w_mid < 12:
                        w_left = max(4, w_left - (12 - w_mid) // 2)
                        w_right = max(6, w_right - (12 - w_mid) // 2)
                        w_mid = avail - w_left - w_right
                elif eff_cols == 2:
                    avail = max(8, term_cols - 2)
                    w_left = max(6, int(avail * 0.25))
                    w_mid = avail - w_left
                    w_right = 0
                else:
                    w_left = 0
                    w_right = 0
                    w_mid = term_cols

        if active_console and console_pos == "unten" and console_h > 0:
            if div_style in ("vertikal", "außen"):
                bot_line = f"╰{'─' * (term_cols - 2)}╯"
            elif div_style == "horizontal":
                bot_line = "─" * term_cols
            else:
                bot_line = ""

        # Daten für Elternverzeichnis (Spalte 1)
        parent_items: List[FileEntry] = []
        cur_p_idx = 0
        if eff_cols >= 2 and not (active_console and console_pos == "links"):
            parent_path = os.path.dirname(self.current_dir)
            if parent_path != self.current_dir:
                try:
                    p_mtime = os.path.getmtime(parent_path)
                except Exception:
                    p_mtime = 0.0
                if self.cached_parent_dir == parent_path and self.cached_parent_mtime == p_mtime:
                    parent_items = self.cached_parent_items
                else:
                    parent_items = scan_directory(
                        parent_path,
                        show_hidden=self.config.get("show_hidden", False),
                        sort_by=self.config.get("sort_by", "mtime"),
                        sort_reverse=self.config.get("sort_reverse", True),
                        sort_dir_first=self.config.get("sort_dir_first", True),
                    )
                    self.cached_parent_dir = parent_path
                    self.cached_parent_items = parent_items
                    self.cached_parent_mtime = p_mtime

                for i, p_it in enumerate(parent_items):
                    if os.path.abspath(p_it.path) == os.path.abspath(self.current_dir):
                        cur_p_idx = i
                        break

        if len(parent_items) <= avail_rows:
            p_start = 0
        else:
            p_half = avail_rows // 2
            p_start = max(0, min(cur_p_idx - p_half, len(parent_items) - avail_rows))

        # Daten für aktuellen Ordner (Spalte 2)
        if total_items <= avail_rows:
            m_start = 0
        else:
            m_half = avail_rows // 2
            m_start = max(0, min(self.selected_idx - m_half, total_items - avail_rows))

        # Daten für Kindverzeichnis (Spalte 3)
        child_items: List[FileEntry] = []
        is_cur_dir = bool(cur_item and cur_item.is_dir)
        if eff_cols == 3 and cur_item and is_cur_dir and not (active_console and console_pos == "rechts"):
            try:
                c_mtime = os.path.getmtime(cur_item.path)
            except Exception:
                c_mtime = 0.0
            if self.cached_child_path == cur_item.path and self.cached_child_mtime == c_mtime:
                child_items = self.cached_child_items
            else:
                child_items = scan_directory(
                    cur_item.path,
                    show_hidden=self.config.get("show_hidden", False),
                    sort_by=self.config.get("sort_by", "mtime"),
                    sort_reverse=self.config.get("sort_reverse", True),
                    sort_dir_first=self.config.get("sort_dir_first", True),
                )
                self.cached_child_path = cur_item.path
                self.cached_child_items = child_items
                self.cached_child_mtime = c_mtime

        # Layout-Metriken für Mausklick-Erkennung sichern
        self.last_layout = {
            "header_lines": header_lines,
            "avail_rows": avail_rows,
            "fm_rows": fm_rows,
            "active_console": active_console,
            "console_pos": console_pos if active_console else None,
            "split_row": (header_lines + fm_rows) if (active_console and console_pos == "unten" and console_h > 0) else -1,
            "eff_cols": eff_cols,
            "div_style": div_style,
            "w_left": w_left,
            "w_mid": w_mid,
            "w_right": w_right,
            "m_start": m_start,
            "p_start": p_start,
            "child_items": child_items,
            "cur_item": cur_item,
            "is_cur_dir": is_cur_dir,
            "show_status": has_status_bar,
        }

        # Vorab-Berechnung für seitliche Konsole (rechts oder links)
        if active_console and console_pos == "rechts":
            c_right_lines = self.get_console_display_lines(w_right, avail_rows)
        else:
            c_right_lines = []

        if active_console and console_pos == "links":
            c_left_lines = self.get_console_display_lines(w_left, avail_rows)
        else:
            c_left_lines = []

        # Zeilen rendern
        file_lines: List[str] = []
        for r in range(avail_rows):
            # 1. Zelle links (Eltern oder Konsole)
            if active_console and console_pos == "links":
                cell_left = c_left_lines[r]
            elif eff_cols >= 2:
                p_idx = p_start + r
                if p_idx < len(parent_items):
                    p_it = parent_items[p_idx]
                    is_act = (os.path.abspath(p_it.path) == os.path.abspath(self.current_dir))
                    p_name = p_it.name + ("/" if p_it.is_dir else "")
                    prefix = "▸ " if is_act else "  "
                    p_trunc = truncate_end(p_name, max(2, w_left - len(prefix) - 1))
                    if is_act:
                        txt_left = f" {BOLD}{prefix}{p_trunc}{RESET}"
                    else:
                        txt_left = f" {prefix}{p_trunc}"
                    cell_left = pad_visible(txt_left, w_left)
                else:
                    cell_left = " " * w_left
            else:
                cell_left = ""

            # 2. Zelle mitte (Aktueller Ordner)
            m_idx = m_start + r
            if m_idx < total_items:
                item = self.items[m_idx]
                is_cursor = (m_idx == self.selected_idx)
                is_sel = item.path in self.selected_paths
                in_cut = (self.clipboard_mode == "cut" and item.path in self.clipboard_paths)
                in_copy = (self.clipboard_mode == "copy" and item.path in self.clipboard_paths)

                # Badges: * für Auswahl, × für Cut, + für Copy
                if in_cut:
                    badge = "× "
                elif in_copy:
                    badge = "+ "
                elif is_sel:
                    badge = "* "
                else:
                    badge = "  "

                if w_mid < 15:
                    cur_c = "▸" if is_cursor else ("×" if in_cut else ("+" if in_copy else ("*" if is_sel else " ")))
                    prefix_str = f" {cur_c}"
                    prefix_len = 2
                elif w_mid < 25:
                    cur_c = "▸" if is_cursor else " "
                    bad_c = "×" if in_cut else ("+" if in_copy else ("*" if is_sel else " "))
                    prefix_str = f" {cur_c}{bad_c}"
                    prefix_len = 3
                else:
                    cur_prefix = "▸ " if is_cursor else "  "
                    prefix_str = f" {cur_prefix}{badge}"
                    prefix_len = 5

                name_display = item.name + ("/" if item.is_dir else "")
                size_str = format_size(item.size) if not item.is_dir else ""

                if w_mid >= 28:
                    avail_name = max(3, w_mid - prefix_len - 10)
                    name_trunc = truncate_end(name_display, avail_name)
                    size_part = f"  {size_str:>8}" if size_str else " " * 10
                    if is_cursor:
                        left_part = f"{BOLD}{prefix_str}{name_trunc}{RESET}"
                    else:
                        left_part = f"{prefix_str}{name_trunc}"
                    cell_mid = pad_visible(left_part, w_mid - 10) + size_part
                else:
                    avail_name = max(3, w_mid - prefix_len - 1)
                    name_trunc = truncate_end(name_display, avail_name)
                    if is_cursor:
                        cell_mid = pad_visible(f"{BOLD}{prefix_str}{name_trunc}{RESET}", w_mid)
                    else:
                        cell_mid = pad_visible(f"{prefix_str}{name_trunc}", w_mid)
            else:
                if total_items == 0 and r == 0:
                    cell_mid = pad_visible(f"  {ITALIC}(Ordner ist leer){RESET}", w_mid)
                else:
                    cell_mid = " " * w_mid

            # 3. Zelle rechts (Kindverzeichnis, Datei-Details oder Konsole)
            if active_console and console_pos == "rechts":
                cell_right = c_right_lines[r]
            elif eff_cols == 3:
                if cur_item:
                    if is_cur_dir:
                        if r < len(child_items):
                            c_it = child_items[r]
                            c_name = c_it.name + ("/" if c_it.is_dir else "")
                            c_size = format_size(c_it.size) if not c_it.is_dir else ""
                            if w_right >= 22 and c_size:
                                avail_c = max(3, w_right - 2 - 10)
                                c_trunc = truncate_end(c_name, avail_c)
                                cell_right = pad_visible(f"  {c_trunc}", w_right - 10) + f"  {c_size:>8}"
                            else:
                                avail_c = max(3, w_right - 3)
                                c_trunc = truncate_end(c_name, avail_c)
                                cell_right = pad_visible(f"  {c_trunc}", w_right)
                        elif len(child_items) == 0 and r == 0:
                            cell_right = pad_visible(f"  {ITALIC}(leer){RESET}", w_right)
                        else:
                            cell_right = " " * w_right
                    else:
                        card = [
                            f" {BOLD}Details{RESET}",
                            f" Name:   {truncate_end(cur_item.name, max(3, w_right - 10))}",
                            f" Typ:    {truncate_end(get_file_type_desc(cur_item), max(3, w_right - 10))}",
                            f" Größe:  {format_size(cur_item.size)}",
                            f" Datum:  {format_mtime(cur_item.mtime)}",
                            f" Rechte: {cur_item.mode_str}",
                            f" nano:   Doppel-→",
                            f" Enter:  Öffnen (open)",
                        ]
                        if div_style != "keine":
                            card.insert(1, f" {get_divider('─', max(1, w_right - 3))}")
                        if r < len(card):
                            cell_right = pad_visible(card[r], w_right)
                        else:
                            cell_right = " " * w_right
                else:
                    cell_right = " " * w_right
            else:
                cell_right = ""

            # Zeile zusammensetzen je nach Trennungslinien-Stil
            if div_style == "vertikal":
                if eff_cols == 1:
                    row_line = f"│{cell_mid}│"
                elif eff_cols == 2:
                    if active_console and console_pos == "rechts":
                        row_line = f"│{cell_mid}│{cell_right}│"
                    else:
                        row_line = f"│{cell_left}│{cell_mid}│"
                else:
                    row_line = f"│{cell_left}│{cell_mid}│{cell_right}│"
            elif div_style == "außen":
                if eff_cols == 1:
                    row_line = f"│{cell_mid}│"
                elif eff_cols == 2:
                    if active_console and console_pos == "rechts":
                        row_line = f"│{cell_mid}  {cell_right}│"
                    else:
                        row_line = f"│{cell_left}  {cell_mid}│"
                else:
                    row_line = f"│{cell_left}  {cell_mid}  {cell_right}│"
            elif div_style == "horizontal":
                if eff_cols == 1:
                    row_line = f" {cell_mid} "
                elif eff_cols == 2:
                    if active_console and console_pos == "rechts":
                        row_line = f"{cell_mid}  {cell_right}"
                    else:
                        row_line = f"{cell_left}  {cell_mid}"
                else:
                    row_line = f"{cell_left}  {cell_mid}  {cell_right}"
            else:  # keine
                if eff_cols == 1:
                    row_line = cell_mid
                elif eff_cols == 2:
                    if active_console and console_pos == "rechts":
                        row_line = f"{cell_mid}  {cell_right}"
                    else:
                        row_line = f"{cell_left}  {cell_mid}"
                else:
                    row_line = f"{cell_left}  {cell_mid}  {cell_right}"

            row_line = pad_visible(row_line, term_cols)
            file_lines.append(row_line)

        # 8. Vollständigen Bildschirm zusammensetzen
        all_lines = [path_line]
        if has_top_border and top_line:
            all_lines.append(top_line)
        all_lines.extend(file_lines)

        # Bei unten liegender Konsole: Trenner und Konsolenzeilen einfügen
        if active_console and console_pos == "unten" and console_h > 0:
            if div_style == "vertikal":
                if eff_cols == 3:
                    mid_sep = f"├{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}┤"
                elif eff_cols == 2:
                    mid_sep = f"├{'─' * w_left}┴{'─' * w_mid}┤"
                else:
                    mid_sep = f"├{'─' * w_mid}┤"
            elif div_style == "außen":
                mid_sep = f"├{'─' * (term_cols - 2)}┤"
            elif div_style == "horizontal":
                mid_sep = "─" * term_cols
            else:
                mid_sep = pad_visible("── Konsole ──", term_cols)

            mid_sep = pad_visible(mid_sep, term_cols)
            all_lines.append(mid_sep)

            inside_w = (term_cols - 2) if div_style in ("vertikal", "außen") else term_cols
            c_lines = self.get_console_display_lines(inside_w, console_h)
            for cl in c_lines:
                if div_style in ("vertikal", "außen"):
                    all_lines.append(pad_visible(f"│{cl}│", term_cols))
                else:
                    all_lines.append(pad_visible(cl, term_cols))

        if has_bottom_border and bot_line:
            all_lines.append(bot_line)
        if has_status_bar and status_line:
            all_lines.append(status_line)

        return all_lines[:term_rows]

    def handle_mouse_click(self, x: int, y: int, fd: Optional[int] = None, old_settings = None) -> bool:
        """Behandelt Mausklicks im TUI-Fenster mit Spaltenerkennung und Doppelklick-Unterstützung."""
        if not hasattr(self, "last_layout"):
            return False

        layout = self.last_layout
        hdr_count = layout.get("header_lines", 2)
        avail_rows = layout.get("avail_rows", 0)
        eff_cols = layout.get("eff_cols", 1)
        div_style = layout.get("div_style", "vertikal")
        w_left = layout.get("w_left", 0)
        w_mid = layout.get("w_mid", 0)
        w_right = layout.get("w_right", 0)
        m_start = layout.get("m_start", 0)
        active_console = layout.get("active_console", False)
        console_pos = layout.get("console_pos", "unten")
        split_row = layout.get("split_row", -1)

        # Pfadzeile oben (y == 1)
        if y == 1:
            self.interactive_goto()
            return True

        # Klick in Konsole prüfen
        if active_console:
            if console_pos == "unten" and split_row > 0:
                if y > split_row:
                    self.console_focused = True
                    return True
                else:
                    self.console_focused = False
            elif console_pos == "rechts":
                col_x = x - 1
                if div_style == "vertikal":
                    in_console = (col_x >= (w_left + w_mid + 3)) if eff_cols == 3 else (col_x >= (w_mid + 2))
                elif div_style == "außen":
                    in_console = (col_x >= (w_left + w_mid + 5)) if eff_cols == 3 else (col_x >= (w_mid + 3))
                else:
                    in_console = (col_x > (w_left + 2 + w_mid)) if eff_cols == 3 else (col_x > (w_mid + 2))
                if in_console:
                    self.console_focused = True
                    return True
                else:
                    self.console_focused = False
            elif console_pos == "links":
                col_x = x - 1
                in_console = (col_x <= w_left)
                if in_console:
                    self.console_focused = True
                    return True
                else:
                    self.console_focused = False

        file_row = (y - 1) - hdr_count

        if 0 <= file_row < avail_rows:
            col_x = x - 1  # 0-basiert

            if div_style == "vertikal":
                in_left = (eff_cols >= 2 and 1 <= col_x <= w_left)
                in_mid = (eff_cols == 1 and 1 <= col_x <= w_mid) or (eff_cols >= 2 and (w_left + 2) <= col_x <= (w_left + 1 + w_mid))
                in_right = (eff_cols == 3 and col_x >= (w_left + w_mid + 3))
            elif div_style == "außen":
                in_left = (eff_cols >= 2 and 1 <= col_x <= w_left)
                in_mid = (eff_cols == 1 and 1 <= col_x <= w_mid) or (eff_cols >= 2 and (w_left + 3) <= col_x <= (w_left + 2 + w_mid))
                in_right = (eff_cols == 3 and col_x >= (w_left + w_mid + 5))
            else:
                in_left = (eff_cols >= 2 and col_x < w_left)
                in_mid = (eff_cols == 1 and col_x <= w_mid) or (eff_cols >= 2 and (w_left + 2) <= col_x <= (w_left + 2 + w_mid))
                in_right = (eff_cols == 3 and col_x > (w_left + 2 + w_mid))

            if in_left and not (active_console and console_pos == "links"):
                self.go_parent_directory()
                return True
            elif in_mid:
                target_idx = m_start + file_row
                if 0 <= target_idx < len(self.items):
                    now = datetime.datetime.now().timestamp()
                    is_double_click = (
                        target_idx == self.selected_idx
                        and (now - self.last_click_time < 0.45)
                        and (self.last_click_idx == target_idx)
                    )
                    if is_double_click:
                        self.last_click_time = 0.0
                        self.last_click_idx = None
                        self.open_current()
                    else:
                        self.selected_idx = target_idx
                        self.last_click_time = now
                        self.last_click_idx = target_idx
                    return True
            elif in_right and not (active_console and console_pos == "rechts"):
                cur_item = layout.get("cur_item")
                if cur_item and layout.get("is_cur_dir"):
                    child_items = layout.get("child_items", [])
                    self.change_directory(cur_item.path)
                    if 0 <= file_row < len(child_items):
                        self.selected_idx = file_row
                    return True
                elif cur_item and not layout.get("is_cur_dir"):
                    self.open_current()
                    return True

        return False

    def handle_mouse_right_click(self, x: int, y: int) -> bool:
        """Rechtsklick schaltet die Auswahl des angeklickten Elements um."""
        if not hasattr(self, "last_layout"):
            return False

        layout = self.last_layout
        hdr_count = layout.get("header_lines", 2)
        avail_rows = layout.get("avail_rows", 0)
        eff_cols = layout.get("eff_cols", 1)
        div_style = layout.get("div_style", "vertikal")
        w_left = layout.get("w_left", 0)
        w_mid = layout.get("w_mid", 0)
        m_start = layout.get("m_start", 0)
        active_console = layout.get("active_console", False)
        console_pos = layout.get("console_pos", "unten")
        split_row = layout.get("split_row", -1)

        if active_console and console_pos == "unten" and split_row > 0 and y > split_row:
            return False

        file_row = (y - 1) - hdr_count
        if 0 <= file_row < avail_rows:
            col_x = x - 1
            if div_style == "vertikal":
                in_mid = (eff_cols == 1 and 1 <= col_x <= w_mid) or (eff_cols >= 2 and (w_left + 2) <= col_x <= (w_left + 1 + w_mid))
            elif div_style == "außen":
                in_mid = (eff_cols == 1 and 1 <= col_x <= w_mid) or (eff_cols >= 2 and (w_left + 3) <= col_x <= (w_left + 2 + w_mid))
            else:
                in_mid = (eff_cols == 1 and col_x <= w_mid) or (eff_cols >= 2 and (w_left + 2) <= col_x <= (w_left + 2 + w_mid))

            if in_mid:
                target_idx = m_start + file_row
                if 0 <= target_idx < len(self.items):
                    self.selected_idx = target_idx
                    self.toggle_select()
                    return True
        return False

    def run(self):
        """Hauptschleife der TUI-Anwendung mit voller Maus- und Tastaturunterstützung."""
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            print("Fehler: EasyDateien erfordert ein interaktives Terminal.")
            sys.exit(1)

        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)

        try:
            signal.signal(signal.SIGWINCH, lambda s, f: None)
        except Exception:
            pass

        tty.setcbreak(fd, termios.TCSADRAIN)
        sys.stdout.write("\033[?1049h" + HIDE_CURSOR)

        mouse_enabled = self.config.get("mouse_support", True)
        if mouse_enabled:
            sys.stdout.write("\033[?1000h\033[?1006h")

        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        last_size = None
        needs_redraw = True

        try:
            while True:
                curr_size = shutil.get_terminal_size((80, 24))
                if curr_size != last_size:
                    last_size = curr_size
                    needs_redraw = True

                term_cols, term_rows = curr_size

                if needs_redraw:
                    lines = self.build_screen(term_cols, term_rows)
                    sys.stdout.write("\033[H")
                    for i, line in enumerate(lines):
                        if i == len(lines) - 1:
                            sys.stdout.write(f"\r\033[2K{line}")
                        else:
                            sys.stdout.write(f"\r\033[2K{line}\n")
                    sys.stdout.flush()
                    needs_redraw = False

                key = read_key(fd, timeout=0.05)
                if not key:
                    continue

                # Statusmeldung bei Cursor-Bewegung leeren (nur wenn Konsole nicht fokussiert)
                if key in ("UP", "DOWN", "k", "j", "PAGE_UP", "PAGE_DOWN", "HOME", "END", "MOUSE_WHEEL_UP", "MOUSE_WHEEL_DOWN"):
                    if not (self.show_console and self.console_focused):
                        self.status_message = ""

                # Maus-Ereignisse verarbeiten
                if key == "MOUSE_WHEEL_UP":
                    if self.show_console and self.console_focused:
                        self.console_scroll_offset += 2
                        needs_redraw = True
                    elif self.items:
                        self.selected_idx = max(0, self.selected_idx - 1)
                        needs_redraw = True
                    continue
                elif key == "MOUSE_WHEEL_DOWN":
                    if self.show_console and self.console_focused:
                        self.console_scroll_offset = max(0, self.console_scroll_offset - 2)
                        needs_redraw = True
                    elif self.items:
                        self.selected_idx = min(len(self.items) - 1, self.selected_idx + 1)
                        needs_redraw = True
                    continue
                elif key.startswith("MOUSE_CLICK:"):
                    parts = key.split(":")
                    if len(parts) == 3:
                        try:
                            cx = int(parts[1])
                            cy = int(parts[2])
                            if self.handle_mouse_click(cx, cy, fd, old_settings):
                                needs_redraw = True
                        except Exception:
                            pass
                    continue
                elif key.startswith("MOUSE_RIGHT_CLICK:"):
                    parts = key.split(":")
                    if len(parts) == 3:
                        try:
                            cx = int(parts[1])
                            cy = int(parts[2])
                            if self.handle_mouse_right_click(cx, cy):
                                needs_redraw = True
                        except Exception:
                            pass
                    continue
                elif key.startswith("MOUSE_EVENT:"):
                    continue

                # ---------------------------------------------------------
                # Eingaben bei fokussierter Konsole direkt abfangen
                # ---------------------------------------------------------
                if self.show_console and self.console_focused:
                    if key == "ENTER":
                        cmd = self.console_input
                        self.run_console_command(cmd, fd, old_settings)
                        needs_redraw = True
                        continue
                    elif key in ("TAB", "ESC"):
                        self.console_focused = False
                        self.status_message = "Fokus auf Dateimanager gewechselt."
                        needs_redraw = True
                        continue
                    elif key == "BACKSPACE":
                        if self.console_cursor_idx > 0:
                            self.console_input = (
                                self.console_input[:self.console_cursor_idx - 1]
                                + self.console_input[self.console_cursor_idx:]
                            )
                            self.console_cursor_idx -= 1
                            needs_redraw = True
                        continue
                    elif key == "DELETE":
                        if self.console_cursor_idx < len(self.console_input):
                            self.console_input = (
                                self.console_input[:self.console_cursor_idx]
                                + self.console_input[self.console_cursor_idx + 1:]
                            )
                            needs_redraw = True
                        continue
                    elif key == "LEFT":
                        if self.console_cursor_idx > 0:
                            self.console_cursor_idx -= 1
                            needs_redraw = True
                        continue
                    elif key == "RIGHT":
                        if self.console_cursor_idx < len(self.console_input):
                            self.console_cursor_idx += 1
                            needs_redraw = True
                        continue
                    elif key in ("HOME", "\x01"):
                        self.console_cursor_idx = 0
                        needs_redraw = True
                        continue
                    elif key in ("END", "\x05"):
                        self.console_cursor_idx = len(self.console_input)
                        needs_redraw = True
                        continue
                    elif key == "UP":
                        if self.console_cmd_history:
                            if self.console_history_idx > 0:
                                self.console_history_idx -= 1
                                self.console_input = self.console_cmd_history[self.console_history_idx]
                                self.console_cursor_idx = len(self.console_input)
                                needs_redraw = True
                        continue
                    elif key == "DOWN":
                        if self.console_cmd_history:
                            if self.console_history_idx < len(self.console_cmd_history) - 1:
                                self.console_history_idx += 1
                                self.console_input = self.console_cmd_history[self.console_history_idx]
                                self.console_cursor_idx = len(self.console_input)
                                needs_redraw = True
                            elif self.console_history_idx == len(self.console_cmd_history) - 1:
                                self.console_history_idx = len(self.console_cmd_history)
                                self.console_input = ""
                                self.console_cursor_idx = 0
                                needs_redraw = True
                        continue
                    elif key == "PAGE_UP":
                        self.console_scroll_offset += 3
                        needs_redraw = True
                        continue
                    elif key == "PAGE_DOWN":
                        self.console_scroll_offset = max(0, self.console_scroll_offset - 3)
                        needs_redraw = True
                        continue
                    elif key == "SPACE":
                        self.console_input = (
                            self.console_input[:self.console_cursor_idx]
                            + " "
                            + self.console_input[self.console_cursor_idx:]
                        )
                        self.console_cursor_idx += 1
                        needs_redraw = True
                        continue
                    elif key == "\x0c":  # Ctrl+L
                        self.console_output_lines.clear()
                        needs_redraw = True
                        continue
                    elif key == "\x15":  # Ctrl+U
                        self.console_input = self.console_input[self.console_cursor_idx:]
                        self.console_cursor_idx = 0
                        needs_redraw = True
                        continue
                    elif key == "\x0b":  # Ctrl+K
                        self.console_input = self.console_input[:self.console_cursor_idx]
                        needs_redraw = True
                        continue
                    elif key == "\x17":  # Ctrl+W
                        idx = self.console_cursor_idx
                        while idx > 0 and self.console_input[idx - 1] == " ":
                            idx -= 1
                        while idx > 0 and self.console_input[idx - 1] != " ":
                            idx -= 1
                        self.console_input = self.console_input[:idx] + self.console_input[self.console_cursor_idx:]
                        self.console_cursor_idx = idx
                        needs_redraw = True
                        continue
                    elif key == "QUIT":
                        if self.console_input:
                            self.console_input = ""
                            self.console_cursor_idx = 0
                            self.console_history_idx = len(self.console_cmd_history)
                        else:
                            self.toggle_console()
                        needs_redraw = True
                        continue
                    elif len(key) == 1 and (key.isprintable() or key == "\t"):
                        self.console_input = (
                            self.console_input[:self.console_cursor_idx]
                            + key
                            + self.console_input[self.console_cursor_idx:]
                        )
                        self.console_cursor_idx += 1
                        needs_redraw = True
                        continue
                    else:
                        continue

                # Tab wechselt Fokus zur Konsole (bzw. öffnet Konsole)
                if key == "TAB":
                    if self.show_console:
                        self.console_focused = True
                        self.status_message = "Fokus auf Konsole gewechselt."
                    else:
                        self.toggle_console()
                    needs_redraw = True
                    continue

                if key == "ESC" and self.pending_key_seq:
                    self.pending_key_seq = ""
                    self.status_message = ""
                    needs_redraw = True
                    continue

                # Mehrschrittige Tastenfolgen (z.B. g d, g f, g i, c z)
                if self.pending_key_seq:
                    full_seq = self.pending_key_seq + key
                    self.pending_key_seq = ""

                    if full_seq == "gd":
                        self.change_directory(os.path.expanduser("~/Downloads"))
                        needs_redraw = True
                        continue
                    elif full_seq == "gf":
                        self.change_directory(os.path.expanduser("~/Documents"))
                        needs_redraw = True
                        continue
                    elif full_seq in ("gh", "g~"):
                        self.change_directory(os.path.expanduser("~"))
                        needs_redraw = True
                        continue
                    elif full_seq in ("gg",):
                        self.selected_idx = 0
                        needs_redraw = True
                        continue
                    elif full_seq == "gi":
                        self.interactive_goto()
                        needs_redraw = True
                        continue
                    elif full_seq == "gp":
                        try:
                            res = subprocess.run(["pbpaste"], capture_output=True, text=True)
                            p = res.stdout.strip()
                            if os.path.isdir(p):
                                self.change_directory(p)
                            else:
                                self.status_message = f"Kein gültiger Pfad in der Zwischenablage: {p}"
                        except Exception:
                            self.status_message = "Konnte Zwischenablage nicht abfragen."
                        needs_redraw = True
                        continue
                    elif full_seq in ("cz", "c z"):
                        self.create_zip_archive()
                        needs_redraw = True
                        continue
                    elif full_seq in ("cc", "c c"):
                        if self.items:
                            p = self.items[self.selected_idx].path
                            copy_text_to_clipboard(p)
                            self.status_message = f"Pfad kopiert: {p}"
                            needs_redraw = True
                        continue
                    elif full_seq in ("cf", "c f"):
                        if self.items:
                            fn = self.items[self.selected_idx].name
                            copy_text_to_clipboard(fn)
                            self.status_message = f"Dateiname kopiert: {fn}"
                            needs_redraw = True
                        continue
                    elif full_seq in ("cd", "c d"):
                        p = self.current_dir
                        copy_text_to_clipboard(p)
                        self.status_message = f"Ordnerpfad kopiert: {p}"
                        needs_redraw = True
                        continue
                    elif full_seq in ("cy", "c y"):
                        self.copy_selection()
                        needs_redraw = True
                        continue
                    elif full_seq in ("zh", "z h"):
                        self.toggle_hidden_files()
                        needs_redraw = True
                        continue

                if key in ("g", "c"):
                    self.pending_key_seq = key
                    if key == "g":
                        self.status_message = "[g...] (d: Downloads, f: Dokumente, h: Home, g: Oben, i: Pfad, p: Paste-Pfad)"
                    elif key == "c":
                        self.status_message = "[c...] (z: ZIP-Archiv, c: Pfad, f: Dateiname, d: Ordnerpfad, y: Kopieren)"
                    needs_redraw = True
                    continue

                # Keybindings aus Konfiguration prüfen
                kb = self.config.get("keybindings", DEFAULT_KEYMAP)

                # 1. Navigation Hoch
                if key in kb.get("up", ["UP", "k"]):
                    if self.items:
                        self.selected_idx = (self.selected_idx - 1) % len(self.items)
                        needs_redraw = True
                # 2. Navigation Runter
                elif key in kb.get("down", ["DOWN", "j"]):
                    if self.items:
                        self.selected_idx = (self.selected_idx + 1) % len(self.items)
                        needs_redraw = True
                # 3. Übergeordnetes Verzeichnis (Zurück)
                elif key in kb.get("left", ["LEFT", "h"]):
                    self.go_parent_directory()
                    needs_redraw = True
                # 4. Hineingehen (Ordner) oder bei Doppeldruck nano öffnen (Datei)
                elif key in kb.get("right", ["RIGHT", "l"]):
                    if self.items:
                        item = self.items[self.selected_idx]
                        if item.is_dir:
                            self.change_directory(item.path)
                            needs_redraw = True
                        else:
                            now = datetime.datetime.now().timestamp()
                            if (now - self.last_right_arrow_time < 0.45) and (self.last_right_arrow_path == item.path):
                                self.last_right_arrow_time = 0.0
                                self.last_right_arrow_path = ""
                                self.open_in_nano(item, fd, old_settings)
                                needs_redraw = True
                            else:
                                self.last_right_arrow_time = now
                                self.last_right_arrow_path = item.path
                                self.status_message = f"Rechts doppelt drücken, um „{item.name}“ in nano zu bearbeiten"
                                needs_redraw = True
                # 4b. Öffnen per Enter (System-Standardbefehl open)
                elif key in kb.get("open", ["ENTER"]):
                    self.open_current()
                    needs_redraw = True
                # 5. Markieren / Auswahl umschalten
                elif key in kb.get("select", ["SPACE", "v"]):
                    self.toggle_select()
                    needs_redraw = True
                # 6. Alle markieren / abwählen
                elif key in kb.get("select_all", ["V", "a"]):
                    self.toggle_select_all()
                    needs_redraw = True
                # 7. Ausschneiden (x)
                elif key == "x" or key in kb.get("cut", ["x"]):
                    self.cut_selection()
                    needs_redraw = True
                # 8. Kopieren / Yank (y / c)
                elif key == "y" or key in kb.get("copy", ["y", "c"]):
                    self.copy_selection()
                    needs_redraw = True
                # 9. Einfügen (p)
                elif key == "p" or key in kb.get("paste", ["p"]):
                    self.paste_clipboard()
                    needs_redraw = True
                # 9b. Unyank / Zwischenspeicher leeren (Y / X wie in Yazi)
                elif key in ("Y", "X"):
                    self.clipboard_mode = None
                    self.clipboard_paths = []
                    self.status_message = "Zwischenspeicher geleert."
                    needs_redraw = True
                # 10. Papierkorb mit Sicherheitsdialog (d)
                elif key in kb.get("trash", ["d"]):
                    self.prompt_trash(fd)
                    needs_redraw = True
                # 11. Versteckte Dateien umschalten (./z)
                elif key in kb.get("toggle_hidden", [".", "z"]):
                    self.toggle_hidden_files()
                    needs_redraw = True
                # 11b. Konsole umschalten (t)
                elif key in kb.get("toggle_console", ["t"]):
                    self.toggle_console()
                    needs_redraw = True
                # 12. Konfigurationsmenü öffnen (m/C)
                elif key in kb.get("config_menu", ["m", "C"]):
                    self.open_config_menu()
                    needs_redraw = True
                # 13. Beenden (q/ESC)
                elif key in kb.get("quit", ["q", "QUIT"]):
                    break
                elif key == "ESC":
                    if self.selected_paths:
                        self.selected_paths.clear()
                        self.status_message = "Auswahl aufgehoben."
                        needs_redraw = True
                    elif self.clipboard_mode or self.clipboard_paths:
                        self.clipboard_mode = None
                        self.clipboard_paths = []
                        self.status_message = "Zwischenspeicher geleert."
                        needs_redraw = True
                    else:
                        if self.config.get("esc_to_quit", False):
                            break
                        needs_redraw = True
                # Spezielle Sprungtasten
                elif key == "HOME":
                    self.selected_idx = 0
                    needs_redraw = True
                elif key in ("END", "G"):
                    if self.items:
                        self.selected_idx = len(self.items) - 1
                        needs_redraw = True
                elif key == "PAGE_UP":
                    if self.items:
                        self.selected_idx = max(0, self.selected_idx - 10)
                        needs_redraw = True
                elif key == "PAGE_DOWN":
                    if self.items:
                        self.selected_idx = min(len(self.items) - 1, self.selected_idx + 10)
                        needs_redraw = True
                elif key == "~":
                    self.change_directory(os.path.expanduser("~"))
                    needs_redraw = True
                elif key in ("o",):
                    if self.items:
                        self.open_with_system(self.items[self.selected_idx])
                    needs_redraw = True
                elif key in ("e",):
                    if self.items:
                        p = self.items[self.selected_idx].path
                        subprocess.Popen(f'open -e "{p}"', shell=True)
                        self.status_message = f"In TextEdit geöffnet: {self.items[self.selected_idx].name}"
                        needs_redraw = True
                elif key in ("r",):
                    if self.items:
                        p = self.items[self.selected_idx].path
                        subprocess.Popen(f'open -R "{p}"', shell=True)
                        self.status_message = f"Im Finder gezeigt: {self.items[self.selected_idx].name}"
                        needs_redraw = True

        finally:
            if mouse_enabled:
                sys.stdout.write("\033[?1006l\033[?1000l")
                sys.stdout.flush()
            sys.stdout.write(SHOW_CURSOR)
            sys.stdout.write("\033[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def main():
    parser = argparse.ArgumentParser(
        prog="easydateien",
        description="EasyDateien — Minimalistischer, monochromer Terminal-Dateimanager für macOS.",
    )
    parser.add_argument("pfad", nargs="?", default=None, help="Startverzeichnis (Standard: aktuelles Verzeichnis)")
    parser.add_argument("-c", "--config", action="store_true", help="Interaktives Konfigurationsmenü direkt öffnen")
    parser.add_argument("-v", "--version", action="version", version="EasyDateien 1.0.0")

    args = parser.parse_args()

    if args.config:
        run_konfigurator()
        sys.exit(0)

    app = EasyDateienApp(initial_path=args.pfad)
    app.run()


if __name__ == "__main__":
    main()
