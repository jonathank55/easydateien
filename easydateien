def is_text_file(item: "FileEntry") -> bool:
    """Ermittelt, ob es sich um eine Code-, Markdown- oder Textdatei handelt."""
    if item.is_dir:
        return False
    if item.ext.lower() in TEXT_EXTENSIONS:
        return True
    if item.name.lower() in KNOWN_TEXT_FILENAMES:
        return True
    return False


class FileEntry:
    """Repräsentiert einen Datei- oder Ordner-Eintrag im aktuellen Verzeichnis."""

    __slots__ = ("name", "path", "is_dir", "is_symlink", "size", "mtime", "ext", "mode_str")

    def __init__(self, path: str, name: str):
        self.path = path
        self.name = name
        self.is_dir = False
        self.is_symlink = os.path.islink(path)
        self.size = 0
        self.mtime = 0.0
        self.mode_str = "----------"
        _, self.ext = os.path.splitext(name)

        try:
            st = os.stat(path, follow_symlinks=False)
            self.mtime = st.st_mtime
            try:
                self.mode_str = stat.filemode(st.st_mode)
            except Exception:
                self.mode_str = "----------"
            if os.path.islink(path):
                # Prüfen, ob Link auf Ordner zeigt
                try:
                    self.is_dir = os.path.isdir(path)
                except Exception:
                    self.is_dir = False
                self.size = st.st_size
            else:
                self.is_dir = os.path.isdir(path)
                self.size = 0 if self.is_dir else st.st_size
        except Exception:
            pass


def scan_directory(
    path: str,
    show_hidden: bool = False,
    sort_by: str = "mtime",
    sort_reverse: bool = True,
    sort_dir_first: bool = True,
) -> List[FileEntry]:
    """Liest den Inhalt eines Verzeichnisses ein und sortiert ihn nach den konfigurierten Vorgaben."""
    entries: List[FileEntry] = []
    try:
        with os.scandir(path) as it:
            for entry in it:
                if not show_hidden and entry.name.startswith("."):
                    continue
                entries.append(FileEntry(entry.path, entry.name))
    except Exception:
        return []

    # Sortierfunktionen
    def get_sort_key(item: FileEntry):
        if sort_by == "name":
            key = item.name.lower()
        elif sort_by == "size":
            key = item.size
        elif sort_by == "ext":
            key = (item.ext.lower(), item.name.lower())
        else:  # Standard: mtime
            key = item.mtime
        return key

    # Dirs first berücksichtigen
    if sort_dir_first:
        dirs = [e for e in entries if e.is_dir]
        files = [e for e in entries if not e.is_dir]
        dirs.sort(key=get_sort_key, reverse=sort_reverse)
        files.sort(key=get_sort_key, reverse=sort_reverse)
        return dirs + files
    else:
        entries.sort(key=get_sort_key, reverse=sort_reverse)
        return entries


def read_key(fd: int, timeout: float = 0.05) -> str:
    """Liest einen einzelnen Tastendruck oder ein Maus-Event ungepuffert direkt aus dem Filedeskriptor."""
    try:
        r, _, _ = select.select([fd], [], [], timeout)
        if not r:
            return ""
        raw = os.read(fd, 1)
    except Exception:
        return ""
    if not raw:
        return ""

    if raw == b"\x1b":
        seq = b""
        while True:
            r, _, _ = select.select([fd], [], [], 0.03)
            if not r:
                break
            try:
                c = os.read(fd, 1)
                seq += c
            except Exception:
                break

            # SGR-Maus-Sequenz: \x1b[<B;X;Y(M|m)
            if seq.startswith(b"[<"):
                if seq.endswith(b"M") or seq.endswith(b"m") or len(seq) >= 30:
                    break
            elif len(seq) >= 2 and seq[-1:] in b"ABCDHFS~":
                break
            elif len(seq) >= 6:
                break

        if not seq:
            return "ESC"

        # SGR-Maus-Event verarbeiten
        if seq.startswith(b"[<") and (seq.endswith(b"M") or seq.endswith(b"m")):
            try:
                state = chr(seq[-1])
                parts = seq[2:-1].decode("ascii").split(";")
                if len(parts) == 3:
                    btn = int(parts[0])
                    x = int(parts[1])
                    y = int(parts[2])
                    if btn == 64:
                        return "MOUSE_WHEEL_UP"
                    elif btn == 65:
                        return "MOUSE_WHEEL_DOWN"
                    elif btn == 0 and state == "M":
                        return f"MOUSE_CLICK:{x}:{y}"
                    elif btn == 2 and state == "M":
                        return f"MOUSE_RIGHT_CLICK:{x}:{y}"
                    else:
                        return f"MOUSE_EVENT:{btn}:{x}:{y}:{state}"
            except Exception:
                return "ESC"
            return ""

        if seq in (b"[A", b"OA"):
            return "UP"
        elif seq in (b"[B", b"OB"):
            return "DOWN"
        elif seq in (b"[C", b"OC"):
            return "RIGHT"
        elif seq in (b"[D", b"OD"):
            return "LEFT"
        elif seq in (b"[Z",):
            return "UP"
        elif seq in (b"[H", b"1~", b"7~"):
            return "HOME"
        elif seq in (b"[F", b"4~", b"8~"):
            return "END"
        elif seq in (b"[3~",):
            return "DELETE"
        elif seq in (b"[5~",):
            return "PAGE_UP"
        elif seq in (b"[6~",):
            return "PAGE_DOWN"
        return "ESC"

    elif raw in (b"\r", b"\n"):
        return "ENTER"
    elif raw == b" ":
        return "SPACE"
    elif raw == b"\t":
        return "TAB"
    elif raw in (b"\x7f", b"\x08"):
        return "BACKSPACE"
    elif raw in (b"\x03", b"\x04"):
        return "QUIT"

    if raw[0] >= 0xC0:
        needed = 2 if raw[0] < 0xE0 else (3 if raw[0] < 0xF0 else 4)
        ch_bytes = raw
        while len(ch_bytes) < needed:
            r, _, _ = select.select([fd], [], [], 0.03)
            if not r:
                break
            ch_bytes += os.read(fd, 1)
        try:
            return ch_bytes.decode("utf-8")
        except Exception:
            return ""

    try:
        return raw.decode("utf-8")
    except Exception:
        return ""


def move_to_trash(paths: List[str]) -> tuple[int, List[str]]:
    """Verschiebt eine Liste von Pfaden in den macOS-Papierkorb."""
    success_count = 0
    errors = []

    # Prüfen, ob /usr/bin/trash vorhanden ist (nativ und blitzschnell)
    has_trash_bin = shutil.which("trash") is not None

    for p in paths:
        if not os.path.exists(p) and not os.path.islink(p):
            continue
        done = False
        if has_trash_bin:
            try:
                res = subprocess.run(["trash", p], capture_output=True, text=True, timeout=5)
                if res.returncode == 0:
                    done = True
                    success_count += 1
            except Exception:
                done = False

        if not done:
            # Fallback 1: osascript Finder
            try:
                cmd = f'tell application "Finder" to delete (POSIX file "{p}" as alias)'
                res = subprocess.run(["osascript", "-e", cmd], capture_output=True, text=True, timeout=5)
                if res.returncode == 0:
                    done = True
                    success_count += 1
            except Exception:
                done = False

        if not done:
            # Fallback 2: Verschieben nach ~/.Trash
            try:
                trash_dir = os.path.expanduser("~/.Trash")
                os.makedirs(trash_dir, exist_ok=True)
                target = os.path.join(trash_dir, os.path.basename(p))
                if os.path.exists(target):
                    base, ext = os.path.splitext(os.path.basename(p))
                    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                    target = os.path.join(trash_dir, f"{base}_{stamp}{ext}")
                shutil.move(p, target)
                done = True
                success_count += 1
            except Exception as e:
                errors.append(f"{os.path.basename(p)}: {e}")

    return success_count, errors


def generate_unique_dest(dest_dir: str, src_name: str) -> str:
    """Erzeugt einen nicht-kollidierenden Zielpfad im Zielverzeichnis."""
    target = os.path.join(dest_dir, src_name)
    if not os.path.exists(target) and not os.path.islink(target):
        return target
    base, ext = os.path.splitext(src_name)
    counter = 1
    while True:
        candidate = os.path.join(dest_dir, f"{base} (Kopie {counter}){ext}")
        if not os.path.exists(candidate) and not os.path.islink(candidate):
            return candidate
        counter += 1


class EasyDateienApp:
    """Zentrale Dateimanager-Anwendungsinstanz."""

    def __init__(self, initial_path: Optional[str] = None):
        self.config = load_config()
        if initial_path and os.path.isdir(os.path.expanduser(initial_path)):
            self.current_dir = os.path.abspath(os.path.expanduser(initial_path))
        else:
            self.current_dir = os.getcwd()

        self.items: List[FileEntry] = []
        self.selected_idx = 0
        self.selected_paths: Set[str] = set()
        self.clipboard_mode: Optional[str] = None  # "cut" oder "copy"
        self.clipboard_paths: List[str] = []
        self.status_message: str = ""
        self.pending_key_seq: str = ""
        self.dir_cursor_history: Dict[str, str] = {}  # Merkt sich das ausgewählte Element pro Pfad
        self.last_click_time: float = 0.0
        self.last_click_idx: Optional[int] = None
        self.last_right_arrow_time: float = 0.0
        self.last_right_arrow_path: str = ""
        self.last_layout: Dict = {}

        # Caching für Parent- und Child-Spalten für maximale Flüssigkeit
        self.cached_parent_dir: Optional[str] = None
        self.cached_parent_items: List[FileEntry] = []
        self.cached_parent_mtime: float = -1.0
        self.cached_child_path: Optional[str] = None
        self.cached_child_items: List[FileEntry] = []
        self.cached_child_mtime: float = -1.0

        self.refresh_items()

    def refresh_items(self):
        """Liest das aktuelle Verzeichnis neu ein und setzt den Cursor."""
        self.cached_parent_dir = None
        self.cached_child_path = None
        self.items = scan_directory(
            self.current_dir,
            show_hidden=self.config.get("show_hidden", False),
            sort_by=self.config.get("sort_by", "mtime"),
            sort_reverse=self.config.get("sort_reverse", True),
            sort_dir_first=self.config.get("sort_dir_first", True),
        )
        # Cursor anhand von History oder Index wiederherstellen
        last_selected_name = self.dir_cursor_history.get(self.current_dir)
        if last_selected_name:
            found = False
            for i, it in enumerate(self.items):
                if it.name == last_selected_name:
                    self.selected_idx = i
                    found = True
                    break
            if not found:
                self.selected_idx = min(self.selected_idx, max(0, len(self.items) - 1))
        else:
            self.selected_idx = min(self.selected_idx, max(0, len(self.items) - 1))

    def change_directory(self, new_dir: str):
        """Wechselt in ein anderes Verzeichnis."""
        if not os.path.isdir(new_dir):
            self.status_message = f"Verzeichnis nicht erreichbar: {new_dir}"
            return

        # Aktuelle Auswahl in History merken
        if self.items and 0 <= self.selected_idx < len(self.items):
            self.dir_cursor_history[self.current_dir] = self.items[self.selected_idx].name

        self.current_dir = os.path.abspath(new_dir)
        self.selected_idx = 0
        self.refresh_items()

    def go_parent_directory(self):
        """Wechselt in das übergeordnete Verzeichnis."""
        parent = os.path.dirname(self.current_dir)
        if parent == self.current_dir:
            return  # Bereits im Root-Verzeichnis
        old_dir_name = os.path.basename(self.current_dir)
        self.current_dir = parent
        self.refresh_items()
        # Cursor auf den Ordner setzen, den wir gerade verlassen haben
        for i, it in enumerate(self.items):
            if it.name == old_dir_name:
                self.selected_idx = i
                break

    def open_with_system(self, item: FileEntry):
        """Öffnet eine Datei oder einen Ordner mit dem Standard-Systemöffner (z. B. open)."""
        opener = self.config.get("opener", "open %s")
        cmd = opener.replace("%s", f'"{item.path}"')
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
            self.status_message = f"Geöffnet: {item.name}"
        except Exception as e:
            self.status_message = f"Fehler beim Öffnen: {e}"

    def open_current(self):
        """Öffnet das aktuell ausgewählte Element per Systembefehl 'open' (sowohl Dateien als auch Ordner)."""
        if not self.items:
            return
        item = self.items[self.selected_idx]
        self.open_with_system(item)

    def open_in_nano(self, item: FileEntry, fd: Optional[int] = None, old_settings = None):
        """Öffnet eine Datei im Terminal-Editor nano (oder konfiguriertem Editor) bei Doppelklick auf die rechte Pfeiltaste."""
        if fd is not None and old_settings is not None:
            mouse_on = self.config.get("mouse_support", True)
            if mouse_on:
                sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.write(SHOW_CURSOR)
            sys.stdout.write("\033[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            try:
                editor_cmd = self.config.get("text_editor", "nano %s")
                if "%s" in editor_cmd:
                    cmd = editor_cmd.replace("%s", f'"{item.path}"')
                else:
                    cmd = f'{editor_cmd} "{item.path}"'
                subprocess.run(cmd, shell=True)
            except Exception as e:
                self.status_message = f"Fehler beim Starten des Editors: {e}"
            finally:
                tty.setcbreak(fd, termios.TCSADRAIN)
                sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                if mouse_on:
                    sys.stdout.write("\033[?1000h\033[?1006h")
                sys.stdout.write("\033[2J\033[H")
                sys.stdout.flush()
                self.refresh_items()

    def toggle_select(self):
        """Schaltet die Markierung des aktuellen Elements um und bewegt den Cursor nach unten."""
        if not self.items:
            return
        item = self.items[self.selected_idx]
        if item.path in self.selected_paths:
            self.selected_paths.remove(item.path)
        else:
            self.selected_paths.add(item.path)

        if self.selected_idx < len(self.items) - 1:
            self.selected_idx += 1

    def toggle_select_all(self):
        """Wählt alle sichtbaren Elemente aus oder hebt die Auswahl vollständig auf."""
        all_paths = {it.path for it in self.items}
        if self.selected_paths.issuperset(all_paths) and all_paths:
            self.selected_paths.clear()
            self.status_message = "Auswahl aufgehoben."
        else:
            self.selected_paths.update(all_paths)
            self.status_message = f"{len(self.selected_paths)} Elemente markiert."

    def cut_selection(self):
        """Markiert die aktuelle Auswahl (oder das aktuelle Element) zum Ausschneiden."""
        if not self.items:
            return
        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        self.clipboard_mode = "cut"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        self.status_message = f"{len(targets)} Element(e) zum Ausschneiden markiert (mit 'p' einfügen)."

    def copy_selection(self):
        """Markiert die aktuelle Auswahl (oder das aktuelle Element) zum Kopieren."""
        if not self.items:
            return
        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        self.clipboard_mode = "copy"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        self.status_message = f"{len(targets)} Element(e) zum Kopieren markiert (mit 'p' einfügen)."

    def paste_clipboard(self):
        """Fügt Elemente aus dem Zwischenspeicher in das aktuelle Verzeichnis ein."""
        if not self.clipboard_mode or not self.clipboard_paths:
            self.status_message = "Zwischenspeicher ist leer."
            return

        success_count = 0
        errors = []

        for src in self.clipboard_paths:
            if not os.path.exists(src) and not os.path.islink(src):
                errors.append(f"Quelle nicht mehr vorhanden: {os.path.basename(src)}")
                continue

            src_name = os.path.basename(src)
            dest = os.path.join(self.current_dir, src_name)

            if os.path.abspath(src) == os.path.abspath(dest) and self.clipboard_mode == "copy":
                dest = generate_unique_dest(self.current_dir, src_name)
            elif os.path.exists(dest) and os.path.abspath(src) != os.path.abspath(dest):
                dest = generate_unique_dest(self.current_dir, src_name)

            try:
                if self.clipboard_mode == "cut":
                    shutil.move(src, dest)
                    success_count += 1
                elif self.clipboard_mode == "copy":
                    if os.path.islink(src):
                        link_target = os.readlink(src)
                        os.symlink(link_target, dest)
                    elif os.path.isdir(src):
                        shutil.copytree(src, dest)
                    else:
                        shutil.copy2(src, dest)
                    success_count += 1
            except Exception as e:
                errors.append(f"{src_name}: {e}")

        if self.clipboard_mode == "cut":
            self.clipboard_mode = None
            self.clipboard_paths = []

        self.refresh_items()
        if errors:
            self.status_message = f"{success_count} eingefügt, Fehler: {', '.join(errors[:2])}"
        else:
            self.status_message = f"{success_count} Element(e) erfolgreich eingefügt."

    def prompt_trash(self, fd: int) -> bool:
        """Bestätigungsdialog zum Verschieben in den Papierkorb (y/N)."""
        if not self.items:
            return False

        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        if not targets:
            return False

        if len(targets) == 1:
            name = os.path.basename(targets[0])
            prompt_txt = f"„{name}“ in den Papierkorb verschieben? (y/N): "
        else:
            prompt_txt = f"{len(targets)} Elemente in den Papierkorb verschieben? (y/N): "

        term_cols = shutil.get_terminal_size((80, 24)).columns
        margin = "  " if term_cols >= 80 else (" " if term_cols >= 45 else "")
        prompt_visible = truncate_end(prompt_txt, max(5, term_cols - len(margin) - 2))

        # Prompt in der Statuszeile anzeigen
        sys.stdout.write(f"\r{CLEAR_LINE}{margin}{BOLD}{prompt_visible}{RESET}")
        sys.stdout.flush()

        ans = read_key(fd, timeout=10.0)
        if ans.lower() in ("y", "j"):
            count, errs = move_to_trash(targets)
            self.selected_paths.clear()
            self.refresh_items()
            if errs:
                self.status_message = f"{count} gelöscht, Fehler: {', '.join(errs[:1])}"
            else:
                self.status_message = f"{count} Element(e) in den Papierkorb verschoben."
            return True
        else:
            self.status_message = "Verschieben in den Papierkorb abgebrochen."
            return False

    def create_zip_archive(self):
        """Erstellt ein ZIP-Archiv aus den markierten Elementen oder dem aktuellen Element."""
        if not self.items:
            return
        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        if not targets:
            return

        if len(targets) == 1:
            base_name = os.path.splitext(os.path.basename(targets[0]))[0]
            zip_filename = f"{base_name}.zip"
        else:
            stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            zip_filename = f"Archiv_{stamp}.zip"

        zip_path = os.path.join(self.current_dir, zip_filename)
        if os.path.exists(zip_path):
            zip_path = generate_unique_dest(self.current_dir, zip_filename)

        try:
            with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
                for target in targets:
                    if os.path.isdir(target):
                        for root, _, files in os.walk(target):
                            for f in files:
                                full_f = os.path.join(root, f)
                                arcname = os.path.relpath(full_f, os.path.dirname(target))
                                zf.write(full_f, arcname)
                    else:
                        zf.write(target, os.path.basename(target))
            self.selected_paths.clear()
            self.refresh_items()
            self.status_message = f"Archiv „{os.path.basename(zip_path)}“ erstellt."
        except Exception as e:
            self.status_message = f"Fehler bei ZIP-Erstellung: {e}"

    def interactive_goto(self):
        """Interaktive Eingabe eines Pfades mit automatischer Tab-Vervollständigung."""
        mouse_on = self.config.get("mouse_support", True)
        if mouse_on:
            sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.flush()
        sys.stdout.write(SHOW_CURSOR)
        sys.stdout.flush()
        target = edit_line_interactive("Gehe zu Pfad: ", initial=self.current_dir)
        sys.stdout.write(HIDE_CURSOR)
        if mouse_on:
            sys.stdout.write("\033[?1000h\033[?1006h")
        sys.stdout.flush()

        if target and target.strip():
            exp = os.path.expanduser(target.strip())
            if os.path.isdir(exp):
                self.change_directory(exp)
            else:
                self.status_message = f"Kein gültiges Verzeichnis: {target}"

    def toggle_hidden_files(self):
        """Schaltet die Anzeige versteckter Dateien um."""
        new_val = not self.config.get("show_hidden", False)
        self.config["show_hidden"] = new_val
        save_config(self.config)
        self.refresh_items()
        self.status_message = f"Versteckte Dateien: {'Eingeblendet' if new_val else 'Ausgeblendet'}"

    def open_config_menu(self):
        """Öffnet das interaktive Konfigurationsmenü."""
        mouse_on = self.config.get("mouse_support", True)
        if mouse_on:
            sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.flush()
        sys.stdout.write(SHOW_CURSOR)
        sys.stdout.flush()
        self.config = run_konfigurator(standalone=False)
        sys.stdout.write(HIDE_CURSOR)
        if self.config.get("mouse_support", True):
            sys.stdout.write("\033[?1000h\033[?1006h")
        sys.stdout.flush()
        self.refresh_items()
        self.status_message = "Konfiguration übernommen."

    def get_effective_columns(self, term_cols: int) -> int:
        """Ermittelt die Spaltenanzahl (1, 2 oder 3) basierend auf Spaltendarstellung und Fensterbreite."""
        if not self.config.get("columns_enabled", True):
            return 1
        if term_cols >= 68:
            return 3
        elif term_cols >= 38:
            return 2
        else:
            return 1

    def build_screen(self, term_cols: int, term_rows: int) -> List[str]:
        """Erstellt alle Zeilen der Anzeige dynamisch angepasst an jede Fenstergröße im Yazi-Box-Design."""
        # 1. Pfad formatieren
        home_dir = os.path.expanduser("~")
        disp_path = self.current_dir
        if disp_path.startswith(home_dir):
            disp_path = "~" + disp_path[len(home_dir):]

        total_items = len(self.items)
        cur_item = self.items[self.selected_idx] if (self.items and 0 <= self.selected_idx < total_items) else None
        cur_name = (cur_item.name + ("/" if cur_item.is_dir else "")) if cur_item else ""

        # Sonderfälle bei winziger Fensterhöhe
        if term_rows <= 1:
            return [pad_visible(truncate_end(disp_path, term_cols), term_cols)]
        if term_rows == 2:
            return [
                pad_visible(truncate_end(disp_path, term_cols), term_cols),
                pad_visible(truncate_end(cur_name, term_cols), term_cols),
            ]

        # Statuszeile (NOR, Steuerung ODER Dateimetadaten)
        if self.clipboard_mode == "cut":
            mode_lbl = "CUT"
        elif self.clipboard_mode == "copy":
            mode_lbl = "CPY"
        elif self.selected_paths:
            mode_lbl = f"SEL {len(self.selected_paths)}"
        else:
            mode_lbl = "NOR"

        pos_str = "Top" if self.selected_idx == 0 else ("Bot" if self.selected_idx == total_items - 1 else f"{int((self.selected_idx + 1) / max(1, total_items) * 100)}%")
        idx_str = f"{self.selected_idx + 1}/{total_items}" if total_items > 0 else "0/0"
        show_controls = self.config.get("show_controls", True)

        if self.status_message:
            left_txt = f" {BOLD}{mode_lbl}{RESET}  {self.status_message}"
            status_line = pad_visible(left_txt, term_cols)
        elif show_controls:
            # Yazi-Stil mit Steuerung
            if term_cols >= 95:
                right_txt = f" {pos_str:>4}  {idx_str:>6} "
            elif term_cols >= 45:
                right_txt = f" {idx_str:>5} "
            else:
                right_txt = ""

            left_badge = f" {BOLD}{mode_lbl}{RESET}  "
            avail_ctrl = max(0, term_cols - visible_len(left_badge) - visible_len(right_txt))

            ctrl_tiers = [
                "[↑↓] Bewegen  [→] Ordner (Doppel-→ nano)  [←] Zurück  [Enter] open  [Space] *  [m] Menü  [q] Beenden",
                "[↑↓] Bewegen  [→] Ordner/nano  [←] Zurück  [Enter] open  [Space] *  [m] Menü  [q] Ende",
                "[↑↓] Bewegen  [→] Ordner/nano  [←] Zurück  [Enter] open  [m] Menü  [q] Ende",
                "[↑↓] Nav  [→] Rein/nano  [←] Zurück  [Enter] open  [m] Menü  [q] Ende",
                "[↑↓] Nav  [→] Ordner/nano  [Enter] open  [m] Menü  [q] Ende",
                "[↑↓] Nav  [→] In  [Enter] open  [q] Ende",
                "[↑↓] Nav  [Enter] open  [q]",
            ]

            ctrl_str = ""
            for tier in ctrl_tiers:
                if len(tier) <= avail_ctrl:
                    ctrl_str = tier
                    break
            if not ctrl_str:
                ctrl_str = truncate_end(ctrl_tiers[-1], avail_ctrl)

            status_line = pad_visible(f"{left_badge}{ctrl_str}", term_cols - visible_len(right_txt)) + right_txt
        else:
            # Klassische Yazi-Dateimetadaten (Größe, Name, Rechte, Position, Index)
            size_str = format_size(cur_item.size) if (cur_item and not cur_item.is_dir) else ""
            size_txt = f"{size_str:>7} " if size_str else "        "
            perm_str = cur_item.mode_str if cur_item else "----------"

            if term_cols >= 75:
                right_txt = f" {perm_str}  {pos_str:>4}  {idx_str:>6} "
            elif term_cols >= 50:
                right_txt = f" {pos_str:>4}  {idx_str:>6} "
            elif term_cols >= 28:
                right_txt = f" {idx_str:>6} "
            else:
                right_txt = ""

            left_txt = f" {BOLD}{mode_lbl}{RESET}  {size_txt} "
            avail_name = term_cols - visible_len(left_txt) - visible_len(right_txt)
            if avail_name > 3:
                name_trunc = truncate_end(cur_name, avail_name)
                status_line = pad_visible(f"{left_txt}{name_trunc}", term_cols - visible_len(right_txt)) + right_txt
            else:
                status_line = pad_visible(f" {BOLD}{mode_lbl}{RESET}", term_cols - visible_len(right_txt)) + right_txt

        if term_rows == 3:
            return [
                pad_visible(truncate_end(disp_path, term_cols), term_cols),
                pad_visible(truncate_end(cur_name, term_cols), term_cols),
                status_line,
            ]

        # Zeilenaufteilung für Kasten:
        # Zeile 0: Pfadzeile
        # Zeile 1: Kasten oben (╭...╮)
        # Zeile 2 .. term_rows - 3 (oder -2): Inhaltszeilen
        # Zeile term_rows - 2: Kasten unten (╰...╯)
        # Zeile term_rows - 1: Statuszeile
        show_status = (term_rows >= 5)
        if show_status:
            avail_rows = term_rows - 4
        else:
            avail_rows = 1

        path_line = pad_visible(truncate_end(disp_path, term_cols), term_cols)

        # Spalten und Breiten
        eff_cols = self.get_effective_columns(term_cols)
        div_style = self.config.get("divider_style", "vertikal").lower()
        use_inner_div = (div_style != "keine")

        if eff_cols == 3:
            avail = max(10, term_cols - 4)
            w_left = max(6, int(avail * 0.16))
            w_right = max(10, int(avail * 0.28))
            w_mid = avail - w_left - w_right
            if w_mid < 12:
                w_left = max(4, w_left - (12 - w_mid) // 2)
                w_right = max(6, w_right - (12 - w_mid) // 2)
                w_mid = avail - w_left - w_right

            if use_inner_div:
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}┬{'─' * w_right}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}╯"
            else:
                top_line = f"╭{'─' * (term_cols - 2)}╮"
                bot_line = f"╰{'─' * (term_cols - 2)}╯"

        elif eff_cols == 2:
            avail = max(8, term_cols - 3)
            w_left = max(6, int(avail * 0.25))
            w_mid = avail - w_left
            w_right = 0

            if use_inner_div:
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}╯"
            else:
                top_line = f"╭{'─' * (term_cols - 2)}╮"
                bot_line = f"╰{'─' * (term_cols - 2)}╯"

        else:  # 1 Spalte
            w_left = 0
            w_right = 0
            w_mid = max(4, term_cols - 2)
            top_line = f"╭{'─' * w_mid}╮"
            bot_line = f"╰{'─' * w_mid}╯"

        # Daten für Elternverzeichnis (Spalte 1)
        parent_items: List[FileEntry] = []
        cur_p_idx = 0
        if eff_cols >= 2:
            parent_path = os.path.dirname(self.current_dir)
            if parent_path != self.current_dir:
                try:
                    p_mtime = os.path.getmtime(parent_path)
                except Exception:
                    p_mtime = 0.0
                if self.cached_parent_dir == parent_path and self.cached_parent_mtime == p_mtime:
                    parent_items = self.cached_parent_items
                else:
                    parent_items = scan_directory(
                        parent_path,
                        show_hidden=self.config.get("show_hidden", False),
                        sort_by=self.config.get("sort_by", "mtime"),
                        sort_reverse=self.config.get("sort_reverse", True),
                        sort_dir_first=self.config.get("sort_dir_first", True),
                    )
                    self.cached_parent_dir = parent_path
                    self.cached_parent_items = parent_items
                    self.cached_parent_mtime = p_mtime

                for i, p_it in enumerate(parent_items):
                    if os.path.abspath(p_it.path) == os.path.abspath(self.current_dir):
                        cur_p_idx = i
                        break

        if len(parent_items) <= avail_rows:
            p_start = 0
        else:
            p_half = avail_rows // 2
            p_start = max(0, min(cur_p_idx - p_half, len(parent_items) - avail_rows))

        # Daten für aktuellen Ordner (Spalte 2)
        if total_items <= avail_rows:
            m_start = 0
        else:
            m_half = avail_rows // 2
            m_start = max(0, min(self.selected_idx - m_half, total_items - avail_rows))

        # Daten für Kindverzeichnis (Spalte 3)
        child_items: List[FileEntry] = []
        is_cur_dir = bool(cur_item and cur_item.is_dir)
        if eff_cols == 3 and cur_item and is_cur_dir:
            try:
                c_mtime = os.path.getmtime(cur_item.path)
            except Exception:
                c_mtime = 0.0
            if self.cached_child_path == cur_item.path and self.cached_child_mtime == c_mtime:
                child_items = self.cached_child_items
            else:
                child_items = scan_directory(
                    cur_item.path,
                    show_hidden=self.config.get("show_hidden", False),
                    sort_by=self.config.get("sort_by", "mtime"),
                    sort_reverse=self.config.get("sort_reverse", True),
                    sort_dir_first=self.config.get("sort_dir_first", True),
                )
                self.cached_child_path = cur_item.path
                self.cached_child_items = child_items
                self.cached_child_mtime = c_mtime

        # Layout-Metriken für Mausklick-Erkennung sichern
        self.last_layout = {
            "header_lines": 2,
            "avail_rows": avail_rows,
            "eff_cols": eff_cols,
            "w_left": w_left,
            "w_mid": w_mid,
            "w_right": w_right,
            "m_start": m_start,
            "p_start": p_start,
            "child_items": child_items,
            "cur_item": cur_item,
            "is_cur_dir": is_cur_dir,
            "show_status": show_status,
        }

        # Zeilen rendern
        file_lines: List[str] = []
        for r in range(avail_rows):
            # 1. Zelle links (Eltern)
            if eff_cols >= 2:
                p_idx = p_start + r
                if p_idx < len(parent_items):
                    p_it = parent_items[p_idx]
                    is_act = (os.path.abspath(p_it.path) == os.path.abspath(self.current_dir))
                    p_name = p_it.name + ("/" if p_it.is_dir else "")
                    prefix = "▸ " if is_act else "  "
                    p_trunc = truncate_end(p_name, max(2, w_left - len(prefix) - 1))
                    if is_act:
                        txt_left = f" {BOLD}{prefix}{p_trunc}{RESET}"
                    else:
                        txt_left = f" {prefix}{p_trunc}"
                    cell_left = pad_visible(txt_left, w_left)
                else:
                    cell_left = " " * w_left

            # 2. Zelle mitte (Aktueller Ordner)
            m_idx = m_start + r
            if m_idx < total_items:
                item = self.items[m_idx]
                is_cursor = (m_idx == self.selected_idx)
                is_sel = item.path in self.selected_paths
                in_cut = (self.clipboard_mode == "cut" and item.path in self.clipboard_paths)
                in_copy = (self.clipboard_mode == "copy" and item.path in self.clipboard_paths)

                # Badges: * für Auswahl, × für Cut, + für Copy, 2 Leerzeichen normal
                if in_cut:
                    badge = "× "
                elif in_copy:
                    badge = "+ "
                elif is_sel:
                    badge = "* "
                else:
                    badge = "  "

                if w_mid < 25:
                    cur_c = "▸" if is_cursor else " "
                    bad_c = "×" if in_cut else ("+" if in_copy else ("*" if is_sel else " "))
                    prefix_str = f" {cur_c}{bad_c}"
                    prefix_len = 3
                elif w_mid < 15:
                    cur_c = "▸" if is_cursor else ("*" if is_sel else " ")
                    prefix_str = f" {cur_c}"
                    prefix_len = 2
                else:
                    cur_prefix = "▸ " if is_cursor else "  "
                    prefix_str = f" {cur_prefix}{badge}"
                    prefix_len = 5

                name_display = item.name + ("/" if item.is_dir else "")
                size_str = format_size(item.size) if not item.is_dir else ""

                if w_mid >= 28:
                    avail_name = max(3, w_mid - prefix_len - 8)
                    name_trunc = truncate_end(name_display, avail_name)
                    size_part = f"{size_str:>7} " if size_str else "        "
                    if is_cursor:
                        left_part = f"{BOLD}{prefix_str}{name_trunc}{RESET}"
                    else:
                        left_part = f"{prefix_str}{name_trunc}"
                    cell_mid = pad_visible(left_part, w_mid - 8) + size_part
                else:
                    avail_name = max(3, w_mid - prefix_len - 1)
                    name_trunc = truncate_end(name_display, avail_name)
                    if is_cursor:
                        cell_mid = pad_visible(f"{BOLD}{prefix_str}{name_trunc}{RESET}", w_mid)
                    else:
                        cell_mid = pad_visible(f"{prefix_str}{name_trunc}", w_mid)
            else:
                if total_items == 0 and r == 0:
                    cell_mid = pad_visible(f"  {ITALIC}(Ordner ist leer){RESET}", w_mid)
                else:
                    cell_mid = " " * w_mid

            # 3. Zelle rechts (Kindverzeichnis oder Datei-Details)
            if eff_cols == 3:
                if cur_item:
                    if is_cur_dir:
                        if r < len(child_items):
                            c_it = child_items[r]
                            c_name = c_it.name + ("/" if c_it.is_dir else "")
                            c_size = format_size(c_it.size) if not c_it.is_dir else ""
                            if w_right >= 22 and c_size:
                                avail_c = max(3, w_right - 2 - 8)
                                c_trunc = truncate_end(c_name, avail_c)
                                cell_right = pad_visible(f"  {c_trunc}", w_right - 8) + f"{c_size:>7} "
                            else:
                                avail_c = max(3, w_right - 3)
                                c_trunc = truncate_end(c_name, avail_c)
                                cell_right = pad_visible(f"  {c_trunc}", w_right)
                        elif len(child_items) == 0 and r == 0:
                            cell_right = pad_visible(f"  {ITALIC}(leer){RESET}", w_right)
                        else:
                            cell_right = " " * w_right
                    else:
                        card = [
                            f" {BOLD}Details{RESET}",
                            f" {get_divider('─', max(1, w_right - 3))}",
                            f" Name:   {truncate_end(cur_item.name, max(3, w_right - 10))}",
                            f" Typ:    {truncate_end(get_file_type_desc(cur_item), max(3, w_right - 10))}",
                            f" Größe:  {format_size(cur_item.size)}",
                            f" Datum:  {format_mtime(cur_item.mtime)}",
                            f" Rechte: {cur_item.mode_str}",
                            f" nano:   Doppel-→",
                            f" Enter:  Öffnen (open)",
                        ]
                        if r < len(card):
                            cell_right = pad_visible(card[r], w_right)
                        else:
                            cell_right = " " * w_right
                else:
                    cell_right = " " * w_right

            # Zeile zusammensetzen
            if eff_cols == 1:
                row_line = f"│{cell_mid}│"
            elif eff_cols == 2:
                sep = "│" if use_inner_div else " "
                row_line = f"│{cell_left}{sep}{cell_mid}│"
            else:
                sep = "│" if use_inner_div else " "
                row_line = f"│{cell_left}{sep}{cell_mid}{sep}{cell_right}│"

            if visible_len(row_line) > term_cols:
                plain = ANSI_ESCAPE_RE.sub("", row_line)
                row_line = truncate_end(plain, term_cols)

            file_lines.append(row_line)

        # 8. Vollständigen Bildschirm zusammensetzen
        all_lines = [path_line, top_line] + file_lines + [bot_line]
        if show_status:
            all_lines.append(status_line)

        return all_lines[:term_rows]

    def handle_mouse_click(self, x: int, y: int, fd: Optional[int] = None, old_settings = None) -> bool:
        """Behandelt Mausklicks im TUI-Fenster mit Spaltenerkennung und Doppelklick-Unterstützung."""
        if not hasattr(self, "last_layout"):
            return False

        layout = self.last_layout
        hdr_count = layout.get("header_lines", 2)
        avail_rows = layout.get("avail_rows", 0)
        eff_cols = layout.get("eff_cols", 1)
        w_left = layout.get("w_left", 0)
        w_mid = layout.get("w_mid", 0)
        m_start = layout.get("m_start", 0)

        # Pfadzeile oben (y == 1)
        if y == 1:
            self.interactive_goto()
            return True

        file_row = (y - 1) - hdr_count

        if 0 <= file_row < avail_rows:
            col_x = x - 1  # 0-basiert

            if eff_cols >= 2 and 1 <= col_x <= w_left:
                # Klick in Eltern-Spalte: Zum übergeordneten Ordner wechseln
                self.go_parent_directory()
                return True

            elif eff_cols >= 2 and col_x == w_left + 1:
                return False

            elif (eff_cols == 1 and 1 <= col_x <= w_mid) or (eff_cols >= 2 and (w_left + 2) <= col_x <= (w_left + 1 + w_mid)):
                # Klick in aktuelle Spalte
                target_idx = m_start + file_row
                if 0 <= target_idx < len(self.items):
                    now = datetime.datetime.now().timestamp()
                    is_double_click = (
                        target_idx == self.selected_idx
                        and (now - self.last_click_time < 0.45)
                        and (self.last_click_idx == target_idx)
                    )
                    if is_double_click:
                        self.last_click_time = 0.0
                        self.last_click_idx = None
                        self.open_current()
                    else:
                        self.selected_idx = target_idx
                        self.last_click_time = now
                        self.last_click_idx = target_idx
                    return True

            elif eff_cols == 3 and col_x >= (w_left + w_mid + 3):
                # Klick in rechte Spalte
                cur_item = layout.get("cur_item")
                if cur_item and layout.get("is_cur_dir"):
                    child_items = layout.get("child_items", [])
                    self.change_directory(cur_item.path)
                    if 0 <= file_row < len(child_items):
                        self.selected_idx = file_row
                    return True
                elif cur_item and not layout.get("is_cur_dir"):
                    self.open_current()
                    return True

        return False

    def handle_mouse_right_click(self, x: int, y: int) -> bool:
        """Rechtsklick schaltet die Auswahl des angeklickten Elements um."""
        if not hasattr(self, "last_layout"):
            return False

        layout = self.last_layout
        hdr_count = layout.get("header_lines", 2)
        avail_rows = layout.get("avail_rows", 0)
        eff_cols = layout.get("eff_cols", 1)
        w_left = layout.get("w_left", 0)
        w_mid = layout.get("w_mid", 0)
        m_start = layout.get("m_start", 0)

        file_row = (y - 1) - hdr_count
        if 0 <= file_row < avail_rows:
            col_x = x - 1
            in_mid = False
            if eff_cols == 1:
                in_mid = (1 <= col_x <= w_mid)
            elif eff_cols >= 2:
                in_mid = ((w_left + 2) <= col_x <= (w_left + 1 + w_mid))

            if in_mid:
                target_idx = m_start + file_row
                if 0 <= target_idx < len(self.items):
                    self.selected_idx = target_idx
                    self.toggle_select()
                    return True
        return False

    def run(self):
        """Hauptschleife der TUI-Anwendung mit voller Maus- und Tastaturunterstützung."""
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            print("Fehler: EasyDateien erfordert ein interaktives Terminal.")
            sys.exit(1)

        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)

        try:
            signal.signal(signal.SIGWINCH, lambda s, f: None)
        except Exception:
            pass

        tty.setcbreak(fd, termios.TCSADRAIN)
        sys.stdout.write("\033[?1049h" + HIDE_CURSOR)

        mouse_enabled = self.config.get("mouse_support", True)
        if mouse_enabled:
            sys.stdout.write("\033[?1000h\033[?1006h")

        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        last_size = None
        needs_redraw = True

        try:
            while True:
                curr_size = shutil.get_terminal_size((80, 24))
                if curr_size != last_size:
                    last_size = curr_size
                    needs_redraw = True

                term_cols, term_rows = curr_size

                if needs_redraw:
                    lines = self.build_screen(term_cols, term_rows)
                    sys.stdout.write("\033[H")
                    for i, line in enumerate(lines):
                        if i == len(lines) - 1:
                            sys.stdout.write(f"\r\033[2K{line}")
                        else:
                            sys.stdout.write(f"\r\033[2K{line}\n")
                    sys.stdout.flush()
                    needs_redraw = False

                key = read_key(fd, timeout=0.05)
                if not key:
                    continue

                # Statusmeldung bei neuem Tastendruck zurücksetzen
                self.status_message = ""

                # Maus-Ereignisse verarbeiten
                if key == "MOUSE_WHEEL_UP":
                    if self.items:
                        self.selected_idx = max(0, self.selected_idx - 1)
                        needs_redraw = True
                    continue
                elif key == "MOUSE_WHEEL_DOWN":
                    if self.items:
                        self.selected_idx = min(len(self.items) - 1, self.selected_idx + 1)
                        needs_redraw = True
                    continue
                elif key.startswith("MOUSE_CLICK:"):
                    parts = key.split(":")
                    if len(parts) == 3:
                        try:
                            cx = int(parts[1])
                            cy = int(parts[2])
                            if self.handle_mouse_click(cx, cy, fd, old_settings):
                                needs_redraw = True
                        except Exception:
                            pass
                    continue
                elif key.startswith("MOUSE_RIGHT_CLICK:"):
                    parts = key.split(":")
                    if len(parts) == 3:
                        try:
                            cx = int(parts[1])
                            cy = int(parts[2])
                            if self.handle_mouse_right_click(cx, cy):
                                needs_redraw = True
                        except Exception:
                            pass
                    continue
                elif key.startswith("MOUSE_EVENT:"):
                    continue

                # Mehrschrittige Tastenfolgen (z.B. g d, g f, g i, c z)
                if self.pending_key_seq:
                    full_seq = self.pending_key_seq + key
                    self.pending_key_seq = ""

                    if full_seq == "gd":
                        self.change_directory(os.path.expanduser("~/Downloads"))
                        needs_redraw = True
                        continue
                    elif full_seq == "gf":
                        self.change_directory(os.path.expanduser("~/Documents"))
                        needs_redraw = True
                        continue
                    elif full_seq in ("gh", "g~"):
                        self.change_directory(os.path.expanduser("~"))
                        needs_redraw = True
                        continue
                    elif full_seq == "gi":
                        self.interactive_goto()
                        needs_redraw = True
                        continue
                    elif full_seq == "gp":
                        try:
                            res = subprocess.run(["pbpaste"], capture_output=True, text=True)
                            p = res.stdout.strip()
                            if os.path.isdir(p):
                                self.change_directory(p)
                            else:
                                self.status_message = f"Kein gültiger Pfad in der Zwischenablage: {p}"
                        except Exception:
                            self.status_message = "Konnte Zwischenablage nicht abfragen."
                        needs_redraw = True
                        continue
                    elif full_seq == "cz":
                        self.create_zip_archive()
                        needs_redraw = True
                        continue
                    elif full_seq == "zh":
                        self.toggle_hidden_files()
                        needs_redraw = True
                        continue

                if key in ("g",):
                    self.pending_key_seq = "g"
                    self.status_message = "[g...] (d: Downloads, f: Dokumente, h: Home, i: Pfad, p: Paste-Pfad)"
                    needs_redraw = True
                    continue

                # Keybindings aus Konfiguration prüfen
                kb = self.config.get("keybindings", DEFAULT_KEYMAP)

                # 1. Navigation Hoch
                if key in kb.get("up", ["UP", "k"]):
                    if self.items:
                        self.selected_idx = (self.selected_idx - 1) % len(self.items)
                        needs_redraw = True
                # 2. Navigation Runter
                elif key in kb.get("down", ["DOWN", "j"]):
                    if self.items:
                        self.selected_idx = (self.selected_idx + 1) % len(self.items)
                        needs_redraw = True
                # 3. Übergeordnetes Verzeichnis (Zurück)
                elif key in kb.get("left", ["LEFT", "h"]):
                    self.go_parent_directory()
                    needs_redraw = True
                # 4. Hineingehen (Ordner) oder bei Doppeldruck nano öffnen (Datei)
                elif key in kb.get("right", ["RIGHT", "l"]):
                    if self.items:
                        item = self.items[self.selected_idx]
                        if item.is_dir:
                            self.change_directory(item.path)
                            needs_redraw = True
                        else:
                            now = datetime.datetime.now().timestamp()
                            if (now - self.last_right_arrow_time < 0.45) and (self.last_right_arrow_path == item.path):
                                self.last_right_arrow_time = 0.0
                                self.last_right_arrow_path = ""
                                self.open_in_nano(item, fd, old_settings)
                                needs_redraw = True
                            else:
                                self.last_right_arrow_time = now
                                self.last_right_arrow_path = item.path
                                self.status_message = f"Rechts doppelt drücken, um „{item.name}“ in nano zu bearbeiten"
                                needs_redraw = True
                # 4b. Öffnen per Enter (System-Standardbefehl open)
                elif key in kb.get("open", ["ENTER"]):
                    self.open_current()
                    needs_redraw = True
                # 5. Markieren / Auswahl umschalten
                elif key in kb.get("select", ["SPACE", "v"]):
                    self.toggle_select()
                    needs_redraw = True
                # 6. Alle markieren / abwählen
                elif key in kb.get("select_all", ["V", "a"]):
                    self.toggle_select_all()
                    needs_redraw = True
                # 7. Ausschneiden (x)
                elif key in kb.get("cut", ["x"]):
                    self.cut_selection()
                    needs_redraw = True
                # 8. Kopieren (c)
                elif key in kb.get("copy", ["c"]):
                    self.copy_selection()
                    needs_redraw = True
                # 9. Einfügen (p)
                elif key in kb.get("paste", ["p"]):
                    self.paste_clipboard()
                    needs_redraw = True
                # 10. Papierkorb mit Sicherheitsdialog (d)
                elif key in kb.get("trash", ["d"]):
                    self.prompt_trash(fd)
                    needs_redraw = True
                # 11. Versteckte Dateien umschalten (./z)
                elif key in kb.get("toggle_hidden", [".", "z"]):
                    self.toggle_hidden_files()
                    needs_redraw = True
                # 12. Konfigurationsmenü öffnen (m/C)
                elif key in kb.get("config_menu", ["m", "C"]):
                    self.open_config_menu()
                    needs_redraw = True
                # 13. Beenden (q/ESC)
                elif key in kb.get("quit", ["q", "QUIT"]):
                    break
                elif key == "ESC":
                    if self.selected_paths:
                        self.selected_paths.clear()
                        self.status_message = "Auswahl aufgehoben."
                        needs_redraw = True
                    elif self.clipboard_mode:
                        self.clipboard_mode = None
                        self.clipboard_paths = []
                        self.status_message = "Zwischenspeicher geleert."
                        needs_redraw = True
                    else:
                        if self.config.get("esc_to_quit", False):
                            break
                        needs_redraw = True
                # Spezielle Sprungtasten
                elif key == "HOME":
                    self.selected_idx = 0
                    needs_redraw = True
                elif key == "END":
                    if self.items:
                        self.selected_idx = len(self.items) - 1
                        needs_redraw = True
                elif key == "PAGE_UP":
                    if self.items:
                        self.selected_idx = max(0, self.selected_idx - 10)
                        needs_redraw = True
                elif key == "PAGE_DOWN":
                    if self.items:
                        self.selected_idx = min(len(self.items) - 1, self.selected_idx + 10)
                        needs_redraw = True
                elif key == "~":
                    self.change_directory(os.path.expanduser("~"))
                    needs_redraw = True
                elif key in ("o",):
                    if self.items:
                        self.open_with_system(self.items[self.selected_idx])
                    needs_redraw = True
                elif key in ("e",):
                    if self.items:
                        p = self.items[self.selected_idx].path
                        subprocess.Popen(f'open -e "{p}"', shell=True)
                        self.status_message = f"In TextEdit geöffnet: {self.items[self.selected_idx].name}"
                        needs_redraw = True
                elif key in ("r",):
                    if self.items:
                        p = self.items[self.selected_idx].path
                        subprocess.Popen(f'open -R "{p}"', shell=True)
                        self.status_message = f"Im Finder gezeigt: {self.items[self.selected_idx].name}"
                        needs_redraw = True

        finally:
            if mouse_enabled:
                sys.stdout.write("\033[?1006l\033[?1000l")
                sys.stdout.flush()
            sys.stdout.write(SHOW_CURSOR)
            sys.stdout.write("\033[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def main():
    parser = argparse.ArgumentParser(
        prog="easydateien",
        description="EasyDateien — Minimalistischer, monochromer Terminal-Dateimanager für macOS.",
    )
    parser.add_argument("pfad", nargs="?", default=None, help="Startverzeichnis (Standard: aktuelles Verzeichnis)")
    parser.add_argument("-c", "--config", action="store_true", help="Interaktives Konfigurationsmenü direkt öffnen")
    parser.add_argument("-v", "--version", action="version", version="EasyDateien 1.0.0")

    args = parser.parse_args()

    if args.config:
        run_konfigurator()
        sys.exit(0)

    app = EasyDateienApp(initial_path=args.pfad)
    app.run()


if __name__ == "__main__":
    main()
