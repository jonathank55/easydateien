HOME_DIR = os.path.expanduser("~")
CONFIG_DIR = os.path.expanduser("~/.config/easydateien")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")

BOLD = "\033[1m"
ITALIC = "\033[3m"
RESET = "\033[0m"
CLEAR_LINE = "\033[2K"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"

ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")

def visible_len(text: str) -> int:
    return len(ANSI_ESCAPE_RE.sub("", text))

def truncate_end(text: str, max_w: int) -> str:
    if max_w <= 0:
        return ""
    plain = ANSI_ESCAPE_RE.sub("", text)
    if len(plain) <= max_w:
        return text
    if max_w <= 3:
        return plain[:max_w]
    return plain[:max_w - 3] + "..."

def pad_visible(text: str, width: int, align: str = "left") -> str:
    vlen = visible_len(text)
    if vlen > width:
        plain = ANSI_ESCAPE_RE.sub("", text)
        return truncate_end(plain, width)
    pad = " " * (width - vlen)
    if align == "right":
        return pad + text
    return text + pad

def format_size(size_bytes: int) -> str:
    if size_bytes < 1024:
        return f"{size_bytes} B"
    val = float(size_bytes)
    for unit in ["KB", "MB", "GB", "TB", "PB"]:
        val /= 1024.0
        if val < 1024.0 or unit == "PB":
            return f"{val:.1f} {unit}"
    return f"{val:.1f} PB"

def format_mtime(mtime: float) -> str:
    try:
        dt = datetime.datetime.fromtimestamp(mtime)
        now = datetime.datetime.now()
        if dt.year == now.year:
            return dt.strftime("%d. %b %H:%M")
        return dt.strftime("%d.%m.%Y")
    except Exception:
        return "---"

def sync_to_macos_clipboard(paths: List[str]):
    if not paths:
        return
    abs_paths = [os.path.abspath(p) for p in paths if os.path.exists(p)]
    if not abs_paths:
        return
    try:
        file_list = ", ".join([f'POSIX file "{p}"' for p in abs_paths])
        as_code = f'tell application "Finder" to set the clipboard to {{{file_list}}}'
        subprocess.run(["osascript", "-e", as_code], capture_output=True, text=True, timeout=2.0)
    except Exception:
        pass
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(input="\n".join(abs_paths).encode("utf-8"))
    except Exception:
        pass

def get_macos_clipboard_files() -> List[str]:
    js_code = """
    ObjC.import("AppKit");
    var pb = $.NSPasteboard.generalPasteboard;
    var classes = $.NSArray.arrayWithObject($.NSURL.class);
    var options = $.NSDictionary.dictionaryWithObjectForKey(
        $.NSNumber.numberWithBool(true),
        $.NSPasteboardURLReadingFileURLsOnlyKey
    );
    var urls = pb.readObjectsForClassesOptions(classes, options);
    var res = [];
    if (urls && urls.count > 0) {
        for (var i = 0; i < urls.count; i++) {
            res.push(ObjC.unwrap(urls.objectAtIndex(i).path));
        }
    }
    JSON.stringify(res);
    """
    try:
        proc = subprocess.run(["osascript", "-l", "JavaScript", "-e", js_code], capture_output=True, text=True, timeout=1.5)
        if proc.returncode == 0 and proc.stdout.strip():
            import json
            paths = json.loads(proc.stdout.strip())
            valid = [p for p in paths if os.path.exists(p)]
            if valid:
                return valid
    except Exception:
        pass
    try:
        out = subprocess.check_output(["pbpaste"], text=True)
        lines = [l.strip() for l in out.splitlines() if l.strip() and os.path.exists(l.strip())]
        if lines:
            return [l for l in lines if os.path.exists(l)]
    except Exception:
        pass
    return []

def copy_text_to_clipboard(text: str):
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass

class FileEntry:
    __slots__ = ("name", "path", "is_dir", "is_symlink", "size", "mtime", "ext", "mode_str")
    def __init__(self, path: str, name: str):
        self.path = path
        self.name = name
        self.is_dir = False
        self.is_symlink = os.path.islink(path)
        self.size = 0
        self.mtime = 0.0
        self.mode_str = "----------"
        _, self.ext = os.path.splitext(name)
        try:
            st = os.stat(path, follow_symlinks=False)
            self.mtime = st.st_mtime
            try:
                self.mode_str = stat.filemode(st.st_mode)
            except Exception:
                self.mode_str = "----------"
            if self.is_symlink:
                try:
                    self.is_dir = os.path.isdir(path)
                except Exception:
                    self.is_dir = False
            else:
                self.is_dir = stat.S_ISDIR(st.st_mode)
            self.size = st.st_size
        except Exception:
            pass

def get_file_type_desc(item: FileEntry) -> str:
    if item.is_dir:
        return "Ordner"
    ext = item.ext.lower()
    mapping = {
        ".txt": "Textdokument",
        ".md": "Markdown",
        ".py": "Python",
        ".sh": "Shell-Skript",
        ".json": "JSON",
        ".toml": "TOML",
        ".yaml": "YAML",
        ".yml": "YAML",
        ".pdf": "PDF",
        ".zip": "ZIP",
        ".png": "PNG-Bild",
        ".jpg": "JPEG-Bild",
        ".jpeg": "JPEG-Bild",
    }
    return mapping.get(ext, f"Datei ({ext})" if ext else "Binärdatei")

def scan_directory(path: str, show_hidden: bool = False, sort_by: str = "mtime", sort_reverse: bool = True, sort_dir_first: bool = True) -> List[FileEntry]:
    entries = []
    try:
        with os.scandir(path) as it:
            for entry in it:
                if not show_hidden and entry.name.startswith("."):
                    continue
                entries.append(FileEntry(entry.path, entry.name))
    except Exception:
        return []
    def sort_key(e: FileEntry):
        if sort_by == "name": return e.name.lower()
        elif sort_by == "size": return e.size
        elif sort_by == "ext": return e.ext.lower()
        return e.mtime
    entries.sort(key=sort_key, reverse=sort_reverse)
    if sort_dir_first:
        entries.sort(key=lambda e: not e.is_dir)
    return entries

def read_key(fd: int, timeout: float = 0.05) -> str:
    try:
        r, _, _ = select.select([fd], [], [], timeout)
        if not r:
            return ""
        raw = os.read(fd, 1)
        if not raw:
            return ""
        if raw == b"\x1b":
            seq = b""
            while True:
                r, _, _ = select.select([fd], [], [], 0.03)
                if not r: break
                c = os.read(fd, 1)
                if not c: break
                seq += c
                if seq.startswith(b"[<"):
                    if seq.endswith(b"M") or seq.endswith(b"m") or len(seq) >= 30: break
                elif len(seq) >= 2 and seq[-1:] in b"ABCDHFS~": break
                elif len(seq) >= 6: break
            if not seq:
                return "ESC"
            if seq.startswith(b"[<") and (seq.endswith(b"M") or seq.endswith(b"m")):
                try:
                    is_rel = seq.endswith(b"m")
                    b_str, x_str, y_str = seq[2:-1].decode("ascii").split(";")
                    b_c, x_p, y_p = int(b_str), int(x_str), int(y_str)
                    if b_c == 64: return "MOUSE_WHEEL_UP"
                    elif b_c == 65: return "MOUSE_WHEEL_DOWN"
                    elif not is_rel:
                        if b_c == 0: return f"MOUSE_CLICK:{x_p}:{y_p}"
                        elif b_c == 2: return f"MOUSE_RIGHT_CLICK:{x_p}:{y_p}"
                except Exception:
                    pass
                return "MOUSE_EVENT"
            mapping = {
                b"[A": "UP", b"[B": "DOWN", b"[C": "RIGHT", b"[D": "LEFT",
                b"[H": "HOME", b"[F": "END", b"[5~": "PAGE_UP", b"[6~": "PAGE_DOWN", b"[3~": "DELETE"
            }
            return mapping.get(seq, "ESC")
        if raw in (bytes([13]), bytes([10])):
            return "ENTER"
        elif raw == b"\t":
            return "TAB"
        elif raw in (bytes([127]), bytes([8])):
            return "BACKSPACE"
        elif raw in (bytes([3]), bytes([4])):
            return "QUIT"
        if raw[0] >= 0xC0:
            needed = 2 if raw[0] < 0xE0 else (3 if raw[0] < 0xF0 else 4)
            ch_bytes = raw
            while len(ch_bytes) < needed:
                r, _, _ = select.select([fd], [], [], 0.03)
                if not r: break
                ch_bytes += os.read(fd, 1)
            try: return ch_bytes.decode("utf-8")
            except Exception: return ""
        try: return raw.decode("utf-8")
        except Exception: return ""
    except Exception:
        return ""

class EasyDateienApp:
    def __init__(self, initial_path: Optional[str] = None):
        self.current_dir = os.path.abspath(initial_path if initial_path else os.getcwd())
        self.config = self.load_config()
        self.items: List[FileEntry] = []
        self.selected_idx: int = 0
        self.selected_paths: Set[str] = set()
        self.clipboard_paths: List[str] = []
        self.clipboard_mode: Optional[str] = None
        self.status_message: str = ""
        self.status_expiry_moves: int = 0
        self.last_click_time: float = 0.0
        self.last_click_idx: Optional[int] = None
        self.last_right_arrow_time: float = 0.0
        self.last_right_arrow_path: str = ""
        self.last_layout: Dict = {}
        self.show_console: bool = self.config.get("show_console", False)
        self.console_position: str = self.config.get("console_position", "unten").lower()
        self.console_focused: bool = False
        self.console_input: str = ""
        self.console_cursor_idx: int = 0
        self.console_output_lines: List[str] = []
        self.console_cmd_history: List[str] = []
        self.console_history_idx: int = 0
        self.console_scroll_offset: int = 0
        self.cached_parent_dir: Optional[str] = None
        self.cached_parent_items: List[FileEntry] = []
        self.cached_parent_mtime: float = -1.0
        self.cached_child_path: Optional[str] = None
        self.cached_child_items: List[FileEntry] = []
        self.cached_child_mtime: float = -1.0
        self.refresh_items()

    def load_config(self) -> dict:
        cfg = {
            "divider_style": "alle", "columns_enabled": True, "show_controls": False,
            "esc_to_quit": False, "mouse_support": True, "show_console": False,
            "console_position": "unten", "text_editor": "nano %s", "opener": "open %s",
            "sort_by": "mtime", "sort_reverse": True, "sort_dir_first": True,
        }
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    cfg.update(json.load(f))
            except Exception: pass
        return cfg

    def refresh_items(self):
        self.cached_parent_dir = None
        self.cached_child_path = None
        self.items = scan_directory(
            self.current_dir,
            show_hidden=self.config.get("show_hidden", False),
            sort_by=self.config.get("sort_by", "mtime"),
            sort_reverse=self.config.get("sort_reverse", True),
            sort_dir_first=self.config.get("sort_dir_first", True),
        )
        if self.selected_idx >= len(self.items):
            self.selected_idx = max(0, len(self.items) - 1)

    def change_directory(self, new_path: str):
        if os.path.isdir(new_path):
            self.current_dir = os.path.abspath(new_path)
            self.selected_idx = 0
            self.refresh_items()

    def go_parent_directory(self):
        parent = os.path.dirname(self.current_dir)
        if parent and parent != self.current_dir:
            prev_name = os.path.basename(self.current_dir)
            self.current_dir = parent
            self.refresh_items()
            for i, it in enumerate(self.items):
                if it.name == prev_name:
                    self.selected_idx = i
                    break

    def open_with_system(self, item: FileEntry):
        opener = self.config.get("opener", "open %s")
        cmd = opener.replace("%s", f'"{item.path}"')
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
            self.status_message = f"Geöffnet: {item.name}"
            self.status_expiry_moves = 0
        except Exception as e:
            self.status_message = f"Fehler: {e}"
            self.status_expiry_moves = 0

    def open_in_nano(self, item: FileEntry, fd: Optional[int], old_settings):
        if fd is not None and old_settings is not None:
            mouse_on = self.config.get("mouse_support", True)
            if mouse_on: sys.stdout.write("\033[?1006l\033[?1000l"); sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            sys.stdout.write(SHOW_CURSOR + "\033[?1049l"); sys.stdout.flush()
            editor_cmd = self.config.get("text_editor", "nano %s").replace("%s", f'"{item.path}"')
            try: subprocess.run(editor_cmd, shell=True)
            finally:
                tty.setcbreak(fd, termios.TCSADRAIN)
                sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                if mouse_on: sys.stdout.write("\033[?1000h\033[?1006h")
                sys.stdout.write("\033[2J\033[H"); sys.stdout.flush()
                self.refresh_items()

    def toggle_select(self):
        if not self.items: return
        item = self.items[self.selected_idx]
        if item.path in self.selected_paths:
            self.selected_paths.remove(item.path)
            self.status_message = f"Auswahl: {len(self.selected_paths)}" if self.selected_paths else "Auswahl aufgehoben"
        else:
            self.selected_paths.add(item.path)
            if item.path in self.clipboard_paths:
                self.clipboard_paths.remove(item.path)
            self.status_message = f"Auswahl: {len(self.selected_paths)}"
        self.status_expiry_moves = 0
        if self.selected_idx < len(self.items) - 1:
            self.selected_idx += 1

    def toggle_select_all(self):
        all_paths = {it.path for it in self.items}
        if not all_paths: return
        if self.selected_paths.issuperset(all_paths):
            self.selected_paths.clear()
            self.status_message = "Auswahl aufgehoben"
        else:
            self.selected_paths.update(all_paths)
            self.status_message = f"Alle {len(self.selected_paths)} markiert"
        self.status_expiry_moves = 0

    def cut_selection(self):
        if not self.items: return
        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        self.clipboard_mode = "cut"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        sync_to_macos_clipboard(targets)
        self.status_message = f"{len(targets)} ausgeschnitten"
        self.status_expiry_moves = 0

    def copy_selection(self):
        if not self.items: return
        targets = list(self.selected_paths) if self.selected_paths else [self.items[self.selected_idx].path]
        self.clipboard_mode = "copy"
        self.clipboard_paths = targets
        self.selected_paths.clear()
        sync_to_macos_clipboard(targets)
        self.status_message = f"{len(targets)} kopiert"
        self.status_expiry_moves = 0

    def paste_clipboard(self):
        sources = list(self.clipboard_paths) if self.clipboard_paths else get_macos_clipboard_files()
        if not sources:
            self.status_message = "Zwischenablage leer"
            self.status_expiry_moves = 0
            return
        success = 0
        last_name = ""
        for src in sources:
            if not os.path.exists(src): continue
            name = os.path.basename(src)
            dest = os.path.join(self.current_dir, name)
            if os.path.abspath(src) == os.path.abspath(dest):
                if self.clipboard_mode == "cut": continue
                base, ext = os.path.splitext(name)
                c = 1
                while os.path.exists(dest):
                    dest = os.path.join(self.current_dir, f"{base} ({c}){ext}")
                    c += 1
            try:
                if self.clipboard_mode == "cut": shutil.move(src, dest)
                else:
                    if os.path.isdir(src): shutil.copytree(src, dest)
                    else: shutil.copy2(src, dest)
                success += 1
                last_name = os.path.basename(dest)
            except Exception: pass
        if self.clipboard_mode == "cut":
            self.clipboard_mode = None
            self.clipboard_paths = []
        self.refresh_items()
        if last_name:
            for i, it in enumerate(self.items):
                if it.name == last_name: self.selected_idx = i; break
        self.status_message = f"{success} eingefügt"
        self.status_expiry_moves = 0

    def prompt_trash(self, fd: int):
        targets = list(self.selected_paths) if self.selected_paths else ([self.items[self.selected_idx].path] if self.items else [])
        if not targets: return
        sys.stdout.write(f"\r{CLEAR_LINE}{BOLD}{len(targets)} Elemente in Papierkorb verschieben? (y/N): {RESET}")
        sys.stdout.flush()
        ans = read_key(fd, timeout=10.0)
        if ans.lower() in ("y", "j"):
            count = 0
            for t in targets:
                try:
                    res = subprocess.run(["trash", t], capture_output=True)
                    if res.returncode == 0: count += 1
                    else:
                        as_del = f'tell application "Finder" to delete (POSIX file "{os.path.abspath(t)}" as alias)'
                        subprocess.run(["osascript", "-e", as_del], capture_output=True)
                        count += 1
                except Exception: pass
            self.selected_paths.clear()
            self.refresh_items()
            self.status_message = f"{count} gelöscht"
        else:
            self.status_message = "Löschen abgebrochen"
        self.status_expiry_moves = 0

    def create_zip_archive(self):
        targets = list(self.selected_paths) if self.selected_paths else ([self.items[self.selected_idx].path] if self.items else [])
        if not targets: return
        base_name = os.path.basename(targets[0]) if len(targets) == 1 else f"Archiv_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}"
        dest = os.path.join(self.current_dir, f"{base_name}.zip")
        c = 1
        while os.path.exists(dest):
            dest = os.path.join(self.current_dir, f"{base_name} ({c}).zip")
            c += 1
        try:
            with zipfile.ZipFile(dest, "w", zipfile.ZIP_DEFLATED) as zf:
                for t in targets:
                    if os.path.isdir(t):
                        for root, _, files in os.walk(t):
                            for f in files:
                                fp = os.path.join(root, f)
                                zf.write(fp, os.path.relpath(fp, self.current_dir))
                    else:
                        zf.write(t, os.path.basename(t))
            self.selected_paths.clear()
            self.refresh_items()
            self.status_message = f"ZIP erstellt: {os.path.basename(dest)}"
        except Exception as e:
            self.status_message = f"Fehler: {e}"
        self.status_expiry_moves = 0

    def get_short_dir(self, path: str) -> str:
        if path == HOME_DIR: return "~"
        if path.startswith(HOME_DIR + "/"): return "~" + path[len(HOME_DIR):]
        return path

    def get_console_display_lines(self, width: int, height: int) -> List[str]:
        if height <= 0 or width <= 0: return []
        prompt = f"{self.get_short_dir(self.current_dir)} $ "
        if visible_len(prompt) > width - 4: prompt = "$ "
        avail = max(1, width - visible_len(prompt))
        inp = self.console_input
        inp_show = inp[-avail:] if len(inp) > avail else inp
        cursor_char = " " if not self.console_focused else "\033[7m \033[0m"
        prompt_line = pad_visible(f"{prompt}{inp_show}{cursor_char}", width)
        out = []
        needed = height - 1
        if needed > 0:
            start = max(0, len(self.console_output_lines) - needed - self.console_scroll_offset)
            chunk = self.console_output_lines[start : start + needed]
            for l in chunk:
                out.append(pad_visible(truncate_end(l, width), width))
            while len(out) < needed: out.insert(0, " " * width)
        out.append(prompt_line)
        return out

    def run_console_command(self, cmd: str, fd: Optional[int], old_settings):
        cmd = cmd.strip()
        self.console_input = ""
        self.console_cursor_idx = 0
        if not cmd: return
        self.console_cmd_history.append(cmd)
        self.console_output_lines.append(f"$ {cmd}")
        if cmd in ("exit", "quit"):
            self.show_console = False
            self.console_focused = False
            return
        if cmd == "clear":
            self.console_output_lines.clear()
            return
        if cmd.startswith("cd ") or cmd == "cd":
            target = cmd[3:].strip() if len(cmd) > 3 else HOME_DIR
            target = os.path.expanduser(target)
            target = os.path.join(self.current_dir, target)
            if os.path.isdir(target): self.change_directory(target)
            else: self.console_output_lines.append(f"cd: Verzeichnis nicht gefunden: {target}")
            return
        try:
            res = subprocess.run(cmd, shell=True, cwd=self.current_dir, capture_output=True, text=True, timeout=10.0)
            if res.stdout:
                for l in res.stdout.splitlines(): self.console_output_lines.append(l)
            if res.stderr:
                for l in res.stderr.splitlines(): self.console_output_lines.append(l)
        except Exception as e:
            self.console_output_lines.append(f"Fehler: {e}")
        self.refresh_items()

    def toggle_console(self):
        self.show_console = not self.show_console
        self.console_focused = self.show_console
        self.status_message = "Konsole geöffnet" if self.show_console else "Konsole geschlossen"
        self.status_expiry_moves = 0

    def get_effective_columns(self, term_cols: int) -> int:
        if not self.config.get("columns_enabled", True): return 1
        if term_cols >= 68: return 3
        if term_cols >= 38: return 2
        return 1

    def build_screen(self, term_cols: int, term_rows: int) -> List[str]:
        disp_path = self.get_short_dir(self.current_dir)
        total_items = len(self.items)
        cur_idx_str = f"{self.selected_idx + 1}/{total_items}" if total_items > 0 else "0/0"
        msg_str = f" [{self.status_message}]" if self.status_message else ""
        right_header = f"{msg_str}  {cur_idx_str}".strip() if msg_str else cur_idx_str
        if term_cols > visible_len(right_header) + 3:
            avail_p = term_cols - visible_len(right_header) - 1
            path_trunc = truncate_end(disp_path, avail_p)
            path_line = pad_visible(path_trunc, term_cols - visible_len(right_header)) + right_header
        else:
            path_line = pad_visible(truncate_end(disp_path, term_cols), term_cols)

        if term_rows <= 1: return [path_line]
        cur_item = self.items[self.selected_idx] if (self.items and 0 <= self.selected_idx < total_items) else None
        cur_name = (cur_item.name + ("/" if cur_item.is_dir else "")) if cur_item else ""
        if term_rows == 2:
            return [path_line, pad_visible(truncate_end(cur_name, term_cols), term_cols)]

        show_controls = self.config.get("show_controls", False)
        has_status_bar = show_controls and (term_rows >= 6)
        div_style = self.config.get("divider_style", "alle").lower()
        if div_style not in ("alle", "vertikal", "außen", "horizontal", "keine"):
            div_style = "alle"

        has_top_border = (div_style in ("alle", "vertikal", "außen", "horizontal")) and (term_rows >= 4)
        has_bottom_border = (div_style in ("alle", "vertikal", "außen", "horizontal")) and (term_rows >= 4)

        consumed = 1
        if has_top_border: consumed += 1
        if has_bottom_border: consumed += 1
        if has_status_bar: consumed += 1

        avail_total = max(1, term_rows - consumed)
        header_lines = 1 + (1 if has_top_border else 0)

        active_console = self.show_console
        console_pos = self.config.get("console_position", "unten").lower()
        if console_pos not in ("unten", "rechts", "links"): console_pos = "unten"
        if active_console and console_pos in ("rechts", "links") and term_cols < 60: console_pos = "unten"

        if active_console and console_pos == "unten" and avail_total >= 4:
            console_h = max(2, min(8, avail_total // 3))
            fm_rows = avail_total - console_h - 1
        else:
            console_h = 0
            fm_rows = avail_total

        eff_cols = self.get_effective_columns(term_cols)

        if div_style in ("alle", "vertikal"):
            if eff_cols == 3:
                avail = max(10, term_cols - 4)
                w_left = max(6, int(avail * 0.18))
                w_right = max(10, int(avail * 0.28))
                w_mid = avail - w_left - w_right
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}┬{'─' * w_right}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}╯"
                mid_sep  = f"├{'─' * w_left}┴{'─' * w_mid}┴{'─' * w_right}┤"
            elif eff_cols == 2:
                avail = max(8, term_cols - 3)
                w_left = max(6, int(avail * 0.25))
                w_right = 0
                w_mid = avail - w_left
                top_line = f"╭{'─' * w_left}┬{'─' * w_mid}╮"
                bot_line = f"╰{'─' * w_left}┴{'─' * w_mid}╯"
                mid_sep  = f"├{'─' * w_left}┴{'─' * w_mid}┤"
            else:
                w_mid = max(4, term_cols - 2)
                w_left = 0
                w_right = 0
                top_line = f"╭{'─' * w_mid}╮"
                bot_line = f"╰{'─' * w_mid}╯"
                mid_sep  = f"├{'─' * w_mid}┤"
        elif div_style == "außen":
            inner_w = max(4, term_cols - 2)
            top_line = f"╭{'─' * inner_w}╮"
            bot_line = f"╰{'─' * inner_w}╯"
            mid_sep  = f"├{'─' * inner_w}┤"
            if eff_cols == 3:
                avail = max(10, inner_w - 4)
                w_left = max(6, int(avail * 0.18))
                w_right = max(10, int(avail * 0.28))
                w_mid = avail - w_left - w_right
            elif eff_cols == 2:
                avail = max(8, inner_w - 2)
                w_left = max(6, int(avail * 0.25))
                w_right = 0
                w_mid = avail - w_left
            else:
                w_mid = inner_w
                w_left = 0
                w_right = 0
        elif div_style == "horizontal":
            top_line = "─" * term_cols
            bot_line = "─" * term_cols
            mid_sep  = "─" * term_cols
            if eff_cols == 3:
                avail = max(10, term_cols - 4)
                w_left = max(6, int(avail * 0.18))
                w_right = max(10, int(avail * 0.28))
                w_mid = avail - w_left - w_right
            elif eff_cols == 2:
                avail = max(8, term_cols - 2)
                w_left = max(6, int(avail * 0.25))
                w_right = 0
                w_mid = avail - w_left
            else:
                w_mid = term_cols
                w_left = 0
                w_right = 0
        else:
            top_line = ""
            bot_line = ""
            mid_sep  = ""
            if eff_cols == 3:
                avail = max(10, term_cols - 4)
                w_left = max(6, int(avail * 0.18))
                w_right = max(10, int(avail * 0.28))
                w_mid = avail - w_left - w_right
            elif eff_cols == 2:
                avail = max(8, term_cols - 2)
                w_left = max(6, int(avail * 0.25))
                w_right = 0
                w_mid = avail - w_left
            else:
                w_mid = term_cols
                w_left = 0
                w_right = 0

        parent_items = []
        cur_p_idx = 0
        if eff_cols >= 2 and not (active_console and console_pos == "links"):
            parent_path = os.path.dirname(self.current_dir)
            if parent_path != self.current_dir:
                try: p_mtime = os.path.getmtime(parent_path)
                except Exception: p_mtime = 0.0
                if self.cached_parent_dir == parent_path and self.cached_parent_mtime == p_mtime:
                    parent_items = self.cached_parent_items
                else:
                    parent_items = scan_directory(parent_path, show_hidden=self.config.get("show_hidden", False))
                    self.cached_parent_dir = parent_path
                    self.cached_parent_mtime = p_mtime
                    self.cached_parent_items = parent_items
                for i, pit in enumerate(parent_items):
                    if os.path.abspath(pit.path) == os.path.abspath(self.current_dir):
                        cur_p_idx = i; break

        p_start = 0 if len(parent_items) <= fm_rows else max(0, min(cur_p_idx - fm_rows // 2, len(parent_items) - fm_rows))
        m_start = 0 if total_items <= fm_rows else max(0, min(self.selected_idx - fm_rows // 2, total_items - fm_rows))

        child_items = []
        is_cur_dir = bool(cur_item and cur_item.is_dir)
        if eff_cols == 3 and cur_item and is_cur_dir and not (active_console and console_pos == "rechts"):
            try: c_mtime = os.path.getmtime(cur_item.path)
            except Exception: c_mtime = 0.0
            if self.cached_child_path == cur_item.path and self.cached_child_mtime == c_mtime:
                child_items = self.cached_child_items
            else:
                child_items = scan_directory(cur_item.path, show_hidden=self.config.get("show_hidden", False))
                self.cached_child_path = cur_item.path
                self.cached_child_mtime = c_mtime
                self.cached_child_items = child_items

        self.last_layout = {
            "header_lines": header_lines, "avail_rows": fm_rows, "eff_cols": eff_cols,
            "div_style": div_style, "w_left": w_left, "w_mid": w_mid, "w_right": w_right,
            "m_start": m_start, "p_start": p_start, "active_console": active_console,
            "console_pos": console_pos if active_console else None,
            "split_row": (header_lines + fm_rows) if (active_console and console_pos == "unten" and console_h > 0) else -1,
            "child_items": child_items, "cur_item": cur_item, "is_cur_dir": is_cur_dir,
        }

        if active_console and console_pos == "rechts":
            c_right_lines = self.get_console_display_lines(w_right, fm_rows)
        else: c_right_lines = []
        if active_console and console_pos == "links":
            c_left_lines = self.get_console_display_lines(w_left, fm_rows)
        else: c_left_lines = []

        file_lines = []
        for r in range(fm_rows):
            if active_console and console_pos == "links":
                cell_left = c_left_lines[r] if r < len(c_left_lines) else " " * w_left
            elif eff_cols >= 2:
                p_idx = p_start + r
                if p_idx < len(parent_items):
                    p_it = parent_items[p_idx]
                    is_act = (os.path.abspath(p_it.path) == os.path.abspath(self.current_dir))
                    p_name = p_it.name + ("/" if p_it.is_dir else "")
                    prefix = "▸ " if is_act else "  "
                    p_trunc = truncate_end(p_name, max(2, w_left - 3))
                    txt_l = f" {BOLD}{prefix}{p_trunc}{RESET}" if is_act else f" {prefix}{p_trunc}"
                    cell_left = pad_visible(txt_l, w_left)
                else:
                    cell_left = " " * w_left
            else:
                cell_left = ""

            m_idx = m_start + r
            if m_idx < len(self.items):
                it = self.items[m_idx]
                is_cur = (m_idx == self.selected_idx)
                is_sel = it.path in self.selected_paths
                in_cut = (self.clipboard_mode == "cut" and it.path in self.clipboard_paths)
                in_copy = (self.clipboard_mode == "copy" and it.path in self.clipboard_paths)
                c_part = "▸ " if is_cur else "  "
                b_part = "* " if is_sel else ("× " if in_cut else ("+ " if in_copy else "  "))
                prefix_str = f"{c_part}{b_part}"
                prefix_len = 4
                name_disp = it.name + ("/" if it.is_dir else "")
                s_str = format_size(it.size) if not it.is_dir else ""
                if w_mid >= 26:
                    avail_n = max(3, w_mid - prefix_len - 10)
                    n_trunc = truncate_end(name_disp, avail_n)
                    s_part = f"  {s_str:>8}" if s_str else " " * 10
                    l_part = f"{prefix_str}{n_trunc}"
                    if is_cur: l_part = f"{BOLD}{l_part}{RESET}"
                    cell_mid = pad_visible(l_part, w_mid - 10) + s_part
                else:
                    avail_n = max(2, w_mid - prefix_len)
                    n_trunc = truncate_end(name_disp, avail_n)
                    l_part = f"{prefix_str}{n_trunc}"
                    if is_cur: l_part = f"{BOLD}{l_part}{RESET}"
                    cell_mid = pad_visible(l_part, w_mid)
            elif len(self.items) == 0 and r == 0:
                cell_mid = pad_visible(f"  {ITALIC}(leer){RESET}", w_mid)
            else:
                cell_mid = " " * w_mid

            if active_console and console_pos == "rechts":
                cell_right = c_right_lines[r] if r < len(c_right_lines) else " " * w_right
            elif eff_cols == 3:
                if cur_item and is_cur_dir:
                    if r < len(child_items):
                        c_it = child_items[r]
                        c_name = c_it.name + ("/" if c_it.is_dir else "")
                        c_size = format_size(c_it.size) if not c_it.is_dir else ""
                        if w_right >= 22 and c_size:
                            avail_c = max(3, w_right - 2 - 10)
                            c_trunc = truncate_end(c_name, avail_c)
                            cell_right = pad_visible(f"  {c_trunc}", w_right - 10) + f"  {c_size:>8}"
                        else:
                            avail_c = max(3, w_right - 3)
                            c_trunc = truncate_end(c_name, avail_c)
                            cell_right = pad_visible(f"  {c_trunc}", w_right)
                    elif len(child_items) == 0 and r == 0:
                        cell_right = pad_visible(f"  {ITALIC}(leer){RESET}", w_right)
                    else:
                        cell_right = " " * w_right
                elif cur_item and not is_cur_dir:
                    card = [
                        f" {BOLD}Details{RESET}",
                        f" Typ:    {truncate_end(get_file_type_desc(cur_item), max(3, w_right - 10))}",
                        f" Größe:  {format_size(cur_item.size)}",
                        f" Datum:  {format_mtime(cur_item.mtime)}",
                        f" Rechte: {cur_item.mode_str}",
                    ]
                    if cur_item.is_symlink:
                        try: card.append(f" Link:   {truncate_end(os.readlink(cur_item.path), max(3, w_right - 10))}")
                        except Exception: pass
                    cell_right = pad_visible(card[r], w_right) if r < len(card) else " " * w_right
                else:
                    cell_right = " " * w_right
            else:
                cell_right = ""

            if div_style in ("alle", "vertikal"):
                if eff_cols == 3:
                    row_line = f"│{cell_left}│{cell_mid}│{cell_right}│"
                elif eff_cols == 2:
                    if active_console and console_pos == "rechts":
                        row_line = f"│{cell_mid}│{cell_right}│"
                    else:
                        row_line = f"│{cell_left}│{cell_mid}│"
                else:
                    row_line = f"│{cell_mid}│"
            elif div_style == "außen":
                if eff_cols == 3:
                    row_line = f"│{cell_left}  {cell_mid}  {cell_right}│"
                elif eff_cols == 2:
                    row_line = f"│{cell_left}  {cell_mid}│"
                else:
                    row_line = f"│{cell_mid}│"
            else:
                if eff_cols == 3:
                    row_line = f"{cell_left}  {cell_mid}  {cell_right}"
                elif eff_cols == 2:
                    row_line = f"{cell_left}  {cell_mid}"
                else:
                    row_line = f"{cell_mid}"

            file_lines.append(pad_visible(row_line, term_cols))

        all_lines = [path_line]
        if has_top_border and top_line:
            all_lines.append(pad_visible(top_line, term_cols))
        all_lines.extend(file_lines)

        if active_console and console_pos == "unten" and console_h > 0:
            all_lines.append(pad_visible(mid_sep, term_cols))
            inner_cw = max(4, term_cols - 2 if div_style in ("alle", "vertikal", "außen") else term_cols)
            c_lines = self.get_console_display_lines(inner_cw, console_h)
            for cl in c_lines:
                if div_style in ("alle", "vertikal", "außen"):
                    all_lines.append(f"│{cl}│")
                else:
                    all_lines.append(cl)

        if has_bottom_border and bot_line:
            all_lines.append(pad_visible(bot_line, term_cols))

        if has_status_bar:
            if self.show_console and self.console_focused:
                mode_lbl = "TERM"
            elif self.selected_paths:
                mode_lbl = f"SEL {len(self.selected_paths)}"
            elif self.clipboard_mode == "cut":
                mode_lbl = f"CUT {len(self.clipboard_paths)}" if len(self.clipboard_paths) > 1 else "CUT"
            elif self.clipboard_mode == "copy":
                mode_lbl = f"CPY {len(self.clipboard_paths)}" if len(self.clipboard_paths) > 1 else "CPY"
            else:
                mode_lbl = "NOR"

            left_b = f" {BOLD}{mode_lbl}{RESET}  "
            if self.status_message:
                st_line = pad_visible(f"{left_b}{self.status_message}", term_cols)
            else:
                ctrl = "[↑↓] Nav  [Enter] open  [→] In (Doppel-→ nano)  [←] Zurück  [y/c] Copy  [x] Cut  [p] Paste  [t] Konsole  [q] Ende"
                st_line = pad_visible(f"{left_b}{truncate_end(ctrl, max(1, term_cols - visible_len(left_b)))}", term_cols)
            all_lines.append(st_line)

        return all_lines[:term_rows]

    def handle_mouse_click(self, x: int, y: int) -> bool:
        if not self.last_layout: return False
        layout = self.last_layout
        hdr_count = layout.get("header_lines", 2)
        avail_rows = layout.get("avail_rows", 0)
        eff_cols = layout.get("eff_cols", 1)
        w_left = layout.get("w_left", 0)
        w_mid = layout.get("w_mid", 0)
        m_start = layout.get("m_start", 0)
        active_console = layout.get("active_console", False)
        console_pos = layout.get("console_pos", "unten")
        split_row = layout.get("split_row", -1)

        if y == 1: return True

        if active_console and console_pos == "unten" and split_row > 0:
            if y > split_row:
                self.console_focused = True
                return True
            else:
                self.console_focused = False

        file_row = (y - 1) - hdr_count
        if 0 <= file_row < avail_rows:
            col_x = x - 1
            if active_console and console_pos == "rechts" and col_x >= (w_left + w_mid + 2):
                self.console_focused = True; return True
            elif active_console and console_pos == "links" and col_x <= w_left:
                self.console_focused = True; return True

            self.console_focused = False
            in_left = (eff_cols >= 2 and col_x <= w_left)
            in_mid = (eff_cols == 1 and col_x <= w_mid) or (eff_cols >= 2 and (w_left + 1) <= col_x <= (w_left + 1 + w_mid))
            in_right = (eff_cols == 3 and col_x >= (w_left + w_mid + 2))

            if in_left and not (active_console and console_pos == "links"):
                self.go_parent_directory()
                return True
            elif in_mid:
                target_idx = m_start + file_row
                if 0 <= target_idx < len(self.items):
                    now = datetime.datetime.now().timestamp()
                    is_double = (now - self.last_click_time < 0.45) and (self.last_click_idx == target_idx)
                    self.selected_idx = target_idx
                    if is_double:
                        self.last_click_time = 0.0
                        self.last_click_idx = None
                        self.open_with_system(self.items[target_idx])
                    else:
                        self.last_click_time = now
                        self.last_click_idx = target_idx
                    return True
            elif in_right and not (active_console and console_pos == "rechts"):
                cur_item = layout.get("cur_item")
                if cur_item and layout.get("is_cur_dir"):
                    child_items = layout.get("child_items", [])
                    if 0 <= file_row < len(child_items):
                        self.change_directory(cur_item.path)
                        self.selected_idx = file_row
                        return True
                elif cur_item and not layout.get("is_cur_dir"):
                    self.open_with_system(cur_item)
                    return True
        return False

    def handle_mouse_right_click(self, x: int, y: int) -> bool:
        if not self.last_layout: return False
        layout = self.last_layout
        hdr_count = layout.get("header_lines", 2)
        avail_rows = layout.get("avail_rows", 0)
        m_start = layout.get("m_start", 0)
        file_row = (y - 1) - hdr_count
        if 0 <= file_row < avail_rows:
            target_idx = m_start + file_row
            if 0 <= target_idx < len(self.items):
                self.selected_idx = target_idx
                self.toggle_select()
                return True
        return False

    def run(self):
        if not sys.stdin.isatty():
            print("EasyDateien erfordert ein interaktives Terminal.")
            return

        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try: signal.signal(signal.SIGWINCH, lambda s, f: None)
        except Exception: pass

        tty.setcbreak(fd, termios.TCSADRAIN)
        sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
        mouse_enabled = self.config.get("mouse_support", True)
        if mouse_enabled: sys.stdout.write("\033[?1000h\033[?1006h")
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        last_size = None
        needs_redraw = True

        try:
            while True:
                curr_size = shutil.get_terminal_size((80, 24))
                term_cols, term_rows = curr_size.columns, curr_size.lines
                if curr_size != last_size:
                    last_size = curr_size
                    needs_redraw = True

                if needs_redraw:
                    lines = self.build_screen(term_cols, term_rows)
                    sys.stdout.write("\033[H")
                    for i, line in enumerate(lines):
                        if i == len(lines) - 1: sys.stdout.write(f"\r\033[2K{line}")
                        else: sys.stdout.write(f"\r\033[2K{line}\n")
                    sys.stdout.flush()
                    needs_redraw = False

                key = read_key(fd, timeout=0.05)
                if not key: continue

                if key in ("UP", "DOWN", "k", "j", "PAGE_UP", "PAGE_DOWN"):
                    if not (self.show_console and self.console_focused):
                        self.status_expiry_moves += 1
                        if self.status_expiry_moves >= 3: self.status_message = ""

                if key == "MOUSE_WHEEL_UP":
                    if self.show_console and self.console_focused: self.console_scroll_offset += 2
                    elif self.items: self.selected_idx = max(0, self.selected_idx - 1)
                    needs_redraw = True; continue
                elif key == "MOUSE_WHEEL_DOWN":
                    if self.show_console and self.console_focused: self.console_scroll_offset = max(0, self.console_scroll_offset - 2)
                    elif self.items: self.selected_idx = min(len(self.items) - 1, self.selected_idx + 1)
                    needs_redraw = True; continue
                elif key.startswith("MOUSE_CLICK:"):
                    p = key.split(":")
                    if len(p) == 3:
                        cx, cy = int(p[1]), int(p[2])
                        if self.handle_mouse_click(cx, cy): needs_redraw = True
                    continue
                elif key.startswith("MOUSE_RIGHT_CLICK:"):
                    p = key.split(":")
                    if len(p) == 3:
                        cx, cy = int(p[1]), int(p[2])
                        if self.handle_mouse_right_click(cx, cy): needs_redraw = True
                    continue

                # ESC & Konsole
                if key == "ESC":
                    if self.show_console:
                        self.show_console = False
                        self.console_focused = False
                        self.status_message = "Konsole geschlossen"
                        self.status_expiry_moves = 0
                        needs_redraw = True
                        continue
                    if self.selected_paths:
                        self.selected_paths.clear()
                        self.status_message = "Auswahl aufgehoben"
                        self.status_expiry_moves = 0
                        needs_redraw = True
                        continue
                    elif self.clipboard_mode or self.clipboard_paths:
                        self.clipboard_mode = None
                        self.clipboard_paths = []
                        self.status_message = "Zwischenspeicher geleert"
                        self.status_expiry_moves = 0
                        needs_redraw = True
                        continue
                    elif self.config.get("esc_to_quit", False):
                        break
                    continue

                # Eingaben bei fokussierter Konsole (ESC ist der einzige Weg, die Konsole zu schließen)
                if self.show_console and self.console_focused:
                    if key == "ENTER":
                        self.run_console_command(self.console_input, fd, old_settings)
                        needs_redraw = True
                    elif key == "TAB":
                        self.console_focused = False
                        self.status_message = "Fokus: Dateimanager"
                        self.status_expiry_moves = 0
                        needs_redraw = True
                    elif key == "BACKSPACE":
                        if self.console_cursor_idx > 0:
                            self.console_input = self.console_input[:self.console_cursor_idx - 1] + self.console_input[self.console_cursor_idx:]
                            self.console_cursor_idx -= 1
                            needs_redraw = True
                    elif key == "DELETE":
                        if self.console_cursor_idx < len(self.console_input):
                            self.console_input = self.console_input[:self.console_cursor_idx] + self.console_input[self.console_cursor_idx + 1:]
                            needs_redraw = True
                    elif key == "LEFT":
                        self.console_cursor_idx = max(0, self.console_cursor_idx - 1)
                        needs_redraw = True
                    elif key == "RIGHT":
                        self.console_cursor_idx = min(len(self.console_input), self.console_cursor_idx + 1)
                        needs_redraw = True
                    elif key in ("HOME", "\x01"):
                        self.console_cursor_idx = 0
                        needs_redraw = True
                    elif key in ("END", "\x05"):
                        self.console_cursor_idx = len(self.console_input)
                        needs_redraw = True
                    elif key == "UP":
                        if self.console_cmd_history:
                            self.console_history_idx = max(0, self.console_history_idx - 1)
                            self.console_input = self.console_cmd_history[self.console_history_idx]
                            self.console_cursor_idx = len(self.console_input)
                            needs_redraw = True
                    elif key == "DOWN":
                        if self.console_cmd_history:
                            self.console_history_idx = min(len(self.console_cmd_history), self.console_history_idx + 1)
                            self.console_input = self.console_cmd_history[self.console_history_idx] if self.console_history_idx < len(self.console_cmd_history) else ""
                            self.console_cursor_idx = len(self.console_input)
                            needs_redraw = True
                    elif key == "QUIT":
                        self.console_input = ""
                        self.console_cursor_idx = 0
                        needs_redraw = True
                    elif len(key) == 1 and key.isprintable():
                        self.console_input = self.console_input[:self.console_cursor_idx] + key + self.console_input[self.console_cursor_idx:]
                        self.console_cursor_idx += 1
                        needs_redraw = True
                    continue

                # Normaler Dateimanager-Betrieb
                if key in ("TAB",):
                    if self.show_console: self.console_focused = True; needs_redraw = True
                    else: self.toggle_console(); needs_redraw = True
                    continue

                if key == "t":
                    self.toggle_console()
                    needs_redraw = True
                    continue

                if key in ("UP", "k"):
                    if self.items: self.selected_idx = max(0, self.selected_idx - 1); needs_redraw = True
                    continue
                elif key in ("DOWN", "j"):
                    if self.items: self.selected_idx = min(len(self.items) - 1, self.selected_idx + 1); needs_redraw = True
                    continue
                elif key in ("LEFT", "h"):
                    self.go_parent_directory()
                    needs_redraw = True
                    continue
                elif key in ("RIGHT", "l"):
                    if self.items:
                        item = self.items[self.selected_idx]
                        if item.is_dir:
                            self.change_directory(item.path)
                            needs_redraw = True
                        else:
                            now = datetime.datetime.now().timestamp()
                            if (now - self.last_right_arrow_time < 0.45) and (self.last_right_arrow_path == item.path):
                                self.last_right_arrow_time = 0.0
                                self.last_right_arrow_path = ""
                                self.open_in_nano(item, fd, old_settings)
                                needs_redraw = True
                            else:
                                self.last_right_arrow_time = now
                                self.last_right_arrow_path = item.path
                                self.status_message = f"Doppel-→ für nano ({item.name})"
                                self.status_expiry_moves = 0
                                needs_redraw = True
                    continue

                elif key == "ENTER":
                    if self.items:
                        self.open_with_system(self.items[self.selected_idx])
                        needs_redraw = True
                    continue

                elif key == "c":
                    r, _, _ = select.select([fd], [], [], 0.35)
                    if r:
                        next_k = read_key(fd, timeout=0.05)
                        if next_k in ("z", "Z"):
                            self.create_zip_archive()
                            needs_redraw = True
                            continue
                        elif next_k in ("c", "C"):
                            if self.items:
                                p = self.items[self.selected_idx].path
                                copy_text_to_clipboard(p)
                                self.status_message = f"Pfad kopiert: {p}"
                                self.status_expiry_moves = 0
                                needs_redraw = True
                                continue
                        elif next_k in ("f", "F"):
                            if self.items:
                                fn = self.items[self.selected_idx].name
                                copy_text_to_clipboard(fn)
                                self.status_message = f"Dateiname kopiert: {fn}"
                                self.status_expiry_moves = 0
                                needs_redraw = True
                                continue
                        elif next_k in ("d", "D"):
                            copy_text_to_clipboard(self.current_dir)
                            self.status_message = f"Ordnerpfad kopiert: {self.current_dir}"
                            self.status_expiry_moves = 0
                            needs_redraw = True
                            continue
                    self.copy_selection()
                    needs_redraw = True
                    continue

                elif key == "y":
                    self.copy_selection()
                    needs_redraw = True
                    continue
                elif key == "x":
                    self.cut_selection()
                    needs_redraw = True
                    continue
                elif key == "p":
                    self.paste_clipboard()
                    needs_redraw = True
                    continue
                elif key in ("Y", "X"):
                    self.clipboard_mode = None
                    self.clipboard_paths = []
                    self.status_message = "Zwischenspeicher geleert"
                    self.status_expiry_moves = 0
                    needs_redraw = True
                    continue
                elif key in ("SPACE", "v"):
                    self.toggle_select()
                    needs_redraw = True
                    continue
                elif key in ("V", "a"):
                    self.toggle_select_all()
                    needs_redraw = True
                    continue
                elif key in ("d", "D"):
                    self.prompt_trash(fd)
                    needs_redraw = True
                    continue
                elif key in (".", "z"):
                    new_h = not self.config.get("show_hidden", False)
                    self.config["show_hidden"] = new_h
                    self.refresh_items()
                    self.status_message = f"Versteckte Dateien: {'Ein' if new_h else 'Aus'}"
                    self.status_expiry_moves = 0
                    needs_redraw = True
                    continue
                elif key in ("m", "C"):
                    try:
                        from easydateien_konfigurator import run_konfigurator
                        new_cfg = run_konfigurator(standalone=False)
                        self.config.update(new_cfg)
                        self.show_console = self.config.get("show_console", False)
                        self.console_position = self.config.get("console_position", "unten")
                    except Exception as e:
                        self.status_message = f"Fehler Konfigurator: {e}"
                        self.status_expiry_moves = 0
                    tty.setcbreak(fd, termios.TCSADRAIN)
                    sys.stdout.write("\033[?1049h" + HIDE_CURSOR)
                    if self.config.get("mouse_support", True):
                        sys.stdout.write("\033[?1000h\033[?1006h")
                    sys.stdout.write("\033[2J\033[H")
                    sys.stdout.flush()
                    self.refresh_items()
                    self.status_message = "Einstellungen übernommen"
                    self.status_expiry_moves = 0
                    needs_redraw = True
                    continue
                elif key in ("HOME",):
                    self.selected_idx = 0
                    needs_redraw = True
                    continue
                elif key in ("END", "G"):
                    if self.items:
                        self.selected_idx = len(self.items) - 1
                        needs_redraw = True
                    continue
                elif key == "QUIT" or key == "q":
                    break

        finally:
            sys.stdout.write("\033[?1006l\033[?1000l")
            sys.stdout.write(SHOW_CURSOR)
            sys.stdout.write("\033[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def main():
    parser = argparse.ArgumentParser(description="EasyDateien — Minimalistischer Terminal-Dateimanager")
    parser.add_argument("pfad", nargs="?", default=None, help="Startverzeichnis")
    parser.add_argument("-c", "--config", action="store_true", help="Konfigurationsmenü öffnen")
    parser.add_argument("-v", "--version", action="version", version="EasyDateien 1.2.0")
    args = parser.parse_args()

    if args.config:
        from easydateien_konfigurator import run_konfigurator
        run_konfigurator(standalone=True)
        return

    app = EasyDateienApp(initial_path=args.pfad)
    app.run()

if __name__ == "__main__":
    main()
